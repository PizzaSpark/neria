// Data shared between the Rust side and the UI. Re-exported from app.slint, so Rust sees
// every struct and the Fmt global.

export struct MatchItem {
    title: string,
    detail: string,
    // 0..100; 0 with ruled-out = length too different
    score: int,
    ruled-out: bool,
    current: bool,
    url: string,
    // Sound check vs the reference preview:
    // 0 not checked, 1 checking, 2 same recording, 3 unsure, 4 different, 5 failed
    check-state: int,
    check-text: string,
}

// One tool on the first-run screen. state: 0 waiting, 1 downloading, 2 ready, 3 failed.
export struct ToolRow {
    name: string,
    purpose: string,
    state: int,
    progress: float,
    detail: string,
}

export struct SyncItem {
    title: string,
    file: string,
    checked: bool,
}

// One thing in a post or playlist, in the "what to download" list.
export struct PickItem {
    kind: string, // "Photo", "Video", "GIF"
    title: string, // own title, or "" for post items
    detail: string, // length, e.g. "0:05"
    thumb: image,
    checked: bool,
    // Videos can have their own quality and format: 0 = as the chips above, else an entry
    // of the picker's menu (Best, 1080p… Best · mkv… Audio · mp3…; see `pick_choice`).
    // Photos and GIFs are saved as they are.
    quality: int,
    can-quality: bool,
    // "01": the number the file gets, in the picker's order.
    number: string,
    // Several pasted links: why a row isn't ticked ("In the queue", "Paste it on its own").
    tag: string,
}

// A chapter on the clipper's timeline: click it to make it the selection.
export struct ChapterMark {
    start: float,
    end: float,
    title: string,
}

// A finished download offered on the empty Clip / Compress pages.
export struct RecentItem {
    path: string,
    title: string,
    detail: string, // "4:12  ·  yesterday"
    thumb: image,
    video: bool,
}

// A recording's row (see `fmt::live_row`): the tape is the stream from its start to now.
export struct LiveRow {
    // A recording (running, waiting, saving or saved).
    on: bool,
    // Show the tape (recording, catching up, reconnecting).
    tape: bool,
    // Hatched up to `joined` (before you joined), recorded up to `done`, both 0..1.
    joined: float,
    done: float,
    // The part before (fetched next to it): in up to here, 0..1; all in (`early-in`).
    early: float,
    early-in: bool,
    holes: [float],
    catching-up: bool,
    // The line under the tape.
    left: string,
    middle: string,
    middle-bad: bool,
    right: string,
    // "Clip the last…" can cut from what's recorded (not while catching up).
    can-clip: bool,
    // Running: Stop saves it.
    can-stop: bool,
    // The row's tag ("REC", "Waiting"…) and its kind (see `Tag`).
    tag: string,
    tag-kind: int,
    // The row's two lines, wide and for the compact row.
    status: string,
    stats: string,
    short-status: string,
    short-stats: string,
    // The compact row's short "missed 0:42".
    short-middle: string,
    // "Start clip" was pressed: "End clip" saves from there to now.
    clipping: bool,
}

export struct JobItem {
    // Negative for a group's card (the group id, negated).
    id: int,
    group: int,
    title: string,
    // 0 queued, 1 downloading, 2 processing, 3 done, 4 failed, 5 cancelled, 6 paused
    state: int,
    progress: float,
    status: string,
    stats: string,
    // Finished, but worth a look (e.g. uncertain Spotify match).
    warn: bool,
    // How strong the doubt is: 0 none, 1 unsure (weak title match, or close but maybe
    // another edit), 2 sounds different (the audio check says another recording).
    flag: int,
    // Spotify track: offers "pick another match".
    music: bool,
    // Saved as a photo or GIF: nothing to clip or compress (yet).
    still: bool,
    // Video thumbnail or song cover (empty until fetched, or when there is none).
    thumb: image,
    thumb-url: string,
    // The card of a playlist/post/album: sums up its rows, opens to show them.
    header: bool,
    expanded: bool,
    // A row inside a group card (indented; hidden while the card is closed).
    child: bool,
    // What the row's buttons can do right now (for a card: any of its rows).
    can-pause: bool,
    can-resume: bool,
    can-cancel: bool,
    can-retry: bool,
    can-remove: bool,
    // "Download later": waiting for its time (status says when); offers "Start now".
    scheduled: bool,
    // Waiting (or paused) next to other waiting rows: it can be moved up or down the queue.
    can-move: bool,
    // A live stream being recorded (or saved from one).
    live: LiveRow,
    // Saved, but the file isn't there any more (deleted or moved): "Gone".
    gone: bool,
}

// Formatting helpers implemented in Rust.
export global Fmt {
    pure callback time(float) -> string;
    // Latest keyframe at or before t: where a lossless cut really starts.
    pure callback keyframe-before(float, [float]) -> float;
    // A timeline ruler label for a mark at t, given the marks' step (tenths under a second).
    pure callback tick(float, float) -> string;
}

// Format names the Settings drawer lists and the pages show ("mp4 · H.264").
export global Formats {
    out property <[string]> containers: ["mp4", "mkv", "webm"];
    out property <[string]> audio: ["mp3", "m4a", "opus", "flac", "wav"];
}
