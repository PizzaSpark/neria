import { Theme, Screen, Nav } from "../theme.slint";
import { Commands, PalRow } from "../globals.slint";
import { Icon, Kbd, Thumb, Backdrop } from "../widgets.slint";

// One row: a heading, or an action / a saved thing to pick.
component PaletteRow inherits Rectangle {
    in property <PalRow> item;
    in property <bool> on;
    callback clicked();
    // It became the highlighted row: the list scrolls it into view.
    callback reveal(length, length);
    changed on => {
        if self.on {
            root.reveal(self.y, self.height);
        }
    }
    height: root.item.heading ? 30px : 42px;
    border-radius: 8px;
    background: root.on ? Theme.raised : transparent;
    border-width: root.on ? 1px : 0px;
    border-color: Theme.line-strong;
    if root.item.heading: Text {
        x: 10px;
        y: parent.height - self.height - 4px;
        text: root.item.pre;
        color: Theme.dim;
        font-family: Theme.display;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.8px;
    }
    if !root.item.heading: HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: stretch;
        // The thing's frame, or the action's glyph in a small outlined square.
        if root.item.has-thumb: VerticalLayout {
            alignment: center;
            Thumb {
                width: root.item.square ? 26px : 44px;
                height: 26px;
                border-radius: 5px;
                source: root.item.thumb;
                if root.item.square: Icon {
                    text: "\u{EC4F}";
                    font-size: 12px;
                    color: Theme.muted;
                }
            }
        }
        if !root.item.has-thumb: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                border-width: 2px;
                border-color: Theme.line-strong;
                Icon {
                    text: root.item.icon;
                    font-size: 14px;
                    color: Theme.muted;
                }
            }
        }
        // The name gives way first (elided), so the words on the right always show.
        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 0px;
            Text {
                text: root.item.pre;
                color: Theme.ink;
                font-size: 13.5px;
                vertical-alignment: center;
                overflow: elide;
                min-width: 0px;
                horizontal-stretch: 0;
            }
            Text {
                text: root.item.hit;
                color: Theme.pop-text;
                font-size: 13.5px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Text {
                text: root.item.post;
                color: Theme.ink;
                font-size: 13.5px;
                vertical-alignment: center;
                overflow: elide;
                min-width: 0px;
                horizontal-stretch: 0;
            }
            if root.item.sub != "": Text {
                text: "  " + root.item.sub;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
                min-width: 0px;
                horizontal-stretch: 1;
            }
            if root.item.sub == "": Rectangle { horizontal-stretch: 1; }
        }
        if root.item.where != "": Text {
            text: root.item.where;
            color: Theme.dim;
            font-size: 11.5px;
            vertical-alignment: center;
            horizontal-stretch: 0;
            min-width: self.preferred-width;
        }
        if root.on && !Screen.compact: Text {
            text: Commands.can-go-into ? "→" : "Enter";
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    // keyboard: ↑ ↓ and Enter in the box above do what a click does.
    if !root.item.heading: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The command palette: a box over the dimmed page (wide and medium), a sheet from the top
// (compact). Ctrl+K opens it; typing filters, ↑ ↓ move, Enter does it, → a thing's actions,
// Esc closes.
export component PaletteBox inherits Rectangle {
    property <length> box-width: Screen.compact ? root.width : min(560px, root.width - 32px); // ui-rules: shrinks to the window
    property <length> list-max: root.height - (Screen.compact ? 120px : 200px);
    // A click outside the box or Esc closes it; the wheel doesn't reach the page. The box
    // takes the keyboard itself (its search line), and Tab there goes into a thing.
    Backdrop {
        width: root.width;
        height: root.height;
        take-focus: false;
        label: "Command palette";
        close => { Nav.palette-open = false; }
        card := Rectangle {
            x: (root.width - root.box-width) / 2;
            y: Screen.compact ? 0px : 70px;
            width: root.box-width;
            height: col.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line-strong;
            border-top-left-radius: Screen.compact ? 0px : 14px;
            border-top-right-radius: Screen.compact ? 0px : 14px;
            border-bottom-left-radius: 14px;
            border-bottom-right-radius: 14px;
            clip: true;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: #00000099; // ui-rules: a shadow, not a surface colour
            // Clicks inside don't close it.
            TouchArea {
                scroll-event(event) => { return accept; }
            }
            col := VerticalLayout {
                // The box: what's typed, after the crumb of a second step.
                HorizontalLayout {
                    height: 52px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Icon {
                        text: "\u{E721}";
                        color: Theme.muted;
                        horizontal-stretch: 0;
                    }
                    if Commands.crumb != "": VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Rectangle {
                            height: 26px;
                            border-radius: 7px;
                            background: Theme.raised;
                            border-width: 1px;
                            border-color: Theme.line-strong;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                if Commands.crumb-has-thumb: VerticalLayout {
                                    alignment: center;
                                    Thumb {
                                        width: 22px;
                                        height: 13px;
                                        border-radius: 3px;
                                        source: Commands.crumb-thumb;
                                    }
                                }
                                if !Commands.crumb-has-thumb: Icon {
                                    text: Commands.crumb-icon;
                                    font-size: 12px;
                                }
                                Text {
                                    text: Commands.crumb;
                                    color: Theme.ink;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    max-width: Screen.compact ? 150px : 220px;
                                }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if Commands.query == "": Text {
                            width: parent.width;
                            text: Commands.placeholder;
                            color: Theme.dim;
                            font-size: 15px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        keys := FocusScope {
                            capture-key-pressed(event) => {
                                if event.text == Key.Escape {
                                    Nav.palette-open = false;
                                    return accept;
                                }
                                if event.text == Key.UpArrow {
                                    Commands.move(-1);
                                    return accept;
                                }
                                if event.text == Key.DownArrow {
                                    Commands.move(1);
                                    return accept;
                                }
                                if event.text == Key.Return {
                                    Commands.pick(Commands.selected);
                                    return accept;
                                }
                                if event.text == Key.Tab || (event.text == Key.RightArrow && input.cursor-position-byte-offset >= Commands.query.character-count) {
                                    if Commands.go-into() {
                                        return accept;
                                    }
                                    return event.text == Key.Tab ? accept : reject;
                                }
                                if (event.text == Key.Backspace || event.text == Key.LeftArrow) && Commands.query == "" && Commands.crumb != "" {
                                    Commands.back();
                                    return accept;
                                }
                                reject
                            }
                            input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> Commands.query;
                                color: Theme.ink;
                                font-size: 15px;
                                vertical-alignment: center;
                                single-line: true;
                                accessible-label: "What do you want to do?";
                                edited => { Commands.changed(); }
                            }
                        }
                    }
                    if !Screen.compact: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Kbd { text: "Esc"; }
                    }
                    // Compact has no keyboard Esc: an × closes it.
                    if Screen.compact: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            Icon {
                                text: "\u{E711}";
                                color: Theme.muted;
                            }
                            // keyboard: Esc closes it too.
                            TouchArea {
                                accessible-role: button;
                                accessible-label: "Close";
                                clicked => { Nav.palette-open = false; }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                list := Flickable {
                    height: min(rows.preferred-height, root.list-max);
                    content-height: rows.preferred-height;
                    rows := VerticalLayout {
                        padding: 6px;
                        padding-top: 2px;
                        spacing: 2px;
                        for row[i] in Commands.rows: PaletteRow {
                            item: row;
                            on: i == Commands.selected;
                            clicked => { Commands.pick(i); }
                            reveal(y, h) => {
                                if y + h > -list.content-y + list.height {
                                    list.content-y = -(y + h + 6px - list.height);
                                } else if y < -list.content-y {
                                    list.content-y = -max(0px, y - 6px);
                                }
                            }
                        }
                        if Commands.rows.length == 0: Text {
                            height: 44px;
                            x: 10px;
                            text: "Nothing like that. Try other words.";
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }
                if !Screen.compact: Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                if !Screen.compact: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 12px;
                    alignment: start;
                    for hint in Commands.crumb != "" ? [
                        { key: "↑↓", text: "move" },
                        { key: "Enter", text: "do it" },
                        { key: "←", text: "back" },
                    ] : [
                        { key: "↑↓", text: "move" },
                        { key: "Enter", text: "do it" },
                        { key: "→", text: "its actions" },
                        { key: "Esc", text: "close" },
                    ]: HorizontalLayout {
                        spacing: 4px;
                        Kbd { text: hint.key; }
                        Text {
                            text: hint.text;
                            color: Theme.dim;
                            font-size: 11.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
    init => { input.focus(); Commands.opened(); }
}
