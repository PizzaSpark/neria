import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme, Screen } from "../theme.slint";
import { Tools } from "../globals.slint";
import { PrimaryButton, GhostButton, SectionTitle, Hint, Dialog, ChoiceChips, ChoiceRow, TextLink, KeyPress } from "../widgets.slint";

// A field with its label above it.
component LabelledField inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
    }
    @children
}

// A blank you can add to the words: `{file}` in a dashed box.
component Blank inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 26px;
    width: t.preferred-width + 16px;
    border-radius: 7px;
    border-width: 2px;
    border-color: ta.has-hover ? Theme.muted : Theme.line-strong;
    background: ta.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: "Add " + root.text;
    accessible-action-default => { root.clicked(); }
    kp := KeyPress {
        radius: 7px;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { kp.take(); root.clicked(); }
    }
    t := Text {
        text: root.text;
        color: Theme.muted;
        font-family: Theme.mono;
        font-size: 11.5px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// Making or editing one of the user's own tools (mock `design/tools.html` 2A): the program,
// its words with blanks, what it makes and takes, and the real command it'll run.
export component ToolDialog inherits Dialog {
    // Changes not saved yet: closing asks first (Discard your changes?).
    dirty: Tools.dirty;
    init => { Tools.dirty = false; }
    title: Tools.edit-new ? "New tool" : Tools.name;
    card-width: 620px;
    card-height: 900px;
    close => { Tools.edit-open = false; }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 12px;
            padding-right: Theme.lane;

            LabelledField {
                label: "Name";
                LineEdit {
                    text <=> Tools.name;
                    placeholder-text: "Upscale 2×";
                    edited => { Tools.dirty = true; Tools.changed(); }
                    // Enter saves, as Save does.
                    accepted => { if Tools.can-save { Tools.save(); } }
                }
            }
            LabelledField {
                label: "Program";
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> Tools.program;
                        placeholder-text: "HandBrakeCLI.exe, or paste a whole command";
                        edited => { Tools.dirty = true; Tools.changed(); }
                        // Enter saves, as Save does.
                        accepted => { if Tools.can-save { Tools.save(); } }
                    }
                    GhostButton {
                        horizontal-stretch: 0;
                        text: "Change…";
                        label: "Pick the program";
                        clicked => { Tools.pick-program(); }
                    }
                }
            }
            LabelledField {
                label: "Its words";
                LineEdit {
                    text <=> Tools.words;
                    placeholder-text: "-i {file} -o {out}";
                    edited => { Tools.dirty = true; Tools.changed(); }
                    // Enter saves, as Save does.
                    accepted => { if Tools.can-save { Tools.save(); } }
                }
            }
            HorizontalLayout {
                padding-left: 0;
                FlexboxLayout {
                    spacing: 6px;
                    Blank {
                        text: "{file}";
                        clicked => { Tools.add-blank("{file}"); }
                    }
                    Blank {
                        text: "{out}";
                        clicked => { Tools.add-blank("{out}"); }
                    }
                    Blank {
                        text: "{dir}";
                        clicked => { Tools.add-blank("{dir}"); }
                    }
                    Blank {
                        text: "{name}";
                        clicked => { Tools.add-blank("{name}"); }
                    }
                    Blank {
                        text: "{ext}";
                        clicked => { Tools.add-blank("{ext}"); }
                    }
                }
            }
            HorizontalLayout {
                padding-left: 0;
                Hint {
                    text: "{file} is the file, {out} the new file next to it, {dir} its folder, {name} and {ext} its name and ending. Each is passed whole, spaces and all: no quotes needed.";
                }
            }

            VerticalLayout {
                padding-top: 8px;
                spacing: 6px;
                SectionTitle { text: "It makes"; }
                ChoiceRow {
                    title: "A new file";
                    hint: "ending in";
                    selected: Tools.makes-file;
                    clicked => {
                        Tools.makes-file = true;
                        Tools.dirty = true; Tools.changed();
                    }
                }
                if Tools.makes-file: HorizontalLayout {
                    padding-left: Screen.compact ? 0 : 36px; // under a ChoiceRow's label (6 + 18 + 12)
                    padding-top: 4px;
                    padding-bottom: 4px;
                    alignment: start;
                    spacing: 6px;
                    Text {
                        text: ".";
                        color: Theme.muted;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        width: 100px;
                        text <=> Tools.makes;
                        placeholder-text: "mp4";
                        edited => { Tools.dirty = true; Tools.changed(); }
                        // Enter saves, as Save does.
                        accepted => { if Tools.can-save { Tools.save(); } }
                    }
                }
                ChoiceRow {
                    title: "Nothing";
                    hint: "it uploads, tags or opens something";
                    selected: !Tools.makes-file;
                    clicked => {
                        Tools.makes-file = false;
                        Tools.dirty = true; Tools.changed();
                    }
                }
            }

            VerticalLayout {
                padding-top: 8px;
                spacing: 8px;
                SectionTitle { text: "It takes"; }
                ChoiceChips {
                    options: ["Videos", "Sound files", "Both"];
                    current <=> Tools.takes;
                    changed => { Tools.dirty = true; Tools.changed(); }
                }
            }

            VerticalLayout {
                padding-top: 8px;
                spacing: 8px;
                SectionTitle { text: "It'll run"; }
                Rectangle {
                    background: Theme.bg;
                    border-radius: 8px;
                    border-width: 2px;
                    border-color: Theme.line-strong;
                    height: cmd.preferred-height + 18px;
                    cmd := Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: Tools.command;
                        color: Theme.ink;
                        font-family: Theme.mono;
                        font-size: 11.5px;
                        wrap: char-wrap;
                    }
                }
                if Tools.used-by != "": Hint {
                    text: "Used by " + Tools.used-by + ": they'll run it as it is when you save.";
                }
            }
        }
    }

    // Why Save is greyed out: always in view.
    if Tools.problem != "": Text {
        text: Tools.problem;
        color: Theme.warn;
        font-size: 13px;
        wrap: word-wrap;
    }

    if Screen.compact: HorizontalLayout {
        spacing: 12px;
        alignment: start;
        GhostButton {
            text: "Try it on a file…";
            clicked => { Tools.try-it(); }
        }
        if !Tools.edit-new: VerticalLayout {
            alignment: center;
            TextLink {
                text: "Delete";
                clicked => { Tools.delete(); }
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        if !Screen.compact: GhostButton {
            text: "Try it on a file…";
            clicked => { Tools.try-it(); }
        }
        if !Screen.compact && !Tools.edit-new: VerticalLayout {
            alignment: center;
            TextLink {
                text: "Delete";
                clicked => { Tools.delete(); }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        GhostButton {
            text: "Cancel";
            clicked => { Tools.edit-open = false; }
        }
        PrimaryButton {
            text: "Save";
            enabled: Tools.can-save;
            clicked => { Tools.save(); }
        }
    }
}

// Run a tool… on files already saved (the Library): pick one, it runs in the queue.
export component RunToolDialog inherits Dialog {
    title: "Run a tool";
    subtitle: Tools.run-subtitle;
    card-width: 520px;
    fit: true;
    close => { Tools.run-open = false; }

    VerticalLayout {
        spacing: 0;
        for t in Tools.items: ChoiceRow {
            title: t.name;
            hint: t.summary;
            stacked: true;
            selected: false;
            clicked => { Tools.run(t.id); }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 12px;
        GhostButton {
            text: "New tool…";
            clicked => {
                Tools.run-open = false;
                Tools.new-one();
            }
        }
        GhostButton {
            text: "Cancel";
            clicked => { Tools.run-open = false; }
        }
    }
}
