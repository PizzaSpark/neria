import { Theme, Screen } from "../theme.slint";
import { Icon, Dialog, ChoiceTile, Sticker } from "../widgets.slint";

// A file dragged in from Explorer, or a link from a browser, over the page it would land
// on (not the nav). kind: 0 not media, 1 video or sound, 2 clip only (a .gif), 3 a link,
// 4 an app (.apk) onto the Phone tab, 5 any other file onto it (`target`: the phone's name).
export component DropOverlay inherits Rectangle {
    in property <int> kind;
    in property <string> name;
    in property <int> page;
    in property <string> target;
    property <bool> phone: root.kind == 4 || root.kind == 5;
    // Links: the clipper on Clip, the Download box anywhere else.
    property <bool> link: root.kind == 3;
    property <bool> ok: root.phone || (root.kind != 0 && !(root.page == 2 && root.kind == 2));
    background: Theme.bg.with-alpha(0.94);
    Rectangle {
        x: 18px;
        y: 18px;
        width: parent.width - 36px;
        height: parent.height - 36px;
        border-radius: 14px;
        border-width: 2px;
        border-color: root.ok ? Theme.pop : Theme.line-strong;
        background: root.ok ? Theme.pop.with-alpha(0.07) : transparent;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            padding: 24px;
            HorizontalLayout {
                alignment: center;
                padding-bottom: 8px;
                Sticker {
                    size: 56px;
                    radius: 14px;
                    shadow: root.kind != 0 ? Theme.hard : transparent;
                    edge: root.kind != 0 ? Theme.hard : Theme.line-strong;
                    face: root.kind != 0 ? Theme.pop : Theme.raised;
                    Icon {
                        text: root.kind == 4 ? "\u{E896}" : root.kind == 5 ? "\u{E8EA}" : root.kind == 0 ? "\u{E8A5}" : root.link ? (root.page == 1 ? "\u{E8C6}" : "\u{E896}") : root.page == 2 ? "\u{E73F}" : root.page == 1 || root.kind == 2 ? "\u{E8C6}" : "\u{E8E5}";
                        font-size: 22px;
                        color: root.kind != 0 ? Theme.on-pop : Theme.muted;
                    }
                }
            }
            Text {
                text: root.kind == 4 ? "Drop to install it on " + root.target
                    : root.kind == 5 ? "Drop to send it to " + root.target
                    : root.kind == 0 ? "Neria opens video and audio files"
                    : root.link ? (root.page == 1 ? "Drop to clip it" : "Drop to download it")
                    : root.page == 2 ? (root.kind == 1 ? "Drop to compress it" : "Compress works on videos and sound")
                    : root.page == 1 || root.kind == 2 ? "Drop to clip it"
                    : "Drop to clip, compress or transcribe it";
                color: Theme.ink;
                font-family: Theme.display;
                font-size: 30px;
                font-weight: 700;
                letter-spacing: -1px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: root.name;
                color: Theme.muted;
                font-family: Theme.body;
                font-size: 13px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

// A video or sound file dropped on the Download page: clip, compress or transcribe it?
// Several at once: compress or transcribe them. Side by side, or one under another on
// compact windows.
export component DropChoice inherits Dialog {
    in property <string> name;
    // Several video or sound files dropped at once.
    in property <bool> several;
    callback choose(int); // 1 clip, 2 compress, 3 transcribe

    title: "What should Neria do with " + (root.several ? "them?" : "it?");
    subtitle: root.name;
    card-width: 640px;
    fit: true;
    if !Screen.compact: HorizontalLayout {
        spacing: 12px;
        if !root.several: ChoiceTile {
            horizontal-stretch: 1;
            icon: "\u{E8C6}";
            title: "Clip it";
            text: "Cut out the part you want";
            clicked => { root.choose(1); }
        }
        ChoiceTile {
            horizontal-stretch: 1;
            icon: "\u{E73F}";
            title: root.several ? "Compress them" : "Compress it";
            text: "Make it small enough to send";
            clicked => { root.choose(2); }
        }
        ChoiceTile {
            horizontal-stretch: 1;
            icon: "\u{E70B}";
            title: root.several ? "Transcribe them" : "Transcribe it";
            text: "Write down what's said";
            clicked => { root.choose(3); }
        }
    }
    if Screen.compact: VerticalLayout {
        spacing: 12px;
        if !root.several: ChoiceTile {
            icon: "\u{E8C6}";
            title: "Clip it";
            text: "Cut out the part you want";
            clicked => { root.choose(1); }
        }
        ChoiceTile {
            icon: "\u{E73F}";
            title: root.several ? "Compress them" : "Compress it";
            text: "Make it small enough to send";
            clicked => { root.choose(2); }
        }
        ChoiceTile {
            icon: "\u{E70B}";
            title: root.several ? "Transcribe them" : "Transcribe it";
            text: "Write down what's said";
            clicked => { root.choose(3); }
        }
    }
}
