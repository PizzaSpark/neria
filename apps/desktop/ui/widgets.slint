// Shared controls. Rule: anything you press is playful (outline, sticker
// yellow, hard shadow on the main action); anything you read is calm.

import { Theme, Screen } from "theme.slint";

export component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 16px;
    color: Theme.ink;
    vertical-alignment: center;
    horizontal-alignment: center;
}

// The one main action on a screen: sticker yellow, black outline, hard shadow.
// Presses down onto its shadow.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    property <length> lift: !root.enabled ? 0px : ta.pressed ? 1px : 3px;
    min-width: face-row.preferred-width + 3px;
    height: 44px;
    // Shadow
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 3px;
        height: parent.height - 3px;
        border-radius: 10px;
        background: root.enabled ? Theme.pop-shadow : transparent;
    }
    // Face
    Rectangle {
        x: 3px - root.lift;
        y: 3px - root.lift;
        width: parent.width - 3px;
        height: parent.height - 3px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.enabled ? Theme.hard : Theme.line-strong;
        background: !root.enabled ? Theme.raised : ta.has-hover ? Theme.pop-hover : Theme.pop;
        animate x, y { duration: 70ms; }
        face-row := HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 8px;
            alignment: center;
            if root.icon != "": Icon {
                text: root.icon;
                font-size: 14px;
                color: root.enabled ? Theme.on-pop : Theme.dim;
            }
            Text {
                text: root.text;
                color: root.enabled ? Theme.on-pop : Theme.dim;
                font-family: Theme.display;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Everything else you can press: outlined, no fill.
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> compact;
    callback clicked();
    height: root.compact ? 30px : 40px;
    border-radius: root.compact ? 8px : 10px;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    border-width: 2px;
    border-color: ta.has-hover ? Theme.muted : Theme.line-strong;
    animate background, border-color { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.compact ? 10px : 14px;
        padding-right: root.compact ? 10px : 14px;
        spacing: 7px;
        alignment: center;
        if root.icon != "": Icon {
            text: root.icon;
            font-size: root.compact ? 12px : 13px;
            color: Theme.ink;
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.ink;
            font-family: Theme.body;
            font-size: root.compact ? 12px : 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.muted;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border-width: 2px;
    border-color: ta.has-hover ? Theme.line-strong : transparent;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        text: root.icon;
        font-size: 13px;
        color: ta.has-hover ? Theme.ink : root.tint;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    border-radius: 9px;
    background: root.selected ? Theme.ink : ta.has-hover ? Theme.raised : transparent;
    border-width: 2px;
    border-color: root.selected ? Theme.ink : ta.has-hover ? Theme.muted : Theme.line-strong;
    animate background, border-color { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Screen.compact ? 10px : 13px;
        padding-right: Screen.compact ? 10px : 13px;
        Text {
            text: root.text;
            color: root.selected ? Theme.bg : Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// Progress: a calm rounded meter in sticker yellow.
export component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.pop;
    height: 6px;
    border-radius: 3px;
    background: Theme.line;
    clip: true;
    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * max(0, min(1, root.value));
        border-radius: 3px;
        background: root.fill;
        animate width { duration: 180ms; }
    }
}

export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 56px;
    border-radius: 12px;
    border-width: 2px;
    border-color: root.active ? Theme.line-strong : transparent;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Icon {
            text: root.icon;
            font-size: 17px;
            color: root.active ? Theme.ink : Theme.dim;
        }
        Text {
            text: root.label;
            font-family: Theme.body;
            font-size: 11px;
            font-weight: 500;
            color: root.active ? Theme.ink : Theme.muted;
            horizontal-alignment: center;
        }
    }
}

// The sticker: a rounded face with a hard outline and a hard shadow down-right. Children
// go on the face. Used for the logo mark and the drop target.
export component Sticker inherits Rectangle {
    in property <length> size: 34px;
    in property <length> radius: 10px;
    in property <color> face: Theme.pop;
    in property <color> edge: Theme.hard;
    in property <color> shadow: Theme.hard;
    width: root.size + 3px;
    height: root.size + 3px;
    Rectangle {
        x: 3px;
        y: 3px;
        width: root.size;
        height: root.size;
        border-radius: root.radius;
        background: root.shadow;
    }
    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.radius;
        background: root.face;
        border-width: 2px;
        border-color: root.edge;
        @children
    }
}

// Neria's logo mark: an "N" whose left stem is a download arrow, on the sticker.
export component LogoMark inherits Sticker {
    // Sized from `size`: it sits on the face, which isn't its `parent` here.
    Image {
        width: root.size;
        height: root.size;
        source: @image-url("../assets/neria-mark.png");
    }
}

// Big friendly page headline ("Grab anything.") with an optional line under it. Compact
// windows have no rail, so the logo mark moves next to the headline there.
export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: Screen.compact ? 4px : 6px;
    HorizontalLayout {
        spacing: 10px;
        if Screen.compact: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            LogoMark {
                size: 28px;
                radius: 8px;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: Theme.ink;
            font-family: Theme.display;
            font-size: Screen.compact ? 23px : 30px;
            font-weight: 700;
            letter-spacing: Screen.compact ? -0.6px : -1px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 13px;
        overflow: elide;
    }
}

export component SectionTitle inherits Text {
    color: Theme.ink;
    font-family: Theme.display;
    font-size: 15px;
    font-weight: 700;
}

export component Hint inherits Text {
    color: Theme.muted;
    font-family: Theme.body;
    font-size: 12px;
    wrap: word-wrap;
}

// Status sticker: 0 neutral, 1 ok, 2 warn, 3 bad, 4 pop (counts).
export component Tag inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    border-radius: 6px;
    background: root.kind == 1 ? Theme.ok-bg : root.kind == 2 ? Theme.warn-bg : root.kind == 3 ? Theme.bad-bg : root.kind == 4 ? Theme.pop : Theme.raised;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            color: root.kind == 1 ? Theme.ok : root.kind == 2 ? Theme.warn : root.kind == 3 ? Theme.bad : root.kind == 4 ? Theme.on-pop : Theme.muted;
            font-family: root.kind == 4 ? Theme.mono : Theme.display;
            font-size: 11px;
            font-weight: root.kind == 4 ? 500 : 700;
            vertical-alignment: center;
        }
    }
}

// The big link box. Buttons placed inside it go on the right.
export component LinkField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted();
    height: 54px;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 2px;
    border-color: input.has-focus ? Theme.ink : ta.has-hover ? Theme.muted : Theme.line-strong;
    animate border-color { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 6px;
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.dim;
                font-family: Theme.body;
                font-size: 15px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                x: 0;
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                color: Theme.ink;
                font-family: Theme.body;
                font-size: 15px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.pop.with-alpha(0.45);
                selection-foreground-color: Theme.ink;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
        }
        @children
    }
}

// Quiet secondary action (queue header): muted text, ink on hover.
export component TextLink inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked();
    min-width: row.preferred-width;
    height: 30px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            text: root.icon;
            font-size: 12px;
            color: ta.has-hover ? Theme.ink : Theme.muted;
        }
        Text {
            text: root.text;
            color: ta.has-hover ? Theme.ink : Theme.muted;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// Keyboard shortcut hint: "Ctrl V".
export component Kbd inherits Rectangle {
    in property <string> text;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.line-strong;
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.line-strong;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 3px;
        Text {
            text: root.text;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// A tickbox you press: 2px outline, ink fill with a check when on. The label is part of
// the target.
export component Tick inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    // One line, cut with "…" when too long (song names in a list).
    in property <bool> elide;
    callback toggled(bool);
    min-height: 28px;
    min-width: root.elide ? 60px : row.preferred-width;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    row := HorizontalLayout {
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                border-width: 2px;
                border-color: root.checked ? Theme.ink : ta.has-hover ? Theme.muted : Theme.line-strong;
                background: root.checked ? Theme.ink : transparent;
                animate background, border-color { duration: 90ms; }
                if root.checked: Icon {
                    text: "\u{E73E}";
                    font-size: 11px;
                    color: Theme.bg;
                }
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
            wrap: root.elide ? no-wrap : word-wrap;
            overflow: root.elide ? TextOverflow.elide : TextOverflow.clip;
            horizontal-stretch: 1;
        }
    }
}

// The floating card for dialogs: scrim, `panel`, 1px `line-strong`, 12px radius, a title
// with an optional line under it, and a close button. Put it over the whole window.
// `fit` sizes the card to its content instead of `card-height`.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> card-width: 560px;
    in property <length> card-height: 520px;
    in property <bool> fit;
    // Clicking outside or the × closes it. Off for dialogs that need an answer.
    in property <bool> closable: true;
    callback close();
    background: Theme.scrim;
    TouchArea {
        clicked => {
            if root.closable {
                root.close();
            }
        }
    }
    // Compact windows: the card goes nearly edge to edge.
    property <length> margin: Screen.compact ? 24px : 48px;
    Rectangle {
        width: min(root.card-width, root.width - root.margin);
        height: root.fit ? min(body.preferred-height, root.height - root.margin) : min(root.card-height, root.height - root.margin);
        border-radius: 12px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line-strong;
        clip: true;
        TouchArea { }
        body := VerticalLayout {
            padding: Screen.compact ? 18px : 24px;
            padding-top: Screen.compact ? 18px : 22px;
            spacing: Screen.compact ? 14px : 16px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text {
                        text: root.title;
                        color: Theme.ink;
                        font-family: Theme.display;
                        font-size: 20px;
                        font-weight: 700;
                        letter-spacing: -0.4px;
                        wrap: word-wrap;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        color: Theme.muted;
                        font-family: Theme.body;
                        font-size: 13px;
                        overflow: elide;
                    }
                }
                if root.closable: VerticalLayout {
                    alignment: start;
                    IconButton {
                        icon: "\u{E711}";
                        clicked => { root.close(); }
                    }
                }
            }
            @children
        }
    }
}

// A big pressable option in a dialog ("Clip it" / "Compress it"): outlined like any
// control, icon, short title and one muted line.
export component ChoiceTile inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    callback clicked();
    min-height: col.preferred-height;
    border-radius: 12px;
    border-width: 2px;
    border-color: ta.has-hover ? Theme.ink : Theme.line-strong;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    animate background, border-color { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    col := VerticalLayout {
        padding: 16px;
        spacing: 6px;
        Icon {
            text: root.icon;
            font-size: 20px;
            horizontal-alignment: left;
        }
        Text {
            text: root.title;
            color: Theme.ink;
            font-family: Theme.display;
            font-size: 16px;
            font-weight: 700;
        }
        Text {
            text: root.text;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// A row of chips where one is picked (quality, clip mode, compress goal…). Wraps onto
// more lines when the window is too narrow for one. It takes the row's free width (chips
// stay left) so it only wraps when it has to, and never grows taller than its lines.
export component ChoiceChips inherits FlexboxLayout {
    in property <[string]> options;
    in-out property <int> current;
    callback changed();
    horizontal-stretch: 1;
    vertical-stretch: 0;
    spacing: Screen.compact ? 7px : 8px;
    for option[i] in root.options: Chip {
        horizontal-stretch: 0;
        text: option;
        selected: root.current == i;
        clicked => {
            root.current = i;
            root.changed();
        }
    }
}

// The ⋯ button's pop-up (queue rows on compact windows): a floating card of calm rows.
// Put the `MenuItem`s inside; the `PopupWindow` around it closes on any click.
export component Menu inherits Rectangle {
    width: 200px;
    height: col.preferred-height;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line-strong;
    col := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        @children
    }
}

export component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        Icon {
            width: 16px;
            text: root.icon;
            font-size: 13px;
            color: ta.has-hover ? Theme.ink : Theme.muted;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// 1px hairline between sections. `inset-right` stops it short of a list's scrollbar lane.
export component Divider inherits Rectangle {
    in property <length> inset-right;
    height: 1px;
    Rectangle {
        x: 0;
        width: parent.width - root.inset-right;
        background: Theme.line;
    }
}

// A calm list row with a hairline at the bottom. The hairline stops short of the
// ListView's scrollbar lane (`lane`; 0 outside a ListView).
export component ListRow inherits Rectangle {
    in property <length> lane: Theme.lane;
    @children
    Rectangle {
        x: 0;
        y: root.height - 1px;
        width: root.width - root.lane;
        height: 1px;
        background: Theme.line;
    }
}

// Rounded picture box: thumbnails, covers, file previews. Children sit on top (status icons).
export component Thumb inherits Rectangle {
    in property <image> source;
    border-radius: 6px;
    background: Theme.raised;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
    @children
}

// One line of status next to an icon: "That's not a link yet", "Already downloaded",
// warnings. Children (a link, a button) follow the text.
export component Notice inherits HorizontalLayout {
    in property <string> icon: "\u{E7BA}";
    in property <string> text;
    in property <color> color: Theme.warn;
    in property <color> icon-color: root.color;
    in property <length> icon-size: 13px;
    in property <length> font-size: 12px;
    in property <bool> wrap;
    // false: the text takes only its own width (children then end with a spacer).
    in property <bool> fill: true;
    // Cut long text with "…" instead of wrapping.
    in property <bool> elide;
    spacing: 8px;
    Icon {
        horizontal-stretch: 0;
        text: root.icon;
        font-size: root.icon-size;
        color: root.icon-color;
    }
    Text {
        horizontal-stretch: root.fill ? 1 : 0;
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        wrap: root.wrap ? word-wrap : no-wrap;
        overflow: root.elide ? TextOverflow.elide : TextOverflow.clip;
        vertical-alignment: center;
    }
    @children
}

// An empty page: big icon, one display line, the actions (children), a muted tip.
export component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> tip;
    vertical-stretch: 1;
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        Icon {
            text: root.icon;
            font-size: 36px;
            color: Theme.accent-hi;
        }
        Text {
            text: root.title;
            color: Theme.ink;
            font-family: Theme.display;
            font-size: Screen.compact ? 17px : 19px;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            @children
        }
        Text {
            text: root.tip;
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// Short message at the bottom of the window ("Report copied…"). Sizes itself to the
// text, up to `widest`; the window centres it.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <length> widest;
    width: min(row.preferred-width, root.widest);
    height: 46px;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line-strong;
    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 20px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                background: Theme.ok-bg;
                Icon {
                    text: "\u{E73E}";
                    font-size: 11px;
                    color: Theme.ok;
                }
            }
        }
        Text {
            text: root.text;
            color: Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
