// Shared controls. Rule: anything you press is playful (outline, sticker
// yellow, hard shadow on the main action); anything you read is calm.

import { ScrollView } from "std-widgets.slint";
import { Theme, Screen, Nav, Space } from "theme.slint";

export component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 16px;
    color: Theme.ink;
    vertical-alignment: center;
    horizontal-alignment: center;
}

// Keyboard for a pressable control: Tab reaches it, Enter or Space presses it, and a 2px
// ring shows around it while it has focus from the keyboard. Put it inside the control; it
// fills it. `radius` is the control's corner radius.
// A click focuses it too (`take()` from the control's TouchArea), as a browser button and the
// UI SDK do, so Tab and the arrows go on from what was clicked; but then, like
// `:focus-visible`, no ring shows, and Space / Enter go on to the page (Space still plays on
// the Clip page) until the keyboard moves focus.
// Enter presses it once (held down it doesn't repeat); Space presses it when let go, as a
// button does.
// In a group where one is picked (tabs, chips, a section list), set `roving`: Tab stops only
// on the picked one (`active`), and the arrow keys move to the next one and pick it, as Radix
// Tabs / RadioGroup and the UI SDK do. With `index` and `count` set, the arrows go round at
// the ends and Home / End reach the first / last; without them (a group with hidden options),
// `first` / `last` stop the arrows at the ends.
// In a list you move through without picking (a menu), set `arrows`: ↑ ↓ move.
// `ring: false` for controls that show focus their own way (a menu row's highlight).
export component KeyPress inherits FocusScope {
    in property <length> radius: 10px;
    in property <bool> roving;
    in property <bool> active;
    in property <bool> arrows;
    in property <int> index: -1;
    in property <int> count;
    in property <bool> first: root.count > 0 && root.index == 0;
    in property <bool> last: root.count > 0 && root.index == root.count - 1;
    in property <bool> ring: true;
    callback activated();
    focus-on-click: false;
    focus-on-tab-navigation: !root.roving || root.active || Nav.arrowing;
    property <bool> space-down;
    property <bool> counted: root.count > 0 && root.index >= 0;
    // Focus came from the keyboard (Tab, an arrow, a dialog opened by key), not a click.
    property <bool> by-keys;
    property <bool> clicking;
    // The control was clicked: take the keyboard, quietly.
    public function take() {
        root.clicking = true;
        root.focus();
        root.clicking = false;
    }
    focus-gained(reason) => {
        root.by-keys = !root.clicking && (reason == FocusReason.tab-navigation || Nav.keyboard);
        // Picked when an arrow's last step lands here (not on the options it passes).
        if root.roving && Nav.arrowing && Nav.steps-left == 0 && !root.active {
            root.activated();
        }
    }
    focus-lost(reason) => { root.space-down = false; }
    // Move `n` options along a group (negative: back), picking the one it lands on.
    function move(n: int) {
        if n != 0 {
            Nav.arrowing = root.roving;
            Nav.focus-steps(n);
        }
    }
    key-pressed(event) => {
        // Focused by a click: Space and Enter are the page's (play / pause), not this one's.
        if !root.by-keys && (event.text == Key.Return || event.text == " ") {
            return reject;
        }
        if event.text == Key.Return {
            if !event.repeat {
                root.activated();
            }
            return accept;
        }
        if event.text == " " {
            root.space-down = true;
            return accept;
        }
        if root.roving || root.arrows {
            if event.text == Key.RightArrow || event.text == Key.DownArrow {
                if !root.last {
                    root.move(1);
                } else if root.counted {
                    root.move(1 - root.count);
                }
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.UpArrow {
                if !root.first {
                    root.move(-1);
                } else if root.counted {
                    root.move(root.count - 1);
                }
                return accept;
            }
            if root.counted && event.text == Key.Home {
                root.move(-root.index);
                return accept;
            }
            if root.counted && event.text == Key.End {
                root.move(root.count - 1 - root.index);
                return accept;
            }
        }
        reject
    }
    key-released(event) => {
        if event.text == " " && root.space-down {
            root.space-down = false;
            root.activated();
            return accept;
        }
        reject
    }
    if root.has-focus && root.ring && root.by-keys: Rectangle {
        x: -4px;
        y: -4px;
        width: root.width + 8px;
        height: root.height + 8px;
        border-radius: root.radius + 4px;
        border-width: 2px;
        border-color: Theme.focus;
    }
}

// The one main action on a screen: sticker yellow, black outline, hard shadow.
// Presses down onto its shadow.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    // A split button: a ▾ part on the right opens more ways to do it (`menu-clicked`).
    in property <bool> has-menu;
    // What a screen reader says for the ▾ ("More ways to record").
    in property <string> menu-label: "More ways to download";
    callback clicked();
    callback menu-clicked();
    property <length> menu-w: root.has-menu ? 34px : 0px;
    property <bool> menu-pressed;
    // Greyed out it stays up (no shadow under it), so it lines up with a GhostButton beside it.
    property <length> lift: root.enabled && (ta.pressed || root.menu-pressed) ? 1px : 3px;
    min-width: face-row.preferred-width + 3px + root.menu-w;
    height: 44px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    kp := KeyPress {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
    // Shadow
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 3px;
        height: parent.height - 3px;
        border-radius: 10px;
        background: root.enabled ? Theme.pop-shadow : transparent;
    }
    // Face
    Rectangle {
        x: 3px - root.lift;
        y: 3px - root.lift;
        width: parent.width - 3px;
        height: parent.height - 3px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.enabled ? Theme.hard : Theme.line-strong;
        background: !root.enabled ? Theme.raised : ta.has-hover ? Theme.pop-hover : Theme.pop;
        animate x, y { duration: 70ms; }
        face-row := HorizontalLayout {
            width: parent.width - root.menu-w;
            x: 0;
            padding-left: 16px;
            padding-right: root.has-menu ? 12px : 16px;
            spacing: 8px;
            alignment: center;
            if root.icon != "": Icon {
                text: root.icon;
                font-size: 14px;
                color: root.enabled ? Theme.on-pop : Theme.dim;
            }
            Text {
                text: root.text;
                color: root.enabled ? Theme.on-pop : Theme.dim;
                font-family: Theme.display;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        if root.has-menu: Rectangle {
            x: parent.width - root.menu-w - 1px;
            width: 2px;
            y: 8px;
            height: parent.height - 16px;
            background: root.enabled ? Theme.hard : Theme.line-strong;
            opacity: 0.45;
        }
        if root.has-menu: Icon {
            x: parent.width - root.menu-w;
            width: root.menu-w;
            text: "\u{E70D}";
            font-size: 11px;
            color: root.enabled ? Theme.on-pop : Theme.dim;
        }
    }
    ta := TouchArea {
        width: parent.width - root.menu-w;
        x: 0;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { kp.take(); root.clicked(); }
    }
    // The ▾ part: its own key stop, so Tab reaches "more ways" too. Greyed out with the
    // button: what it offers is the same action done another way.
    if root.has-menu: Rectangle {
        x: parent.width - root.menu-w - 3px;
        width: root.menu-w + 3px;
        accessible-role: button;
        accessible-label: root.menu-label;
        accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { root.menu-clicked(); } }
        KeyPress {
            radius: 10px;
            enabled: root.enabled;
            activated => { root.menu-clicked(); }
        }
        TouchArea {
            enabled: root.enabled;
            changed pressed => { root.menu-pressed = self.pressed; }
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.menu-clicked(); }
        }
    }
}

// Everything else you can press: outlined, no fill.
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> compact;
    // What a screen reader says; needed when the button is an icon only.
    in property <string> label: root.text;
    // Something is set here (Sound, Picture changed): a yellow outline says so, also when
    // the button is only an icon.
    in property <bool> on;
    // A small icon after the text (a fold's chevron).
    in property <string> trail;
    // Greyed out: shown, but neither a click nor a key presses it.
    in property <bool> enabled: true;
    // Give it the keyboard (with the ring when the keyboard is in use).
    public function take-focus() { kp.focus(); }
    callback clicked();
    // Regular size matches PrimaryButton exactly: the same 44px slot with a 41px face at
    // the top (the yellow button's 3px shadow sits below its face), so a pair lines up.
    height: root.compact ? 30px : 44px;
    // Sized by its content (which sits inside the face).
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    face := Rectangle {
        y: 0;
        width: parent.width;
        height: root.compact ? parent.height : parent.height - 3px;
        border-radius: root.compact ? 8px : 10px;
        background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
        border-width: 2px;
        border-color: root.on ? Theme.accent-hi : ta.has-hover ? Theme.muted : Theme.line-strong;
        animate background, border-color { duration: 100ms; }
        kp := KeyPress {
            radius: parent.border-radius;
            enabled: root.enabled;
            activated => { root.clicked(); }
        }
        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { kp.take(); root.clicked(); }
        }
        row := HorizontalLayout {
            padding-left: root.compact ? 8px : 12px;
            padding-right: root.compact ? 8px : 12px;
            spacing: 8px;
            alignment: center;
            if root.icon != "": Icon {
                text: root.icon;
                font-size: root.compact ? 12px : 13px;
                color: Theme.ink;
            }
            if root.text != "": Text {
                text: root.text;
                color: Theme.ink;
                font-family: Theme.body;
                font-size: root.compact ? 12px : 13px;
                font-weight: 500;
                vertical-alignment: center;
            }
            if root.trail != "": Icon {
                text: root.trail;
                font-size: 10px;
                color: Theme.muted;
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.muted;
    // What a screen reader says ("Close", "Remove"…).
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    kp := KeyPress {
        radius: 8px;
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
    border-width: 2px;
    border-color: ta.has-hover ? Theme.line-strong : transparent;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { kp.take(); root.clicked(); }
    }
    Icon {
        text: root.icon;
        font-size: 13px;
        color: ta.has-hover ? Theme.ink : root.tint;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    // In a ChoiceChips row: one Tab stop (`tab-stop`), arrows move and pick.
    in property <bool> roving;
    in property <bool> tab-stop;
    // Its place in the row (ChoiceChips): the arrows go round, Home / End.
    in property <int> index: -1;
    in property <int> count;
    callback clicked();
    height: 34px;
    border-radius: 9px;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    kp := KeyPress {
        radius: 9px;
        enabled: root.enabled;
        roving: root.roving;
        active: root.tab-stop;
        index: root.index;
        count: root.count;
        activated => { root.clicked(); }
    }
    background: root.selected ? Theme.ink : ta.has-hover ? Theme.raised : transparent;
    border-width: 2px;
    border-color: root.selected ? Theme.ink : ta.has-hover ? Theme.muted : Theme.line-strong;
    animate background, border-color { duration: 100ms; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { kp.take(); root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Screen.compact ? 8px : 12px;
        padding-right: Screen.compact ? 8px : 12px;
        Text {
            text: root.text;
            color: root.selected ? Theme.bg : Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// Progress: a calm rounded meter in sticker yellow.
export component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.pop;
    accessible-role: progress-indicator;
    accessible-value: Math.round(root.value * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    height: 6px;
    border-radius: 3px;
    background: Theme.line;
    clip: true;
    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * max(0, min(1, root.value));
        border-radius: 3px;
        background: root.fill;
        animate width { duration: 180ms; }
    }
}

export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    // A small red dot: something of this page's is running (instant replay on).
    in property <bool> dot;
    // The rail's ends: the arrow keys stop there.
    // Its place in the row: the arrows go round, Home / End. Without them (hidden options),
    // `first` / `last` stop the arrows at the ends.
    in property <int> index: -1;
    in property <int> count;
    in property <bool> first: root.count > 0 && root.index == 0;
    in property <bool> last: root.count > 0 && root.index == root.count - 1;
    // The rail's one Tab stop: the open page (the tab bar keeps it while Settings covers it).
    in property <bool> tab-stop: root.active;
    callback clicked();
    height: 56px;
    border-radius: 12px;
    accessible-role: tab;
    accessible-label: root.label + (root.dot ? ", on" : "");
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }
    // One Tab stop for the rail (the open page); ↑ ↓ move to the next page.
    kp := KeyPress {
        radius: 12px;
        roving: true;
        active: root.tab-stop;
        index: root.index;
        count: root.count;
        first: root.first;
        last: root.last;
        activated => { root.clicked(); }
    }
    border-width: 2px;
    border-color: root.active ? Theme.line-strong : transparent;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { kp.take(); root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Icon {
            text: root.icon;
            font-size: 17px;
            color: root.active ? Theme.ink : Theme.dim;
        }
        Text {
            text: root.label;
            font-family: Theme.body;
            font-size: 11px;
            font-weight: 500;
            color: root.active ? Theme.ink : Theme.muted;
            horizontal-alignment: center;
        }
    }
    if root.dot: Rectangle {
        x: root.width / 2 + 6px;
        y: 9px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.live;
    }
}

// The sticker: a rounded face with a hard outline and a hard shadow down-right. Children
// go on the face. Used for the logo mark and the drop target.
export component Sticker inherits Rectangle {
    in property <length> size: 34px;
    in property <length> radius: 10px;
    in property <color> face: Theme.pop;
    in property <color> edge: Theme.hard;
    in property <color> shadow: Theme.hard;
    width: root.size + 3px;
    height: root.size + 3px;
    Rectangle {
        x: 3px;
        y: 3px;
        width: root.size;
        height: root.size;
        border-radius: root.radius;
        background: root.shadow;
    }
    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.radius;
        background: root.face;
        border-width: 2px;
        border-color: root.edge;
        @children
    }
}

// Neria's logo mark: an "N" whose left stem is a download arrow, on the sticker.
export component LogoMark inherits Sticker {
    // Sized from `size`: it sits on the face, which isn't its `parent` here.
    Image {
        width: root.size;
        height: root.size;
        source: @image-url("../assets/neria-mark.png");
    }
}

// Big friendly page headline ("Grab anything.") with an optional line under it. Compact
// windows have no rail, so the logo mark moves next to the headline there.
export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: Screen.compact ? 4px : 6px;
    HorizontalLayout {
        spacing: 8px;
        if Screen.compact: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            LogoMark {
                size: 28px;
                radius: 8px;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: Theme.ink;
            font-family: Theme.display;
            font-size: Screen.compact ? 23px : 30px;
            font-weight: 700;
            letter-spacing: Screen.compact ? -0.6px : -1px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 13px;
        overflow: elide;
    }
}

export component SectionTitle inherits Text {
    color: Theme.ink;
    font-family: Theme.display;
    font-size: 15px;
    font-weight: 700;
}

export component Hint inherits Text {
    color: Theme.muted;
    font-family: Theme.body;
    font-size: 12px;
    wrap: word-wrap;
}

// Status sticker: 0 neutral, 1 ok, 2 warn, 3 bad, 4 pop (counts).
// kind: 0 plain, 1 ok, 2 warn, 3 bad, 4 pop (a count), 5 live (recording: a pulsing dot).
export component Tag inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    border-radius: 6px;
    background: root.kind == 1 ? Theme.ok-bg : root.kind == 2 ? Theme.warn-bg : root.kind == 3 ? Theme.bad-bg : root.kind == 4 ? Theme.pop : root.kind == 5 ? Theme.live-bg : Theme.raised;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 4px;
        if root.kind == 5: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Theme.live;
                opacity: 0.6 + 0.4 * Math.sin(animation-tick() / 260ms * 1rad);
            }
        }
        Text {
            text: root.text;
            color: root.kind == 1 ? Theme.ok : root.kind == 2 ? Theme.warn : root.kind == 3 ? Theme.bad : root.kind == 4 ? Theme.on-pop : root.kind == 5 ? Theme.live : Theme.muted;
            font-family: root.kind == 4 ? Theme.mono : Theme.display;
            font-size: 11px;
            font-weight: root.kind == 4 ? 500 : 700;
            vertical-alignment: center;
        }
    }
}

// A live stream from its start to now: hatched before you joined, yellow where it's
// recorded (striped while catching up), a red tick where something was missed, and a
// pulsing red edge at "now". Fractions 0..1 of its width.
export component LiveTape inherits Rectangle {
    in property <float> joined;
    in property <float> done;
    in property <[float]> holes;
    in property <bool> catching-up;
    // The part before, fetched next to it: in up to `early` (fainter while it comes).
    in property <float> early;
    in property <bool> early-in;
    // The compact row's thinner tape.
    in property <bool> slim;
    accessible-role: progress-indicator;
    accessible-label: root.catching-up ? "Catching up with the live stream" : "Recording";
    accessible-value: Math.round(root.done * 100) + "%";
    height: root.slim ? 6px : 10px;
    border-radius: 3px;
    background: Theme.line;
    // Before you joined: thin stripes.
    Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.joined));
        height: parent.height;
        clip: true;
        border-radius: 3px;
        for i in Math.ceil(self.width / 6px): Rectangle {
            x: i * 6px;
            width: 2px;
            height: parent.height;
            background: Theme.line-strong;
        }
    }
    // The part before, as it comes in (over the stripes).
    if root.early > 0: Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.early));
        height: parent.height;
        border-radius: 3px;
        background: root.early-in ? Theme.pop : Theme.pop.with-alpha(0.45);
    }
    // Recorded.
    Rectangle {
        x: parent.width * max(0, min(1, root.joined));
        width: parent.width * max(0, min(1, root.done) - max(0, min(1, root.joined)));
        height: parent.height;
        background: Theme.pop;
        clip: true;
        if root.catching-up: Rectangle {
            width: parent.width;
            height: parent.height;
            for i in Math.ceil(parent.width / 8px): Rectangle {
                x: i * 8px + 6px;
                width: 2px;
                height: parent.height;
                background: Theme.on-pop.with-alpha(0.22);
            }
        }
    }
    for h in root.holes: Rectangle {
        x: parent.width * max(0, min(1, h)) - 2px;
        y: -3px;
        width: 4px;
        height: parent.height + 6px;
        border-radius: 2px;
        background: Theme.bad;
    }
    // "Now": the live edge, pulsing.
    Rectangle {
        x: parent.width - 3px;
        y: -4px;
        width: 3px;
        height: parent.height + 8px;
        border-radius: 2px;
        background: Theme.live;
        opacity: 0.55 + 0.45 * Math.sin(animation-tick() / 260ms * 1rad);
    }
}

// The big link box. Buttons placed inside it go on the right.
// The one text box drawn our way (the link box, the Library's search): 2px outline, ink
// when it has the keyboard; the text input itself is the Tab stop. `small` is the search
// size; `icon` sits before the text; `escape-clears` empties it on Esc (`cleared`).
// Buttons (Paste, Clear) go inside, after the text.
export component TextBox inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> icon;
    // What a screen reader calls it, when the placeholder doesn't say.
    in property <string> label: root.placeholder;
    in property <bool> small;
    in property <bool> escape-clears;
    // Ctrl+Shift+V in the box: `paste-download` instead of a plain paste (the link box).
    in property <bool> paste-and-go;
    public function focus-input() { input.focus(); }
    callback edited(string);
    callback accepted();
    callback cleared();
    callback paste-download();
    property <length> font: root.small ? 13.5px : 15px;
    height: root.small ? 41px : 54px;
    border-radius: root.small ? 10px : 12px;
    background: Theme.panel;
    border-width: 2px;
    border-color: input.has-focus ? Theme.ink : ta.has-hover ? Theme.muted : Theme.line-strong;
    animate border-color { duration: 100ms; }
    // keyboard: Tab reaches the text input itself.
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    HorizontalLayout {
        padding-left: root.small ? 12px : 16px;
        padding-right: root.small ? 8px : 6px;
        spacing: root.small ? 8px : 8px;
        if root.icon != "": Icon {
            horizontal-stretch: 0;
            text: root.icon;
            font-size: 13px;
            color: Theme.muted;
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.muted;
                font-family: Theme.body;
                font-size: root.font;
                vertical-alignment: center;
                overflow: elide;
            }
            FocusScope {
                x: 0;
                width: parent.width;
                height: parent.height;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                capture-key-pressed(event) => {
                    if root.paste-and-go && event.modifiers.control && event.modifiers.shift && (event.text == "v" || event.text == "V") {
                        root.paste-download();
                        return accept;
                    }
                    reject
                }
                key-pressed(event) => {
                    if root.escape-clears && event.text == Key.Escape && root.text != "" {
                        root.text = "";
                        root.cleared();
                        return accept;
                    }
                    reject
                }
                input := TextInput {
                    x: 0;
                    width: parent.width;
                    height: parent.height;
                    text <=> root.text;
                    color: Theme.ink;
                    font-family: Theme.body;
                    font-size: root.font;
                    vertical-alignment: center;
                    single-line: true;
                    accessible-label: root.label;
                    accessible-placeholder-text: root.placeholder;
                    selection-background-color: Theme.pop.with-alpha(0.45);
                    selection-foreground-color: Theme.ink;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(); }
                }
            }
        }
        @children
    }
}

// The link box (Download page, Phone tab): a big TextBox; Ctrl+Shift+V pastes and downloads.
export component LinkField inherits TextBox {
    paste-and-go: true;
}

// Quiet secondary action (queue header): muted text, ink on hover.
// A queue filter: a word and its count, underlined when picked. Calm (it's a view of the
// list, not an action); `attention` tints the count when there's something to look at.
export component FilterTab inherits Rectangle {
    in property <string> text;
    in property <int> count;
    in property <bool> active;
    in property <bool> attention;
    // Tabs that aren't a filter (Capture page: This PC / Phone) have no count.
    in property <bool> show-count: true;
    in property <bool> enabled: true;
    // The row's ends: the arrow keys stop there.
    // Its place in the row: the arrows go round, Home / End. Without them (hidden options),
    // `first` / `last` stop the arrows at the ends.
    in property <int> place: -1;
    in property <int> places;
    in property <bool> first: root.places > 0 && root.place == 0;
    in property <bool> last: root.places > 0 && root.place == root.places - 1;
    callback clicked();
    min-width: row.preferred-width;
    height: 32px;
    accessible-role: tab;
    accessible-label: root.show-count ? root.text + ", " + root.count : root.text;
    accessible-item-selected: root.active;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    // One Tab stop for the row (the picked tab); ← → move to the next one.
    kp := KeyPress {
        radius: 6px;
        enabled: root.enabled;
        roving: true;
        active: root.active;
        index: root.place;
        count: root.places;
        first: root.first;
        last: root.last;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { kp.take(); root.clicked(); }
    }
    row := HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Text {
            text: root.text;
            color: root.active || ta.has-hover ? Theme.ink : Theme.muted;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }
        if root.show-count: Text {
            text: root.count;
            color: root.attention && root.count > 0 ? Theme.warn : Theme.muted;
            font-family: Theme.mono;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        border-radius: 1px;
        background: root.active ? Theme.ink : transparent;
    }
}

export component TextLink inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    min-width: row.preferred-width;
    height: 30px;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    kp := KeyPress {
        radius: 6px;
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { kp.take(); root.clicked(); }
    }
    row := HorizontalLayout {
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            text: root.icon;
            font-size: 12px;
            color: ta.has-hover ? Theme.ink : Theme.muted;
        }
        Text {
            text: root.text;
            color: ta.has-hover ? Theme.ink : Theme.muted;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// Keyboard shortcut hint: "Ctrl V".
export component Kbd inherits Rectangle {
    in property <string> text;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.line-strong;
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.line-strong;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;  // ui-rules: a keycap, thicker at the bottom
        padding-bottom: 3px;  // ui-rules: a keycap, thicker at the bottom
        Text {
            text: root.text;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// A tickbox you press: 2px outline, ink fill with a check when on. The label is part of
// the target. `hint`: what it does, in a muted line 4px under the label and lined up with it
// (shadcn's Field description), so it reads as this setting's, not the next one's.
// A column (the row you press, then the hint) so the hint's wrapped lines count in the
// height: inside the pressable box, Slint measured them short and they ran into what's next.
export component Tick inherits VerticalLayout {
    in-out property <bool> checked;
    in property <string> text;
    // One line, cut with "…" when too long (song names in a list).
    in property <bool> elide;
    in property <bool> enabled: true;
    in property <string> hint;
    callback toggled(bool);
    spacing: Space.hint;
    box := Rectangle {
        min-height: 28px;
        // Its full text as the narrowest it gets (labels are short).
        min-width: root.elide ? 60px : row.preferred-width;
        opacity: root.enabled ? 1 : 0.4;
        accessible-role: checkbox;
        accessible-label: root.text;
        accessible-description: root.hint;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-enabled: root.enabled;
        accessible-action-default => {
            if root.enabled {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
        kp := KeyPress {
            radius: 8px;
            enabled: root.enabled;
            activated => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                kp.take();
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
        row := HorizontalLayout {
            spacing: 8px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                // shadcn's checkbox proportions (its checkbox.tsx): the tick is Lucide's
                // check path, drawn with a 2px rounded stroke and filling most of the box,
                // not an icon-font glyph (that one was a hairline speck in a white block).
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 5px;
                    border-width: 2px;
                    border-color: root.checked ? Theme.ink : ta.has-hover ? Theme.muted : Theme.edge;
                    background: root.checked ? Theme.ink : transparent;
                    animate background, border-color { duration: 90ms; }
                    if root.checked: Path {
                        width: 14px;
                        height: 14px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M 20 6 L 9 17 L 4 12";
                        stroke: Theme.bg;
                        stroke-width: 2.25px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        fill: transparent;
                    }
                }
            }
            if root.text != "": Text {
                horizontal-stretch: 1;
                text: root.text;
                color: Theme.ink;
                font-family: Theme.body;
                font-size: 13px;
                vertical-alignment: center;
                wrap: root.elide ? no-wrap : word-wrap;
                overflow: root.elide ? TextOverflow.elide : TextOverflow.clip;
            }
        }
    }
    // Under the label: the box (18) and the gap (8) to its left. The text gets its width
    // here and its holder takes the height it wraps to: an indent from a layout's padding
    // made Slint measure the wrapped lines at the full width, a line or two short, and the
    // hint ran into what came next.
    if root.hint != "": Rectangle {
        height: hint-text.preferred-height;
        hint-text := Text {
            x: 26px;
            y: 0;
            width: parent.width - 26px;
            text: root.hint;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 12px;
            wrap: word-wrap;
            opacity: root.enabled ? 1 : 0.4;
        }
    }
}

// The dimmed layer under a dialog, the Settings drawer, the palette or a sheet; put it over
// the whole window and the card inside it. What every one of them does:
// - a click on the dimmed part closes it (`outside-closes`; off where something typed
//   would be lost), Esc closes it from anywhere inside (`closable`);
// - the mouse wheel stops here: the page behind never scrolls;
// - it takes the keyboard when it opens (`take-focus`), and Tab goes round the controls
//   inside instead of out to the page behind (Shift+Tab too).
// The card should swallow clicks and the wheel itself (`TouchArea { scroll-event(e) => {
// return accept; } }` first inside it), so they don't reach the layer.
export component Backdrop inherits Rectangle {
    in property <bool> closable: true;
    in property <bool> outside-closes: true;
    // Compact's Settings is a full sheet: nothing to dim.
    in property <bool> dim: true;
    in property <bool> take-focus: true;
    in property <string> label;
    // 0 → 1 as what's on it comes in (Settings slides): the dimming follows.
    in property <float> fade: 1;
    callback close();
    background: root.dim ? Theme.scrim.transparentize(1 - root.fade) : transparent;
    // keyboard: Esc closes it (the FocusScope below).
    TouchArea {
        clicked => {
            if root.closable && root.outside-closes {
                root.close();
            }
        }
        scroll-event(event) => { return accept; }
    }
    // Which way the last Tab went (Shift+Tab: back), for going round at the ends.
    property <bool> back;
    // Rust remembers what had the keyboard and gives it back once this layer is gone. Opened
    // from the keyboard, it starts on its first control (a text field, or a dialog's safe
    // button: "Keep it" comes before "Delete"); from the mouse, nothing shows a ring until Tab.
    init => {
        if root.take-focus {
            Nav.layer-opening();
            head.focus();
            Nav.layer-opened();
            if Nav.keyboard {
                Nav.focus-step(true);
            }
        }
    }
    keys := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        accessible-role: groupbox;
        accessible-label: root.label;
        capture-key-pressed(event) => {
            if event.text == Key.Tab {
                root.back = event.modifiers.shift;
            } else if event.text == Key.Backtab {
                root.back = true;
            }
            reject
        }
        key-pressed(event) => {
            if event.text == Key.Escape && root.closable {
                root.close();
                return accept;
            }
            reject
        }
        // The ends of the Tab order inside: reaching one goes round to the other side.
        head := FocusScope {
            x: 0;
            y: 0;
            width: 1px;
            height: 1px;
            focus-on-click: false;
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation && root.back {
                    tail.focus();
                    Nav.focus-step(false);
                }
            }
            key-pressed(event) => {
                // Shift+Tab right after it opened: round to the last control.
                if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                    tail.focus();
                    Nav.focus-step(false);
                    return accept;
                }
                reject
            }
        }
        @children
        tail := FocusScope {
            x: 0;
            y: 0;
            width: 1px;
            height: 1px;
            focus-on-click: false;
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation && !root.back {
                    head.focus();
                    Nav.focus-step(true);
                }
            }
        }
    }
}

// The floating card for dialogs: scrim, `panel`, 1px `line-strong`, 12px radius, a title
// with an optional line under it, and a close button. Put it over the whole window.
// `fit` sizes the card to its content instead of `card-height`. Behaves as `Backdrop` says.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> card-width: 560px;
    in property <length> card-height: 520px;
    in property <bool> fit;
    // Esc and the × close it. Off for dialogs that need an answer.
    in property <bool> closable: true;
    // A click outside closes it too. Off where even an untouched dialog shouldn't go on a
    // stray click.
    in property <bool> outside-closes: true;
    // An editor with changes not saved yet: Esc, × or a click outside first asks "Discard
    // your changes?" (the UI SDK's `dismissible: false` + `onDismissAttempt`). Untouched, it
    // closes as any dialog does.
    in property <bool> dirty;
    callback close();
    // Compact windows: the card goes nearly edge to edge.
    property <length> margin: Screen.compact ? 24px : 48px;
    property <bool> asking;
    // A way out was taken (Esc, ×, a click outside).
    function leave() {
        if root.asking {
            root.asking = false;
        } else if root.dirty {
            root.asking = true;
        } else {
            root.close();
        }
    }
    Backdrop {
        width: root.width;
        height: root.height;
        closable: root.closable;
        outside-closes: root.outside-closes;
        label: root.title;
        close => { root.leave(); }
        Rectangle {
            width: min(root.card-width, root.width - root.margin);
            height: root.fit ? min(body.preferred-height, root.height - root.margin) : min(root.card-height, root.height - root.margin);
            border-radius: 12px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line-strong;
            clip: true;
            TouchArea {
                scroll-event(event) => { return accept; }
            }
            body := VerticalLayout {
                padding: Space.inset;
                spacing: Space.block;
                HorizontalLayout {
                    spacing: Space.inline;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Space.hint;
                        Text {
                            text: root.title;
                            color: Theme.ink;
                            font-family: Theme.display;
                            font-size: 20px;
                            font-weight: 700;
                            letter-spacing: -0.4px;
                            wrap: word-wrap;
                        }
                        if root.subtitle != "": Text {
                            text: root.subtitle;
                            color: Theme.muted;
                            font-family: Theme.body;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                    // Room for the ×, drawn below (after the content, so Tab reaches the
                    // dialog's own controls first, as shadcn's dialog does).
                    if root.closable: Rectangle {
                        width: 32px;
                        height: 32px;
                    }
                }
                @children
            }
            if root.closable: IconButton {
                x: parent.width - self.width - Space.inset;
                y: Space.inset;
                icon: "\u{E711}";
                label: "Close";
                clicked => { root.leave(); }
            }
            // "Discard your changes?" over the card; Esc (or a click outside) keeps editing.
            // A small card over the dimmed editor, not the whole tall card.
            if root.asking: Rectangle {
                background: Theme.scrim;
                TouchArea {
                    scroll-event(event) => { return accept; }
                }
                Rectangle {
                    width: min(360px, parent.width - 2 * Space.inset);
                    height: ask.preferred-height;
                    border-radius: 12px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line-strong;
                ask := VerticalLayout {
                    padding: Space.inset;
                    spacing: Space.block;
                    alignment: start;
                    Text {
                        text: "Discard your changes?";
                        color: Theme.ink;
                        font-family: Theme.display;
                        font-size: 18px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "What you changed here isn't saved yet.";
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Space.inline;
                        alignment: start;
                        // First: the safe one gets the keyboard (Radix AlertDialog, UI SDK).
                        keep := GhostButton {
                            text: "Keep editing";
                            clicked => { root.asking = false; }
                        }
                        GhostButton {
                            text: "Discard";
                            clicked => {
                                root.asking = false;
                                root.close();
                            }
                        }
                    }
                }
                }
                init => { keep.take-focus(); }
            }
        }
    }
}

// A big pressable option in a dialog ("Clip it" / "Compress it"): outlined like any
// control, icon, short title and one muted line.
export component ChoiceTile inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    callback clicked();
    min-height: col.preferred-height;
    border-radius: 12px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.text;
    accessible-action-default => { root.clicked(); }
    kp := KeyPress {
        radius: 12px;
        activated => { root.clicked(); }
    }
    border-width: 2px;
    border-color: ta.has-hover ? Theme.ink : Theme.line-strong;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    animate background, border-color { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { kp.take(); root.clicked(); }
    }
    col := VerticalLayout {
        padding: 16px;
        spacing: 6px;
        Icon {
            text: root.icon;
            font-size: 20px;
            horizontal-alignment: left;
        }
        Text {
            text: root.title;
            color: Theme.ink;
            font-family: Theme.display;
            font-size: 16px;
            font-weight: 700;
        }
        Text {
            text: root.text;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// A row of chips where one is picked (quality, clip mode, compress goal…). Wraps onto
// more lines when the window is too narrow for one. It takes the row's free width (chips
// stay left) so it only wraps when it has to, and never grows taller than its lines.
export component ChoiceChips inherits FlexboxLayout {
    in property <[string]> options;
    in-out property <int> current;
    callback changed();
    horizontal-stretch: 1;
    vertical-stretch: 0;
    spacing: Screen.compact ? 8px : 8px;
    accessible-role: radio-group;
    // One Tab stop (the picked chip, or the first when none is), ← → move and pick, as a
    // radio group does.
    for option[i] in root.options: Chip {
        horizontal-stretch: 0;
        text: option;
        selected: root.current == i;
        roving: true;
        tab-stop: root.current == i || (i == 0 && (root.current < 0 || root.current >= root.options.length));
        index: i;
        count: root.options.length;
        clicked => {
            root.current = i;
            root.changed();
        }
    }
}

// The ⋯ button's pop-up (queue rows on compact windows): a floating card of calm rows.
// Put the `MenuItem`s inside; the `PopupWindow` around it closes on any click, and Esc
// closes it and gives the keyboard back. ↓ (or Tab) reaches the first item, ↑ ↓ move.
// Longer than `tallest`, it scrolls.
export component Menu inherits Rectangle {
    in property <length> tallest: 420px;
    width: 200px;
    height: min(col.preferred-height, root.tallest);
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line-strong;
    clip: true;
    accessible-role: list;
    // Takes the keyboard once it's open, so ↓ works before anything is focused. (Not in
    // `init`: Slint clears the focus right after building a pop-up, and gives it back to
    // what had it when the pop-up closes.)
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            keys.focus();
            // Opened from the keyboard: straight to the first item (Radix, the UI SDK).
            if Nav.keyboard {
                Nav.focus-step(true);
            }
        }
    }
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.DownArrow {
                Nav.focus-step(true);
                return accept;
            }
            // Typeahead: a letter jumps to the next item starting with it (typed quickly, a
            // few letters; the same letter again goes on to the next match), as in Radix
            // and the UI SDK. Rust does the moving.
            if !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && Nav.typeahead(event.text) {
                return accept;
            }
            if event.text == Key.UpArrow {
                Nav.focus-step(false);
                return accept;
            }
            reject
        }
        Flickable {
            col := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                @children
            }
        }
    }
}

export component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    // Its keyboard shortcut, said quietly on the right ("Ctrl+Shift+V").
    in property <string> shortcut;
    // The picked one of a list (Site: YouTube): a ✓ in place of the icon, said as checked.
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.4;
    // The pointer and the keyboard share one highlight: hovering a row focuses it (so ↓ goes
    // on from there), and a focused row shows the hover fill, no ring (Radix, the UI SDK).
    // What a screen reader says sits on the part that takes focus: screen readers follow
    // focus, and the menu's typeahead (Rust) matches letters against this label.
    kp := KeyPress {
        radius: 8px;
        enabled: root.enabled;
        arrows: true;
        ring: false;
        accessible-role: button;
        accessible-label: root.text;
        accessible-checkable: root.checked;
        accessible-checked: root.checked;
        accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { root.clicked(); } }
        activated => { root.clicked(); }
    }
    background: ta.pressed ? Theme.line : ta.has-hover || kp.has-focus ? Theme.raised : transparent;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.enabled {
                kp.focus();
            }
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        spacing: 8px;
        Icon {
            width: 16px;
            text: root.checked ? "\u{E73E}" : root.icon;
            font-size: 13px;
            color: ta.has-hover || kp.has-focus ? Theme.ink : Theme.muted;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.shortcut != "": Text {
            horizontal-stretch: 0;
            text: root.shortcut;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// 1px hairline between sections. `inset-right` stops it short of a list's scrollbar lane.
export component Divider inherits Rectangle {
    in property <length> inset-right;
    height: 1px;
    Rectangle {
        x: 0;
        width: parent.width - root.inset-right;
        background: Theme.line;
    }
}

// A calm list row with a hairline at the bottom. The hairline stops short of the
// ListView's scrollbar lane (`lane`; 0 outside a ListView).
export component ListRow inherits Rectangle {
    in property <length> lane: Theme.lane;
    @children
    Rectangle {
        x: 0;
        y: root.height - 1px;
        width: root.width - root.lane;
        height: 1px;
        background: Theme.line;
    }
}

// Rounded picture box: thumbnails, covers, file previews. Children sit on top (status icons).
export component Thumb inherits Rectangle {
    in property <image> source;
    border-radius: 6px;
    background: Theme.raised;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
    @children
}

// A round "play" mark over a thumbnail: watch the link before downloading it.
export component PlayMark inherits Rectangle {
    in property <string> label: "Watch it";
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 2px;
    border-color: Theme.hard;
    background: ta.pressed ? Theme.pop-hover : Theme.pop;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    kp := KeyPress {
        radius: 20px;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { kp.take(); root.clicked(); }
    }
    Icon {
        x: (parent.width - self.width) / 2 + 1px;
        text: "\u{E768}";
        font-size: 15px;
        color: Theme.on-pop;
    }
}

// One line of status next to an icon: "That's not a link yet", "Already downloaded",
// warnings. Children (a link, a button) follow the text.
export component Notice inherits HorizontalLayout {
    in property <string> icon: "\u{E7BA}";
    in property <string> text;
    in property <color> color: Theme.warn;
    in property <color> icon-color: root.color;
    in property <length> icon-size: 13px;
    in property <length> font-size: 12px;
    in property <bool> wrap;
    // false: the text takes only its own width (children then end with a spacer).
    in property <bool> fill: true;
    // Cut long text with "…" instead of wrapping.
    in property <bool> elide;
    spacing: 8px;
    Icon {
        horizontal-stretch: 0;
        text: root.icon;
        font-size: root.icon-size;
        color: root.icon-color;
    }
    Text {
        horizontal-stretch: root.fill ? 1 : 0;
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        wrap: root.wrap ? word-wrap : no-wrap;
        overflow: root.elide ? TextOverflow.elide : TextOverflow.clip;
        vertical-alignment: center;
    }
    @children
}

// The one toast: a short message at the bottom (or over the player), up to `widest`; the
// window places it. `kind`: 0 done (✓), 1 heads-up (i), 2 a problem (!); `tag` shows a Tag
// in place of the icon ("Saved", 'Heard "clip that"'). Long text wraps (three lines at
// most). Buttons (Undo, Open) go inside, after the text. × closes it (`closed`); while the
// pointer is over it, it stays (`Nav.toast-hover`, read by the Rust timers).
export component Toast inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <string> tag;
    in property <int> tag-kind: 1;
    in property <length> widest;
    in property <bool> closable: true;
    callback closed();
    width: min(row.preferred-width, root.widest);
    height: max(46px, row.preferred-height);
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: root.kind == 2 ? Theme.bad : Theme.line-strong;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    hover := TouchArea {
        changed has-hover => { Nav.toast-hover = self.has-hover; }
    }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: root.closable ? 6px : 16px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        if root.tag != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Tag {
                text: root.tag;
                kind: root.tag-kind;
            }
        }
        if root.tag == "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                background: root.kind == 2 ? Theme.bad-bg : root.kind == 1 ? Theme.raised : Theme.ok-bg;
                Icon {
                    text: root.kind == 2 ? "\u{E7BA}" : root.kind == 1 ? "\u{E946}" : "\u{E73E}";
                    font-size: 11px;
                    color: root.kind == 2 ? Theme.bad : root.kind == 1 ? Theme.ink : Theme.ok;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
            wrap: word-wrap;
            max-height: 3 * 18px;
            overflow: elide;
        }
        @children
        if root.closable: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            IconButton {
                icon: "\u{E711}";
                label: "Close";
                clicked => { root.closed(); }
            }
        }
    }
}

// A control and the hint that explains it, kept together: the hint 4px under it (the next
// setting is further away, `Space.item`). Tick has its own `hint`; this is for the rest
// (a SettingRow, a text box, a choice row).
export component Field inherits VerticalLayout {
    spacing: Space.hint;
}

// A small heading over a group of choices (Capture page, Phone tab).
export component Head inherits Text {
    color: Theme.ink;
    font-family: Theme.display;
    font-size: 14px;
    font-weight: 700;
}

// A sheet from the bottom on compact windows (Library: Filter, the picked thing): a grab
// bar, then what's inside (its own title row with ×), scrolling when it's taller than the
// window allows. `title` is what a screen reader says. Behaves as `Backdrop` says.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <bool> outside-closes: true;
    callback close();
    Backdrop {
        width: root.width;
        height: root.height;
        outside-closes: root.outside-closes;
        label: root.title;
        close => { root.close(); }
        Rectangle {
            x: 0;
            y: root.height - self.height;
            width: root.width;
            height: min(col.preferred-height + 2px, root.height - 40px);
            border-radius: 14px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line-strong;
            clip: true;
            TouchArea {
                scroll-event(event) => { return accept; }
            }
            ScrollView {
                col := VerticalLayout {
                    padding: 16px;
                    padding-top: 12px;
                    spacing: 12px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 40px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.line-strong;
                        }
                    }
                    @children
                }
            }
        }
    }
}

// A handle to drag a row up or down a list (≡). With the keyboard: Tab to it, ↑ / ↓ move
// the row one place, Ctrl+↑ / Ctrl+↓ to the top / bottom (`jump`). `dragging` reports how
// far the pointer is from where it was pressed.
// The crop frame over a picture (Clip page → Picture): the part kept is clear, the rest
// shaded. Drag inside to move it, drag a corner to size it. `ratio` (width / height, in
// pixels) keeps the shape; 0 = any shape. Keyboard: arrows move it, Shift+arrows size it.
// cx/cy/cw/ch are fractions 0..1 of the picture.
export component CropFrame inherits Rectangle {
    in-out property <float> cx;
    in-out property <float> cy;
    in-out property <float> cw: 1;
    in-out property <float> ch: 1;
    in property <float> ratio;
    // A drag or key ended: the frame is where the user left it.
    callback moved();
    property <length> fx: root.cx * root.width;
    property <length> fy: root.cy * root.height;
    property <length> fw: root.cw * root.width;
    property <length> fh: root.ch * root.height;
    // 0 moving, 1 top-left corner, 2 bottom-right corner, -1 nothing
    property <int> grab: -1;
    property <float> sx;
    property <float> sy;
    property <float> sw;
    property <float> sh;
    property <float> pic: root.width / max(1px, root.height);

    // Size from one corner, the other corner staying put; keeps `ratio` when set.
    function resize(nw: float, nh: float, from-tl: bool) {
        let right = root.sx + root.sw;
        let bottom = root.sy + root.sh;
        let room-w = from-tl ? right : 1 - root.sx;
        let room-h = from-tl ? bottom : 1 - root.sy;
        let w0 = max(0.05, min(room-w, nw));
        let h0 = root.ratio > 0 ? w0 * root.pic / root.ratio : max(0.05, min(room-h, nh));
        let h = min(room-h, h0);
        let w = root.ratio > 0 ? h * root.ratio / root.pic : w0;
        root.cw = w;
        root.ch = h;
        root.cx = from-tl ? right - w : root.sx;
        root.cy = from-tl ? bottom - h : root.sy;
    }
    function start() {
        root.sx = root.cx;
        root.sy = root.cy;
        root.sw = root.cw;
        root.sh = root.ch;
    }

    // Shade outside the frame.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.fy;
        background: Theme.video-veil;
    }
    Rectangle {
        x: 0;
        y: root.fy + root.fh;
        width: root.width;
        height: max(0px, root.height - root.fy - root.fh);
        background: Theme.video-veil;
    }
    Rectangle {
        x: 0;
        y: root.fy;
        width: root.fx;
        height: root.fh;
        background: Theme.video-veil;
    }
    Rectangle {
        x: root.fx + root.fw;
        y: root.fy;
        width: max(0px, root.width - root.fx - root.fw);
        height: root.fh;
        background: Theme.video-veil;
    }
    // The frame, thirds lines and two corner grips.
    Rectangle {
        x: root.fx;
        y: root.fy;
        width: root.fw;
        height: root.fh;
        border-width: 2px;
        border-color: keys.has-focus ? Theme.focus : Theme.accent-hi;
        Rectangle { x: parent.width / 3; width: 1px; height: parent.height; background: Theme.accent-hi.with-alpha(0.35); }
        Rectangle { x: parent.width * 2 / 3; width: 1px; height: parent.height; background: Theme.accent-hi.with-alpha(0.35); }
        Rectangle { y: parent.height / 3; width: parent.width; height: 1px; background: Theme.accent-hi.with-alpha(0.35); }
        Rectangle { y: parent.height * 2 / 3; width: parent.width; height: 1px; background: Theme.accent-hi.with-alpha(0.35); }
    }
    Rectangle {
        x: root.fx - 6px;
        y: root.fy - 6px;
        width: 14px;
        height: 14px;
        border-radius: 4px;
        background: Theme.accent-hi;
    }
    Rectangle {
        x: root.fx + root.fw - 8px;
        y: root.fy + root.fh - 8px;
        width: 14px;
        height: 14px;
        border-radius: 4px;
        background: Theme.accent-hi;
    }

    keys := FocusScope {
        accessible-role: groupbox;
        accessible-label: "Crop frame: arrows move it, Shift and arrows change its size";
        key-pressed(event) => {
            let step = 0.01;
            root.start();
            if event.modifiers.shift && (event.text == Key.RightArrow || event.text == Key.LeftArrow
                    || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                let grow = event.text == Key.RightArrow || event.text == Key.DownArrow ? step : -step;
                root.resize(root.cw + grow, root.ch + grow, false);
                root.moved();
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.cx = max(0, min(1 - root.cw, root.cx + (event.text == Key.RightArrow ? step : -step)));
                root.moved();
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.cy = max(0, min(1 - root.ch, root.cy + (event.text == Key.DownArrow ? step : -step)));
                root.moved();
                return accept;
            }
            reject
        }
    }
    TouchArea {
        mouse-cursor: root.grab == 0 ? MouseCursor.grabbing : MouseCursor.crosshair;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                keys.focus();
                root.start();
                let px = self.mouse-x;
                let py = self.mouse-y;
                root.grab = abs(px - root.fx - root.fw) < 18px && abs(py - root.fy - root.fh) < 18px ? 2
                    : abs(px - root.fx) < 18px && abs(py - root.fy) < 18px ? 1
                    : px > root.fx && px < root.fx + root.fw && py > root.fy && py < root.fy + root.fh ? 0
                    : -1;
            }
            if e.kind == PointerEventKind.up && root.grab >= 0 {
                root.grab = -1;
                root.moved();
            }
        }
        moved => {
            if self.pressed && root.grab >= 0 {
                let dx = (self.mouse-x - self.pressed-x) / max(1px, root.width);
                let dy = (self.mouse-y - self.pressed-y) / max(1px, root.height);
                if root.grab == 0 {
                    root.cx = max(0, min(1 - root.cw, root.sx + dx));
                    root.cy = max(0, min(1 - root.ch, root.sy + dy));
                } else if root.grab == 2 {
                    root.resize(root.sw + dx, root.sh + dy, false);
                } else {
                    root.resize(root.sw - dx, root.sh - dy, true);
                }
            }
        }
    }
}

export component DragHandle inherits Rectangle {
    in property <string> label: "Move";
    // Take the keyboard when this turns true (or the handle is created with it true): a list
    // that rebuilds its rows after a move gives the focus back to the moved row's handle.
    in property <bool> want-focus;
    callback step(int);
    callback jump(int);
    init => {
        if root.want-focus {
            fs.focus();
        }
    }
    changed want-focus => {
        if root.want-focus {
            fs.focus();
        }
    }
    callback dragging(length);
    callback dropped();
    width: 24px;
    height: 30px;
    border-radius: 6px;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.label + " (up and down arrows, Ctrl to go to the top or bottom)";
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.modifiers.control && event.text == Key.UpArrow {
                root.jump(-1);
                return accept;
            }
            if event.modifiers.control && event.text == Key.DownArrow {
                root.jump(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.step(-1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.step(1);
                return accept;
            }
            reject
        }
    }
    if fs.has-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: root.width + 8px;
        height: root.height + 8px;
        border-radius: 10px;
        border-width: 2px;
        border-color: Theme.focus;
    }
    ta := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        moved => {
            if self.pressed {
                root.dragging(self.mouse-y - self.pressed-y);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up {
                root.dropped();
            }
        }
    }
    Icon {
        text: "\u{E700}";
        font-size: 13px;
        color: ta.has-hover || ta.pressed ? Theme.ink : Theme.dim;
    }
}

// One choice in a list of choices you compare before picking (Compress goals): a round
// mark, the name, a muted hint and a value on the right (under the name on compact
// windows). Calm like a list row, the mark and the hover say it's pressable; the picked row
// gets an ink mark. Rows sit on hairlines.
export component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> value;
    in property <bool> selected;
    // The hint is a problem (too long, already fits): warn colour.
    in property <bool> warn;
    // The hint under the title at every width (it must be read whole, not cut short).
    in property <bool> stacked;
    property <bool> below: Screen.compact || root.stacked;
    callback clicked();
    min-height: col.preferred-height;
    accessible-role: radio-button;
    accessible-label: root.title;
    accessible-description: root.hint + " " + root.value;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    kp := KeyPress {
        radius: 8px;
        activated => { root.clicked(); }
    }
    background: ta.has-hover ? Theme.raised : transparent;
    border-radius: 8px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { kp.take(); root.clicked(); }
    }
    Rectangle {
        x: 0;
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: Theme.line;
    }
    col := HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: root.selected ? 6px : 2px;
                border-color: root.selected ? Theme.ink : ta.has-hover ? Theme.muted : Theme.edge;
                animate border-width, border-color { duration: 90ms; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    color: Theme.ink;
                    font-family: Theme.body;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                if !root.below && root.hint != "": Text {
                    text: root.hint;
                    color: root.warn ? Theme.warn : Theme.muted;
                    font-family: Theme.body;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            if root.below && (root.hint != "" || root.value != ""): Text {
                // A warning says it all ("already under 20 MB"): no value after it.
                text: root.hint == "" ? root.value : root.value == "" || root.warn ? root.hint : root.hint + " · " + root.value;
                color: root.warn ? Theme.warn : Theme.muted;
                font-family: Theme.mono;
                font-size: 11.5px;
                wrap: word-wrap;
            }
        }
        // Stacked rows say their value under the name already.
        if !root.below && root.value != "": Text {
            horizontal-stretch: 0;
            text: root.value;
            color: root.selected ? Theme.ink : Theme.muted;
            font-family: Theme.mono;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// The same moment before and after: the after picture over the before one, cut at a line
// you drag (or move with ← →). Calm (a picture you read); the grip on the line is the
// pressable part. Both pictures fill the box the same way, so they line up.
export component CompareSlider inherits Rectangle {
    in property <image> before;
    in property <image> after;
    in property <string> before-label: "Now";
    in property <string> after-label: "After";
    // Covered while the pictures are being made ("Working it out…").
    in property <string> busy-text;
    in-out property <float> split: 0.5;
    border-radius: 10px;
    background: Theme.video;
    clip: true;
    accessible-role: slider;
    accessible-label: "Before and after (left and right arrows)";
    accessible-value: Math.round(root.split * 100) + "%";
    Image {
        width: parent.width;
        height: parent.height;
        source: root.before;
        image-fit: contain;
    }
    Rectangle {
        x: root.width * root.split;
        width: root.width * (1 - root.split);
        height: root.height;
        clip: true;
        Image {
            x: -parent.x;
            width: root.width;
            height: root.height;
            source: root.after;
            image-fit: contain;
        }
    }
    if root.busy-text != "": Rectangle {
        background: Theme.video-veil;
        Text {
            text: root.busy-text;
            color: Theme.strip-mark;
            font-family: Theme.body;
            font-size: 13px;
        }
    }
    Rectangle {
        x: 8px;
        y: 8px;
        width: bl.preferred-width + 14px;
        height: 20px;
        border-radius: 6px;
        background: Theme.video-veil;
        bl := Text {
            text: root.before-label;
            color: Theme.strip-mark;
            font-family: Theme.display;
            font-size: 11px;
            font-weight: 700;
        }
    }
    Rectangle {
        x: root.width - self.width - 8px;
        y: 8px;
        width: al.preferred-width + 14px;
        height: 20px;
        border-radius: 6px;
        background: Theme.video-veil;
        al := Text {
            text: root.after-label;
            color: Theme.strip-mark;
            font-family: Theme.display;
            font-size: 11px;
            font-weight: 700;
        }
    }
    // The line and its grip (not while the pictures are being made).
    if root.busy-text == "": Rectangle {
        x: root.width * root.split - 1px;
        width: 2px;
        height: root.height;
        background: Theme.strip-mark;
    }
    if root.busy-text == "": Rectangle {
        x: root.width * root.split - 14px;
        y: root.height / 2 - 12px;
        width: 28px;
        height: 24px;
        border-radius: 8px;
        background: Theme.strip-mark;
        Icon {
            text: "\u{E8AB}";
            font-size: 12px;
            color: Theme.video;
        }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.split = max(0, root.split - 0.05);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.split = min(1, root.split + 0.05);
                return accept;
            }
            reject
        }
    }
    // The focus ring sits on the pictures: a video mark, so it shows in both themes.
    if fs.has-focus: Rectangle {
        border-radius: 10px;
        border-width: 2px;
        border-color: Theme.strip-mark;
    }
    TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.split = max(0, min(1, self.mouse-x / root.width));
            }
        }
        moved => {
            if self.pressed {
                root.split = max(0, min(1, self.mouse-x / root.width));
            }
        }
    }
}

// Compact windows: Settings, at the right end of every page's header (the tab bar holds the
// five pages). Put it last in the header row, behind `if Screen.compact`.
export component SettingsGear inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 0;
    HorizontalLayout {
        // Its own height, so the page's `alignment` places it (level with the headline).
        vertical-stretch: 0;
        spacing: 6px;
        // The command palette (on compact there's no rail button, and often no keyboard).
        GhostButton {
            compact: true;
            icon: "\u{E721}";
            label: "Search and do anything";
            clicked => { Nav.palette-open = true; }
        }
        GhostButton {
            compact: true;
            icon: "\u{E713}";
            label: "Settings";
            clicked => { Nav.settings-open = true; }
        }
    }
}

// The rail's way into the command palette: a magnifier with its key under it.
export component RailSearch inherits Rectangle {
    height: 42px;
    border-radius: 10px;
    border-width: 2px;
    border-color: Theme.line-strong;
    background: ta.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: "Search and do anything (Ctrl+K)";
    accessible-action-default => { Nav.palette-open = true; }
    kp := KeyPress {
        radius: 10px;
        activated => { Nav.palette-open = true; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { kp.take(); Nav.palette-open = true; }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Icon {
            text: "\u{E721}";
            font-size: 14px;
            color: Theme.muted;
        }
        Text {
            text: "Ctrl K";
            font-family: Theme.mono;
            font-size: 9.5px;
            color: Theme.muted;
            horizontal-alignment: center;
        }
    }
}
