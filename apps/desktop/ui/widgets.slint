// Shared controls. Rule: anything you press is playful (outline, sticker
// yellow, hard shadow on the main action); anything you read is calm.

import { Theme, Screen, Nav } from "theme.slint";

export component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 16px;
    color: Theme.ink;
    vertical-alignment: center;
    horizontal-alignment: center;
}

// Keyboard for a pressable control: Tab reaches it, Enter or Space presses it, and a 2px
// ring shows around it while it has focus (clicks with the mouse don't show it). Put it
// inside the control; it fills it. `radius` is the control's corner radius.
export component KeyPress inherits FocusScope {
    in property <length> radius: 10px;
    callback activated();
    focus-on-click: false;
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " {
            root.activated();
            return accept;
        }
        reject
    }
    if root.has-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: root.width + 8px;
        height: root.height + 8px;
        border-radius: root.radius + 4px;
        border-width: 2px;
        border-color: Theme.focus;
    }
}

// The one main action on a screen: sticker yellow, black outline, hard shadow.
// Presses down onto its shadow.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    // A split button: a ▾ part on the right opens more ways to do it (`menu-clicked`).
    in property <bool> has-menu;
    callback clicked();
    callback menu-clicked();
    property <length> menu-w: root.has-menu ? 34px : 0px;
    property <bool> menu-pressed;
    // Greyed out it stays up (no shadow under it), so it lines up with a GhostButton beside it.
    property <length> lift: root.enabled && (ta.pressed || root.menu-pressed) ? 1px : 3px;
    min-width: face-row.preferred-width + 3px + root.menu-w;
    height: 44px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    KeyPress {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
    // Shadow
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 3px;
        height: parent.height - 3px;
        border-radius: 10px;
        background: root.enabled ? Theme.pop-shadow : transparent;
    }
    // Face
    Rectangle {
        x: 3px - root.lift;
        y: 3px - root.lift;
        width: parent.width - 3px;
        height: parent.height - 3px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.enabled ? Theme.hard : Theme.line-strong;
        background: !root.enabled ? Theme.raised : ta.has-hover ? Theme.pop-hover : Theme.pop;
        animate x, y { duration: 70ms; }
        face-row := HorizontalLayout {
            width: parent.width - root.menu-w;
            x: 0;
            padding-left: 18px;
            padding-right: root.has-menu ? 14px : 18px;
            spacing: 8px;
            alignment: center;
            if root.icon != "": Icon {
                text: root.icon;
                font-size: 14px;
                color: root.enabled ? Theme.on-pop : Theme.dim;
            }
            Text {
                text: root.text;
                color: root.enabled ? Theme.on-pop : Theme.dim;
                font-family: Theme.display;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        if root.has-menu: Rectangle {
            x: parent.width - root.menu-w - 1px;
            width: 2px;
            y: 8px;
            height: parent.height - 16px;
            background: root.enabled ? Theme.hard : Theme.line-strong;
            opacity: 0.45;
        }
        if root.has-menu: Icon {
            x: parent.width - root.menu-w;
            width: root.menu-w;
            text: "\u{E70D}";
            font-size: 11px;
            color: root.enabled ? Theme.on-pop : Theme.dim;
        }
    }
    ta := TouchArea {
        width: parent.width - root.menu-w;
        x: 0;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    // The ▾ part: its own key stop, so Tab reaches "more ways" too.
    if root.has-menu: Rectangle {
        x: parent.width - root.menu-w - 3px;
        width: root.menu-w + 3px;
        accessible-role: button;
        accessible-label: "More ways to download";
        accessible-action-default => { root.menu-clicked(); }
        KeyPress {
            radius: 10px;
            activated => { root.menu-clicked(); }
        }
        TouchArea {
            changed pressed => { root.menu-pressed = self.pressed; }
            mouse-cursor: pointer;
            clicked => { root.menu-clicked(); }
        }
    }
}

// Everything else you can press: outlined, no fill.
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> compact;
    // What a screen reader says; needed when the button is an icon only.
    in property <string> label: root.text;
    // Something is set here (Sound, Picture changed): a yellow outline says so, also when
    // the button is only an icon.
    in property <bool> on;
    // A small icon after the text (a fold's chevron).
    in property <string> trail;
    callback clicked();
    // Regular size matches PrimaryButton exactly: the same 44px slot with a 41px face at
    // the top (the yellow button's 3px shadow sits below its face), so a pair lines up.
    height: root.compact ? 30px : 44px;
    // Sized by its content (which sits inside the face).
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    face := Rectangle {
        y: 0;
        width: parent.width;
        height: root.compact ? parent.height : parent.height - 3px;
        border-radius: root.compact ? 8px : 10px;
        background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
        border-width: 2px;
        border-color: root.on ? Theme.accent-hi : ta.has-hover ? Theme.muted : Theme.line-strong;
        animate background, border-color { duration: 100ms; }
        KeyPress {
            radius: parent.border-radius;
            activated => { root.clicked(); }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        row := HorizontalLayout {
            padding-left: root.compact ? 10px : 14px;
            padding-right: root.compact ? 10px : 14px;
            spacing: 7px;
            alignment: center;
            if root.icon != "": Icon {
                text: root.icon;
                font-size: root.compact ? 12px : 13px;
                color: Theme.ink;
            }
            if root.text != "": Text {
                text: root.text;
                color: Theme.ink;
                font-family: Theme.body;
                font-size: root.compact ? 12px : 13px;
                font-weight: 500;
                vertical-alignment: center;
            }
            if root.trail != "": Icon {
                text: root.trail;
                font-size: 10px;
                color: Theme.muted;
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.muted;
    // What a screen reader says ("Close", "Remove"…).
    in property <string> label;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 8px;
        activated => { root.clicked(); }
    }
    border-width: 2px;
    border-color: ta.has-hover ? Theme.line-strong : transparent;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        text: root.icon;
        font-size: 13px;
        color: ta.has-hover ? Theme.ink : root.tint;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    border-radius: 9px;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 9px;
        activated => { root.clicked(); }
    }
    background: root.selected ? Theme.ink : ta.has-hover ? Theme.raised : transparent;
    border-width: 2px;
    border-color: root.selected ? Theme.ink : ta.has-hover ? Theme.muted : Theme.line-strong;
    animate background, border-color { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Screen.compact ? 10px : 13px;
        padding-right: Screen.compact ? 10px : 13px;
        Text {
            text: root.text;
            color: root.selected ? Theme.bg : Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// Progress: a calm rounded meter in sticker yellow.
export component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.pop;
    accessible-role: progress-indicator;
    accessible-value: Math.round(root.value * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    height: 6px;
    border-radius: 3px;
    background: Theme.line;
    clip: true;
    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * max(0, min(1, root.value));
        border-radius: 3px;
        background: root.fill;
        animate width { duration: 180ms; }
    }
}

export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    // A small red dot: something of this page's is running (instant replay on).
    in property <bool> dot;
    callback clicked();
    height: 56px;
    border-radius: 12px;
    accessible-role: tab;
    accessible-label: root.label + (root.dot ? ", on" : "");
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 12px;
        activated => { root.clicked(); }
    }
    border-width: 2px;
    border-color: root.active ? Theme.line-strong : transparent;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Icon {
            text: root.icon;
            font-size: 17px;
            color: root.active ? Theme.ink : Theme.dim;
        }
        Text {
            text: root.label;
            font-family: Theme.body;
            font-size: 11px;
            font-weight: 500;
            color: root.active ? Theme.ink : Theme.muted;
            horizontal-alignment: center;
        }
    }
    if root.dot: Rectangle {
        x: root.width / 2 + 6px;
        y: 9px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.live;
    }
}

// The sticker: a rounded face with a hard outline and a hard shadow down-right. Children
// go on the face. Used for the logo mark and the drop target.
export component Sticker inherits Rectangle {
    in property <length> size: 34px;
    in property <length> radius: 10px;
    in property <color> face: Theme.pop;
    in property <color> edge: Theme.hard;
    in property <color> shadow: Theme.hard;
    width: root.size + 3px;
    height: root.size + 3px;
    Rectangle {
        x: 3px;
        y: 3px;
        width: root.size;
        height: root.size;
        border-radius: root.radius;
        background: root.shadow;
    }
    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.radius;
        background: root.face;
        border-width: 2px;
        border-color: root.edge;
        @children
    }
}

// Neria's logo mark: an "N" whose left stem is a download arrow, on the sticker.
export component LogoMark inherits Sticker {
    // Sized from `size`: it sits on the face, which isn't its `parent` here.
    Image {
        width: root.size;
        height: root.size;
        source: @image-url("../assets/neria-mark.png");
    }
}

// Big friendly page headline ("Grab anything.") with an optional line under it. Compact
// windows have no rail, so the logo mark moves next to the headline there.
export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: Screen.compact ? 4px : 6px;
    HorizontalLayout {
        spacing: 10px;
        if Screen.compact: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            LogoMark {
                size: 28px;
                radius: 8px;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: Theme.ink;
            font-family: Theme.display;
            font-size: Screen.compact ? 23px : 30px;
            font-weight: 700;
            letter-spacing: Screen.compact ? -0.6px : -1px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 13px;
        overflow: elide;
    }
}

export component SectionTitle inherits Text {
    color: Theme.ink;
    font-family: Theme.display;
    font-size: 15px;
    font-weight: 700;
}

export component Hint inherits Text {
    color: Theme.muted;
    font-family: Theme.body;
    font-size: 12px;
    wrap: word-wrap;
}

// Status sticker: 0 neutral, 1 ok, 2 warn, 3 bad, 4 pop (counts).
// kind: 0 plain, 1 ok, 2 warn, 3 bad, 4 pop (a count), 5 live (recording: a pulsing dot).
export component Tag inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    border-radius: 6px;
    background: root.kind == 1 ? Theme.ok-bg : root.kind == 2 ? Theme.warn-bg : root.kind == 3 ? Theme.bad-bg : root.kind == 4 ? Theme.pop : root.kind == 5 ? Theme.live-bg : Theme.raised;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 5px;
        if root.kind == 5: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Theme.live;
                opacity: 0.6 + 0.4 * Math.sin(animation-tick() / 260ms * 1rad);
            }
        }
        Text {
            text: root.text;
            color: root.kind == 1 ? Theme.ok : root.kind == 2 ? Theme.warn : root.kind == 3 ? Theme.bad : root.kind == 4 ? Theme.on-pop : root.kind == 5 ? Theme.live : Theme.muted;
            font-family: root.kind == 4 ? Theme.mono : Theme.display;
            font-size: 11px;
            font-weight: root.kind == 4 ? 500 : 700;
            vertical-alignment: center;
        }
    }
}

// A live stream from its start to now: hatched before you joined, yellow where it's
// recorded (striped while catching up), a red tick where something was missed, and a
// pulsing red edge at "now". Fractions 0..1 of its width.
export component LiveTape inherits Rectangle {
    in property <float> joined;
    in property <float> done;
    in property <[float]> holes;
    in property <bool> catching-up;
    // The part before, fetched next to it: in up to `early` (fainter while it comes).
    in property <float> early;
    in property <bool> early-in;
    // The compact row's thinner tape.
    in property <bool> slim;
    accessible-role: progress-indicator;
    accessible-label: root.catching-up ? "Catching up with the live stream" : "Recording";
    accessible-value: Math.round(root.done * 100) + "%";
    height: root.slim ? 6px : 10px;
    border-radius: 3px;
    background: Theme.line;
    // Before you joined: thin stripes.
    Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.joined));
        height: parent.height;
        clip: true;
        border-radius: 3px;
        for i in Math.ceil(self.width / 6px): Rectangle {
            x: i * 6px;
            width: 2px;
            height: parent.height;
            background: Theme.line-strong;
        }
    }
    // The part before, as it comes in (over the stripes).
    if root.early > 0: Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.early));
        height: parent.height;
        border-radius: 3px;
        background: root.early-in ? Theme.pop : Theme.pop.with-alpha(0.45);
    }
    // Recorded.
    Rectangle {
        x: parent.width * max(0, min(1, root.joined));
        width: parent.width * max(0, min(1, root.done) - max(0, min(1, root.joined)));
        height: parent.height;
        background: Theme.pop;
        clip: true;
        if root.catching-up: Rectangle {
            width: parent.width;
            height: parent.height;
            for i in Math.ceil(parent.width / 8px): Rectangle {
                x: i * 8px + 6px;
                width: 2px;
                height: parent.height;
                background: Theme.on-pop.with-alpha(0.22);
            }
        }
    }
    for h in root.holes: Rectangle {
        x: parent.width * max(0, min(1, h)) - 2px;
        y: -3px;
        width: 4px;
        height: parent.height + 6px;
        border-radius: 2px;
        background: Theme.bad;
    }
    // "Now": the live edge, pulsing.
    Rectangle {
        x: parent.width - 3px;
        y: -4px;
        width: 3px;
        height: parent.height + 8px;
        border-radius: 2px;
        background: Theme.live;
        opacity: 0.55 + 0.45 * Math.sin(animation-tick() / 260ms * 1rad);
    }
}

// The big link box. Buttons placed inside it go on the right.
export component LinkField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    public function focus-input() { input.focus(); }
    callback edited(string);
    callback accepted();
    // Ctrl+Shift+V in the box: "Paste & download" instead of a plain paste.
    callback paste-download();
    height: 54px;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 2px;
    border-color: input.has-focus ? Theme.ink : ta.has-hover ? Theme.muted : Theme.line-strong;
    animate border-color { duration: 100ms; }
    // keyboard: Tab reaches the text input itself.
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 6px;
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.muted;
                font-family: Theme.body;
                font-size: 15px;
                vertical-alignment: center;
                overflow: elide;
            }
            FocusScope {
                x: 0;
                width: parent.width;
                height: parent.height;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                capture-key-pressed(event) => {
                    if event.modifiers.control && event.modifiers.shift && (event.text == "v" || event.text == "V") {
                        root.paste-download();
                        return accept;
                    }
                    reject
                }
                input := TextInput {
                    x: 0;
                    width: parent.width;
                    height: parent.height;
                    text <=> root.text;
                    color: Theme.ink;
                    font-family: Theme.body;
                    font-size: 15px;
                    vertical-alignment: center;
                    single-line: true;
                    accessible-placeholder-text: root.placeholder;
                    selection-background-color: Theme.pop.with-alpha(0.45);
                    selection-foreground-color: Theme.ink;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(); }
                }
            }
        }
        @children
    }
}

// Quiet secondary action (queue header): muted text, ink on hover.
// A queue filter: a word and its count, underlined when picked. Calm (it's a view of the
// list, not an action); `attention` tints the count when there's something to look at.
export component FilterTab inherits Rectangle {
    in property <string> text;
    in property <int> count;
    in property <bool> active;
    in property <bool> attention;
    // Tabs that aren't a filter (Capture page: This PC / Phone) have no count.
    in property <bool> show-count: true;
    callback clicked();
    min-width: row.preferred-width;
    height: 32px;
    accessible-role: tab;
    accessible-label: root.show-count ? root.text + ", " + root.count : root.text;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 6px;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Text {
            text: root.text;
            color: root.active || ta.has-hover ? Theme.ink : Theme.muted;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }
        if root.show-count: Text {
            text: root.count;
            color: root.attention && root.count > 0 ? Theme.warn : Theme.muted;
            font-family: Theme.mono;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        border-radius: 1px;
        background: root.active ? Theme.ink : transparent;
    }
}

export component TextLink inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked();
    min-width: row.preferred-width;
    height: 30px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 6px;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            text: root.icon;
            font-size: 12px;
            color: ta.has-hover ? Theme.ink : Theme.muted;
        }
        Text {
            text: root.text;
            color: ta.has-hover ? Theme.ink : Theme.muted;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// Keyboard shortcut hint: "Ctrl V".
export component Kbd inherits Rectangle {
    in property <string> text;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.line-strong;
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.line-strong;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 3px;
        Text {
            text: root.text;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// A tickbox you press: 2px outline, ink fill with a check when on. The label is part of
// the target.
export component Tick inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    // One line, cut with "…" when too long (song names in a list).
    in property <bool> elide;
    callback toggled(bool);
    min-height: 28px;
    min-width: root.elide ? 60px : row.preferred-width;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
    KeyPress {
        radius: 8px;
        activated => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    row := HorizontalLayout {
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                border-width: 2px;
                border-color: root.checked ? Theme.ink : ta.has-hover ? Theme.muted : Theme.edge;
                background: root.checked ? Theme.ink : transparent;
                animate background, border-color { duration: 90ms; }
                if root.checked: Icon {
                    text: "\u{E73E}";
                    font-size: 11px;
                    color: Theme.bg;
                }
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
            wrap: root.elide ? no-wrap : word-wrap;
            overflow: root.elide ? TextOverflow.elide : TextOverflow.clip;
            horizontal-stretch: 1;
        }
    }
}

// The floating card for dialogs: scrim, `panel`, 1px `line-strong`, 12px radius, a title
// with an optional line under it, and a close button. Put it over the whole window.
// `fit` sizes the card to its content instead of `card-height`.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> card-width: 560px;
    in property <length> card-height: 520px;
    in property <bool> fit;
    // Clicking outside or the × closes it. Off for dialogs that need an answer.
    in property <bool> closable: true;
    callback close();
    background: Theme.scrim;
    // keyboard: Esc closes it (when it can be closed).
    TouchArea {
        clicked => {
            if root.closable {
                root.close();
            }
        }
    }
    // Compact windows: the card goes nearly edge to edge.
    property <length> margin: Screen.compact ? 24px : 48px;
    // Esc closes it (from anywhere inside, the search box included). It takes the
    // keyboard when it opens, so Tab starts inside the dialog.
    init => { keys.focus(); }
    keys := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape && root.closable {
                root.close();
                return accept;
            }
            reject
        }
        accessible-role: groupbox;
        accessible-label: root.title;
        Rectangle {
            width: min(root.card-width, root.width - root.margin);
            height: root.fit ? min(body.preferred-height, root.height - root.margin) : min(root.card-height, root.height - root.margin);
            border-radius: 12px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line-strong;
            clip: true;
            TouchArea { }
            body := VerticalLayout {
                padding: Screen.compact ? 18px : 24px;
                padding-top: Screen.compact ? 18px : 22px;
                spacing: Screen.compact ? 14px : 16px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text {
                            text: root.title;
                            color: Theme.ink;
                            font-family: Theme.display;
                            font-size: 20px;
                            font-weight: 700;
                            letter-spacing: -0.4px;
                            wrap: word-wrap;
                        }
                        if root.subtitle != "": Text {
                            text: root.subtitle;
                            color: Theme.muted;
                            font-family: Theme.body;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                    if root.closable: VerticalLayout {
                        alignment: start;
                        IconButton {
                            icon: "\u{E711}";
                            label: "Close";
                            clicked => { root.close(); }
                        }
                    }
                }
                @children
            }
        }
    }
}

// A big pressable option in a dialog ("Clip it" / "Compress it"): outlined like any
// control, icon, short title and one muted line.
export component ChoiceTile inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    callback clicked();
    min-height: col.preferred-height;
    border-radius: 12px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.text;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 12px;
        activated => { root.clicked(); }
    }
    border-width: 2px;
    border-color: ta.has-hover ? Theme.ink : Theme.line-strong;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    animate background, border-color { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    col := VerticalLayout {
        padding: 16px;
        spacing: 6px;
        Icon {
            text: root.icon;
            font-size: 20px;
            horizontal-alignment: left;
        }
        Text {
            text: root.title;
            color: Theme.ink;
            font-family: Theme.display;
            font-size: 16px;
            font-weight: 700;
        }
        Text {
            text: root.text;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// A row of chips where one is picked (quality, clip mode, compress goal…). Wraps onto
// more lines when the window is too narrow for one. It takes the row's free width (chips
// stay left) so it only wraps when it has to, and never grows taller than its lines.
export component ChoiceChips inherits FlexboxLayout {
    in property <[string]> options;
    in-out property <int> current;
    callback changed();
    horizontal-stretch: 1;
    vertical-stretch: 0;
    spacing: Screen.compact ? 7px : 8px;
    accessible-role: radio-group;
    for option[i] in root.options: Chip {
        horizontal-stretch: 0;
        text: option;
        selected: root.current == i;
        clicked => {
            root.current = i;
            root.changed();
        }
    }
}

// The ⋯ button's pop-up (queue rows on compact windows): a floating card of calm rows.
// Put the `MenuItem`s inside; the `PopupWindow` around it closes on any click.
export component Menu inherits Rectangle {
    width: 200px;
    height: col.preferred-height;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line-strong;
    col := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        @children
    }
}

export component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    // Its keyboard shortcut, said quietly on the right ("Ctrl+Shift+V").
    in property <string> shortcut;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 8px;
        activated => { root.clicked(); }
    }
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        Icon {
            width: 16px;
            text: root.icon;
            font-size: 13px;
            color: ta.has-hover ? Theme.ink : Theme.muted;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.shortcut != "": Text {
            horizontal-stretch: 0;
            text: root.shortcut;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// 1px hairline between sections. `inset-right` stops it short of a list's scrollbar lane.
export component Divider inherits Rectangle {
    in property <length> inset-right;
    height: 1px;
    Rectangle {
        x: 0;
        width: parent.width - root.inset-right;
        background: Theme.line;
    }
}

// A calm list row with a hairline at the bottom. The hairline stops short of the
// ListView's scrollbar lane (`lane`; 0 outside a ListView).
export component ListRow inherits Rectangle {
    in property <length> lane: Theme.lane;
    @children
    Rectangle {
        x: 0;
        y: root.height - 1px;
        width: root.width - root.lane;
        height: 1px;
        background: Theme.line;
    }
}

// Rounded picture box: thumbnails, covers, file previews. Children sit on top (status icons).
export component Thumb inherits Rectangle {
    in property <image> source;
    border-radius: 6px;
    background: Theme.raised;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
    @children
}

// A round "play" mark over a thumbnail: watch the link before downloading it.
export component PlayMark inherits Rectangle {
    in property <string> label: "Watch it";
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 2px;
    border-color: Theme.hard;
    background: ta.pressed ? Theme.pop-hover : Theme.pop;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 20px;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        x: (parent.width - self.width) / 2 + 1px;
        text: "\u{E768}";
        font-size: 15px;
        color: Theme.on-pop;
    }
}

// One line of status next to an icon: "That's not a link yet", "Already downloaded",
// warnings. Children (a link, a button) follow the text.
export component Notice inherits HorizontalLayout {
    in property <string> icon: "\u{E7BA}";
    in property <string> text;
    in property <color> color: Theme.warn;
    in property <color> icon-color: root.color;
    in property <length> icon-size: 13px;
    in property <length> font-size: 12px;
    in property <bool> wrap;
    // false: the text takes only its own width (children then end with a spacer).
    in property <bool> fill: true;
    // Cut long text with "…" instead of wrapping.
    in property <bool> elide;
    spacing: 8px;
    Icon {
        horizontal-stretch: 0;
        text: root.icon;
        font-size: root.icon-size;
        color: root.icon-color;
    }
    Text {
        horizontal-stretch: root.fill ? 1 : 0;
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        wrap: root.wrap ? word-wrap : no-wrap;
        overflow: root.elide ? TextOverflow.elide : TextOverflow.clip;
        vertical-alignment: center;
    }
    @children
}

// text, up to `widest`; the window centres it.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <length> widest;
    width: min(row.preferred-width, root.widest);
    height: 46px;
    border-radius: 12px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line-strong;
    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 20px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                background: Theme.ok-bg;
                Icon {
                    text: "\u{E73E}";
                    font-size: 11px;
                    color: Theme.ok;
                }
            }
        }
        Text {
            text: root.text;
            color: Theme.ink;
            font-family: Theme.body;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A handle to drag a row up or down a list (≡). With the keyboard: Tab to it, ↑ / ↓ move
// the row one place, Ctrl+↑ / Ctrl+↓ to the top / bottom (`jump`). `dragging` reports how
// far the pointer is from where it was pressed.
// The crop frame over a picture (Clip page → Picture): the part kept is clear, the rest
// shaded. Drag inside to move it, drag a corner to size it. `ratio` (width / height, in
// pixels) keeps the shape; 0 = any shape. Keyboard: arrows move it, Shift+arrows size it.
// cx/cy/cw/ch are fractions 0..1 of the picture.
export component CropFrame inherits Rectangle {
    in-out property <float> cx;
    in-out property <float> cy;
    in-out property <float> cw: 1;
    in-out property <float> ch: 1;
    in property <float> ratio;
    // A drag or key ended: the frame is where the user left it.
    callback moved();
    property <length> fx: root.cx * root.width;
    property <length> fy: root.cy * root.height;
    property <length> fw: root.cw * root.width;
    property <length> fh: root.ch * root.height;
    // 0 moving, 1 top-left corner, 2 bottom-right corner, -1 nothing
    property <int> grab: -1;
    property <float> sx;
    property <float> sy;
    property <float> sw;
    property <float> sh;
    property <float> pic: root.width / max(1px, root.height);

    // Size from one corner, the other corner staying put; keeps `ratio` when set.
    function resize(nw: float, nh: float, from-tl: bool) {
        let right = root.sx + root.sw;
        let bottom = root.sy + root.sh;
        let room-w = from-tl ? right : 1 - root.sx;
        let room-h = from-tl ? bottom : 1 - root.sy;
        let w0 = max(0.05, min(room-w, nw));
        let h0 = root.ratio > 0 ? w0 * root.pic / root.ratio : max(0.05, min(room-h, nh));
        let h = min(room-h, h0);
        let w = root.ratio > 0 ? h * root.ratio / root.pic : w0;
        root.cw = w;
        root.ch = h;
        root.cx = from-tl ? right - w : root.sx;
        root.cy = from-tl ? bottom - h : root.sy;
    }
    function start() {
        root.sx = root.cx;
        root.sy = root.cy;
        root.sw = root.cw;
        root.sh = root.ch;
    }

    // Shade outside the frame.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.fy;
        background: Theme.video-veil;
    }
    Rectangle {
        x: 0;
        y: root.fy + root.fh;
        width: root.width;
        height: max(0px, root.height - root.fy - root.fh);
        background: Theme.video-veil;
    }
    Rectangle {
        x: 0;
        y: root.fy;
        width: root.fx;
        height: root.fh;
        background: Theme.video-veil;
    }
    Rectangle {
        x: root.fx + root.fw;
        y: root.fy;
        width: max(0px, root.width - root.fx - root.fw);
        height: root.fh;
        background: Theme.video-veil;
    }
    // The frame, thirds lines and two corner grips.
    Rectangle {
        x: root.fx;
        y: root.fy;
        width: root.fw;
        height: root.fh;
        border-width: 2px;
        border-color: keys.has-focus ? Theme.focus : Theme.accent-hi;
        Rectangle { x: parent.width / 3; width: 1px; height: parent.height; background: Theme.accent-hi.with-alpha(0.35); }
        Rectangle { x: parent.width * 2 / 3; width: 1px; height: parent.height; background: Theme.accent-hi.with-alpha(0.35); }
        Rectangle { y: parent.height / 3; width: parent.width; height: 1px; background: Theme.accent-hi.with-alpha(0.35); }
        Rectangle { y: parent.height * 2 / 3; width: parent.width; height: 1px; background: Theme.accent-hi.with-alpha(0.35); }
    }
    Rectangle {
        x: root.fx - 6px;
        y: root.fy - 6px;
        width: 14px;
        height: 14px;
        border-radius: 4px;
        background: Theme.accent-hi;
    }
    Rectangle {
        x: root.fx + root.fw - 8px;
        y: root.fy + root.fh - 8px;
        width: 14px;
        height: 14px;
        border-radius: 4px;
        background: Theme.accent-hi;
    }

    keys := FocusScope {
        accessible-role: groupbox;
        accessible-label: "Crop frame: arrows move it, Shift and arrows change its size";
        key-pressed(event) => {
            let step = 0.01;
            root.start();
            if event.modifiers.shift && (event.text == Key.RightArrow || event.text == Key.LeftArrow
                    || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                let grow = event.text == Key.RightArrow || event.text == Key.DownArrow ? step : -step;
                root.resize(root.cw + grow, root.ch + grow, false);
                root.moved();
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.cx = max(0, min(1 - root.cw, root.cx + (event.text == Key.RightArrow ? step : -step)));
                root.moved();
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.cy = max(0, min(1 - root.ch, root.cy + (event.text == Key.DownArrow ? step : -step)));
                root.moved();
                return accept;
            }
            reject
        }
    }
    TouchArea {
        mouse-cursor: root.grab == 0 ? MouseCursor.grabbing : MouseCursor.crosshair;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                keys.focus();
                root.start();
                let px = self.mouse-x;
                let py = self.mouse-y;
                root.grab = abs(px - root.fx - root.fw) < 18px && abs(py - root.fy - root.fh) < 18px ? 2
                    : abs(px - root.fx) < 18px && abs(py - root.fy) < 18px ? 1
                    : px > root.fx && px < root.fx + root.fw && py > root.fy && py < root.fy + root.fh ? 0
                    : -1;
            }
            if e.kind == PointerEventKind.up && root.grab >= 0 {
                root.grab = -1;
                root.moved();
            }
        }
        moved => {
            if self.pressed && root.grab >= 0 {
                let dx = (self.mouse-x - self.pressed-x) / max(1px, root.width);
                let dy = (self.mouse-y - self.pressed-y) / max(1px, root.height);
                if root.grab == 0 {
                    root.cx = max(0, min(1 - root.cw, root.sx + dx));
                    root.cy = max(0, min(1 - root.ch, root.sy + dy));
                } else if root.grab == 2 {
                    root.resize(root.sw + dx, root.sh + dy, false);
                } else {
                    root.resize(root.sw - dx, root.sh - dy, true);
                }
            }
        }
    }
}

export component DragHandle inherits Rectangle {
    in property <string> label: "Move";
    // Take the keyboard when this turns true (or the handle is created with it true): a list
    // that rebuilds its rows after a move gives the focus back to the moved row's handle.
    in property <bool> want-focus;
    callback step(int);
    callback jump(int);
    init => {
        if root.want-focus {
            fs.focus();
        }
    }
    changed want-focus => {
        if root.want-focus {
            fs.focus();
        }
    }
    callback dragging(length);
    callback dropped();
    width: 24px;
    height: 30px;
    border-radius: 6px;
    background: ta.pressed ? Theme.line : ta.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.label + " (up and down arrows, Ctrl to go to the top or bottom)";
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.modifiers.control && event.text == Key.UpArrow {
                root.jump(-1);
                return accept;
            }
            if event.modifiers.control && event.text == Key.DownArrow {
                root.jump(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.step(-1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.step(1);
                return accept;
            }
            reject
        }
    }
    if fs.has-focus: Rectangle {
        x: -4px;
        y: -4px;
        width: root.width + 8px;
        height: root.height + 8px;
        border-radius: 10px;
        border-width: 2px;
        border-color: Theme.focus;
    }
    ta := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        moved => {
            if self.pressed {
                root.dragging(self.mouse-y - self.pressed-y);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up {
                root.dropped();
            }
        }
    }
    Icon {
        text: "\u{E700}";
        font-size: 13px;
        color: ta.has-hover || ta.pressed ? Theme.ink : Theme.dim;
    }
}

// One choice in a list of choices you compare before picking (Compress goals): a round
// mark, the name, a muted hint and a value on the right (under the name on compact
// windows). Calm like a list row, the mark and the hover say it's pressable; the picked row
// gets an ink mark. Rows sit on hairlines.
export component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> value;
    in property <bool> selected;
    // The hint is a problem (too long, already fits): warn colour.
    in property <bool> warn;
    // The hint under the title at every width (it must be read whole, not cut short).
    in property <bool> stacked;
    property <bool> below: Screen.compact || root.stacked;
    callback clicked();
    min-height: col.preferred-height;
    accessible-role: radio-button;
    accessible-label: root.title;
    accessible-description: root.hint + " " + root.value;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 8px;
        activated => { root.clicked(); }
    }
    background: ta.has-hover ? Theme.raised : transparent;
    border-radius: 8px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 0;
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: Theme.line;
    }
    col := HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: root.selected ? 6px : 2px;
                border-color: root.selected ? Theme.ink : ta.has-hover ? Theme.muted : Theme.edge;
                animate border-width, border-color { duration: 90ms; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    color: Theme.ink;
                    font-family: Theme.body;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                if !root.below && root.hint != "": Text {
                    text: root.hint;
                    color: root.warn ? Theme.warn : Theme.muted;
                    font-family: Theme.body;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            if root.below && (root.hint != "" || root.value != ""): Text {
                // A warning says it all ("already under 20 MB"): no value after it.
                text: root.hint == "" ? root.value : root.value == "" || root.warn ? root.hint : root.hint + " · " + root.value;
                color: root.warn ? Theme.warn : Theme.muted;
                font-family: Theme.mono;
                font-size: 11.5px;
                wrap: word-wrap;
            }
        }
        // Stacked rows say their value under the name already.
        if !root.below && root.value != "": Text {
            horizontal-stretch: 0;
            text: root.value;
            color: root.selected ? Theme.ink : Theme.muted;
            font-family: Theme.mono;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// The same moment before and after: the after picture over the before one, cut at a line
// you drag (or move with ← →). Calm (a picture you read); the grip on the line is the
// pressable part. Both pictures fill the box the same way, so they line up.
export component CompareSlider inherits Rectangle {
    in property <image> before;
    in property <image> after;
    in property <string> before-label: "Now";
    in property <string> after-label: "After";
    // Covered while the pictures are being made ("Working it out…").
    in property <string> busy-text;
    in-out property <float> split: 0.5;
    border-radius: 10px;
    background: Theme.video;
    clip: true;
    accessible-role: slider;
    accessible-label: "Before and after (left and right arrows)";
    accessible-value: Math.round(root.split * 100) + "%";
    Image {
        width: parent.width;
        height: parent.height;
        source: root.before;
        image-fit: contain;
    }
    Rectangle {
        x: root.width * root.split;
        width: root.width * (1 - root.split);
        height: root.height;
        clip: true;
        Image {
            x: -parent.x;
            width: root.width;
            height: root.height;
            source: root.after;
            image-fit: contain;
        }
    }
    if root.busy-text != "": Rectangle {
        background: Theme.video-veil;
        Text {
            text: root.busy-text;
            color: Theme.strip-mark;
            font-family: Theme.body;
            font-size: 13px;
        }
    }
    Rectangle {
        x: 8px;
        y: 8px;
        width: bl.preferred-width + 14px;
        height: 20px;
        border-radius: 6px;
        background: Theme.video-veil;
        bl := Text {
            text: root.before-label;
            color: Theme.strip-mark;
            font-family: Theme.display;
            font-size: 11px;
            font-weight: 700;
        }
    }
    Rectangle {
        x: root.width - self.width - 8px;
        y: 8px;
        width: al.preferred-width + 14px;
        height: 20px;
        border-radius: 6px;
        background: Theme.video-veil;
        al := Text {
            text: root.after-label;
            color: Theme.strip-mark;
            font-family: Theme.display;
            font-size: 11px;
            font-weight: 700;
        }
    }
    // The line and its grip (not while the pictures are being made).
    if root.busy-text == "": Rectangle {
        x: root.width * root.split - 1px;
        width: 2px;
        height: root.height;
        background: Theme.strip-mark;
    }
    if root.busy-text == "": Rectangle {
        x: root.width * root.split - 14px;
        y: root.height / 2 - 12px;
        width: 28px;
        height: 24px;
        border-radius: 8px;
        background: Theme.strip-mark;
        Icon {
            text: "\u{E8AB}";
            font-size: 12px;
            color: Theme.video;
        }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.split = max(0, root.split - 0.05);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.split = min(1, root.split + 0.05);
                return accept;
            }
            reject
        }
    }
    // The focus ring sits on the pictures: a video mark, so it shows in both themes.
    if fs.has-focus: Rectangle {
        border-radius: 10px;
        border-width: 2px;
        border-color: Theme.strip-mark;
    }
    TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.split = max(0, min(1, self.mouse-x / root.width));
            }
        }
        moved => {
            if self.pressed {
                root.split = max(0, min(1, self.mouse-x / root.width));
            }
        }
    }
}

// Compact windows: Settings, at the right end of every page's header (the tab bar holds the
// five pages). Put it last in the header row, behind `if Screen.compact`.
export component SettingsGear inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 0;
    GhostButton {
        compact: true;
        icon: "\u{E713}";
        label: "Settings";
        clicked => { Nav.settings-open = true; }
    }
}
