// Studio + Play design tokens (docs/DESIGN.md). Dark and light share every
// rule; only these values change. Rust sets `dark` from Settings → Appearance
// (System follows Windows' app theme).

import "fonts/space-grotesk-latin-500-normal.ttf";
import "fonts/space-grotesk-latin-700-normal.ttf";
import "fonts/inter-tight-latin-400-normal.ttf";
import "fonts/inter-tight-latin-500-normal.ttf";
import "fonts/inter-tight-latin-600-normal.ttf";
import "fonts/jetbrains-mono-latin-400-normal.ttf";
import "fonts/jetbrains-mono-latin-500-normal.ttf";

export global Theme {
    in-out property <bool> dark: true;

    // Faces
    out property <string> display: "Space Grotesk"; // headlines, buttons, tags
    out property <string> body: "Inter Tight";
    out property <string> mono: "JetBrains Mono"; // sizes, speeds, timecodes
    out property <string> icons: "Segoe Fluent Icons";

    // Surfaces and lines
    out property <color> bg: dark ? #141416 : #f4f0e6;
    out property <color> panel: dark ? #1b1b1e : #fffdf8;
    out property <color> raised: dark ? #222226 : #ebe5d7; // hover, wells
    out property <color> line: dark ? #26262a : #e2dccd;
    out property <color> line-strong: dark ? #34343a : #cfc7b4;
    // An outline that is the only sign of a control (an empty tick box): 3:1+.
    out property <color> edge: dark ? #6d6c6e : #888376;
    out property <color> scrim: dark ? #000000b8 : #2a241860;
    // Keyboard focus ring.
    out property <color> focus: dark ? #f1efe9 : #151412;

    // Text
    out property <color> ink: dark ? #f1efe9 : #151412;
    // Contrast (WCAG): ink and muted are 4.5:1+ on bg, panel and raised in both themes, so
    // any text can use them. dim is 3:1+: icons, inactive nav, disabled labels only.
    out property <color> muted: dark ? #8e8c88 : #6b665c;
    out property <color> dim: dark ? #6e6c68 : #878276;

    // The playful bits
    out property <color> pop: #ffd23f;
    out property <color> pop-hover: #ffdc66;
    out property <color> on-pop: #1a1405;
    // Deep ochre in dark (same family as the yellow), ink in light.
    out property <color> pop-shadow: dark ? #9a6f00 : #151412;
    out property <color> hard: dark ? #000000 : #151412;
    // Yellow can't be read on cream, so accent *text* gets its own colour.
    out property <color> pop-text: dark ? #ffd23f : #846101;

    // Room kept free on the right of scrolling lists and panes: the 14px scrollbar plus a
    // 10px gap, so it never sits on a row's buttons.
    out property <length> lane: 24px;

    // The video area and marks drawn over video frames (filmstrip): the same in both themes.
    out property <color> video: #000000;
    out property <color> video-veil: #000000b0;
    // Under a QR code, in both themes (phone cameras want dark modules on white).
    out property <color> qr-paper: #ffffff;
    out property <color> strip-shade: #0b0d12c8;
    out property <color> strip-mark: #ffffffd0;
    out property <color> strip-mark-soft: #ffffffc0;

    // Status (text / tinted background)
    out property <color> ok: dark ? #7fd6a4 : #1c7649;
    out property <color> ok-bg: dark ? #173326 : #d5f2e0;
    out property <color> warn: dark ? #f5b14a : #975900;
    out property <color> warn-bg: dark ? #3a2a12 : #fbe7c4;
    out property <color> bad: dark ? #ff7b72 : #ba352c;
    out property <color> bad-bg: dark ? #3a1a1a : #fde0dc;
    // Recording a live stream right now (the REC tag, the tape's live edge). Its own red,
    // so "recording" never reads as "failed".
    out property <color> live: dark ? #ff6b6f : #b8242e;
    out property <color> live-bg: dark ? #3d1719 : #fde0e1;

    // Older names, kept so every screen picks up the new palette.
    out property <color> sidebar: bg;
    out property <color> surface: panel;
    out property <color> surface-hi: raised;
    out property <color> border: line;
    out property <color> text: ink;
    out property <color> accent: pop;
    out property <color> accent-hi: pop-text;
    out property <color> success: ok;
    out property <color> danger: bad;
}

// Layout breakpoints, from the window width (AppWindow keeps `width` current).
// Wide (1000+): everything side by side. Medium (720–999): quality chips get their own
// row, row actions shrink to icons. Compact (under 720, down to the 400px minimum): bottom
// tabs, pages stack, one action per queue row plus a ⋯ menu. Compact is also the shape
// the Android layouts start from.
export global Screen {
    in-out property <length> width: 1040px;
    out property <length> wide-from: 1000px;
    out property <length> medium-from: 720px;
    out property <bool> wide: root.width >= root.wide-from;
    out property <bool> compact: root.width < root.medium-from;
    // Page padding: 24px, 16px on compact (the Space scale's `inset`).
    out property <length> pad: root.compact ? 16px : 24px;
}

// Spacing (docs/DESIGN.md → Spacing): one 4px scale, and the rule shadcn's form layout uses:
// tight inside a thing, loose between things, so what belongs together reads together.
// Every spacing and padding is one of 0, 2, 4, 6 or a multiple of 4 up to 48 (ui_rules checks);
// these names are for the common cases.
export global Space {
    // A setting and its own hint; a title and the line under it.
    out property <length> hint: 4px;
    // Side by side in one control or row: an icon and its label, buttons in a row.
    out property <length> inline: 8px;
    // A heading and what's under it.
    out property <length> title: 12px;
    // One setting, row or field and the next.
    out property <length> item: 16px;
    // The blocks of a dialog or card.
    out property <length> block: Screen.compact ? 12px : 16px;
    // One group of settings and the next.
    out property <length> group: Screen.compact ? 24px : 32px;
    // Inside a dialog, drawer or card, around its content.
    out property <length> inset: Screen.compact ? 16px : 24px;
}

// Moving between places from anywhere. On compact windows Settings isn't in the tab bar:
// each page's header ends with a gear (`SettingsGear`) that opens it.
export global Nav {
    in-out property <bool> settings-open;
    // Dev (`NERIA_SETTINGS_END`): Settings scrolled to its end once it's open, for shots.
    in-out property <bool> settings-end;
    // The command palette (Ctrl+K, the rail's search button, compact's magnifier).
    in-out property <bool> palette-open;
    // Keyboard: move focus as Tab (true) or Shift+Tab (false) would. Rust presses the key, as
    // .slint can't focus "the next one". Arrow keys in menus and groups, and a dialog's Tab
    // going round, use it.
    callback focus-step(bool);
    // The same, n times (negative: back). A group's arrows going round its ends, Home, End.
    callback focus-steps(int);
    // Steps still to go in that move: a group picks only the option the last one lands on.
    in-out property <int> steps-left;
    // On while an arrow key moves through a group of choices (tabs, chips, sections): its
    // other options take focus for that step, and the one reached is picked.
    in-out property <bool> arrowing;
    // The pointer is over a toast: its time stops until the pointer leaves.
    in-out property <bool> toast-hover;
    // The last thing done was a key, not the mouse (Rust, from the window's events). A
    // dialog or menu opened from the keyboard starts on its first control.
    in-out property <bool> keyboard;
    // Neria's window is in front (a toast's time stops while it isn't).
    in-out property <bool> window-active: true;
    // A Backdrop opens (before it takes the keyboard) / has taken it: Rust remembers what had
    // the keyboard, and gives it back when the layer is gone.
    callback layer-opening();
    callback layer-opened();
    // A letter typed in a menu: Rust moves to the next item whose label starts with what was
    // typed. False when it's not a letter or digit (the key goes on).
    callback typeahead(string) -> bool;
}
