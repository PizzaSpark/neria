// The window: nav rail, the three pages, the Settings drawer and every overlay. Rust
// talks only to AppWindow (properties and callbacks below) and the exported structs and
// globals; the screens themselves live in pages/, dialogs/ and components/.
import { Palette } from "std-widgets.slint";
import { Theme, Screen } from "theme.slint";
import { MatchItem, ToolRow, SyncItem, PickItem, JobItem, RecentItem, Fmt, Formats } from "types.slint";
import { Toast } from "widgets.slint";
import { Accounts, SiteItem, Extras, TrackRow } from "globals.slint";
import { TracksDialog } from "dialogs/tracks.slint";
import { Sidebar, TabBar } from "components/sidebar.slint";
import { DownloadPage } from "pages/download.slint";
import { ClipPage } from "pages/clip.slint";
import { CompressPage } from "pages/compress.slint";
import { SettingsDrawer } from "pages/settings.slint";
import { SetupScreen } from "pages/setup.slint";
import { MatchDialog } from "dialogs/match.slint";
import { SyncDialog } from "dialogs/sync.slint";
import { SpotifyHeadsUp } from "dialogs/spotify.slint";
import { DropOverlay, DropChoice } from "dialogs/drop.slint";

export { Theme, Screen, MatchItem, ToolRow, SyncItem, PickItem, JobItem, RecentItem, Fmt, Accounts, SiteItem, Extras, TrackRow }

export component AppWindow inherits Window {
    title: "Neria";
    // Title bar, taskbar and Alt-Tab. The exe's own icon is embedded by build.rs.
    icon: @image-url("../assets/neria-256.png");
    preferred-width: 1040px;
    preferred-height: 740px;
    // Smallest supported window: the compact layout (bottom tabs) at phone width.
    min-width: 400px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: Theme.body;
    // Keep the standard widgets (text fields, checkboxes…) in the same light/dark mode.
    property <bool> theme-dark: Theme.dark;
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
        Screen.width = self.width;
    }
    changed theme-dark => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    // Breakpoints (theme.slint `Screen`) follow the window width.
    property <length> window-width: self.width;
    changed window-width => { Screen.width = self.width; }

    // Setup
    in property <bool> tools-ready;
    in property <string> setup-label;
    in property <string> setup-error; // plain-language reason the last try failed
    in property <string> setup-detail; // technical version, for "Copy details"
    in property <bool> setup-copied;
    in property <string> setup-blocked-dir; // set when Neria can't write next to itself
    in property <int> setup-missing; // tools still to download
    in property <[ToolRow]> setup-tools;

    // Link + preview
    in-out property <string> url;
    in property <int> probe-state; // 0 none, 1 loading, 2 ok, 3 error, 4 text isn't a link
    // The error won't go away by trying again (deleted, private, unsupported site…):
    // shown in red and the Download button is greyed out. Otherwise errors are amber.
    in property <bool> probe-blocked;
    in property <string> probe-title;
    in property <string> probe-meta;
    in property <image> probe-thumb;
    in-out property <int> quality;

    // Spotify
    in property <bool> probe-is-spotify;
    // An X GIF that will be saved as a real .gif: no quality chips, just say so.
    in property <bool> probe-is-gif;
    property <bool> gif-mode: probe-is-gif && x-gifs-as-gif;
    // Posts and playlists: every item, ticked ones get downloaded.
    in property <[PickItem]> pick-items;
    in property <int> pick-checked;
    // Said about the items, e.g. a video Neria can't reach in this post.
    in property <string> pick-note;
    callback pick-toggle(int, bool);
    callback pick-all(bool);
    callback pick-quality(int, int);
    in property <int> spotify-count;
    in property <string> spotify-note;
    in property <[SyncItem]> sync-items;
    in-out property <bool> sync-open;
    in-out property <bool> lyrics: true;
    in-out property <bool> verify-audio: true;
    in-out property <string> spotify-client-id;
    in-out property <string> spotify-client-secret;
    // "Pick another match" dialog for a Spotify track
    in-out property <bool> match-open;
    in property <string> match-heading;
    in property <string> match-sub;
    in property <[MatchItem]> match-items;
    in property <bool> match-loading;
    in property <string> match-status;
    in-out property <string> match-query;
    callback match-pick(int);
    callback match-use(int);
    callback match-search();
    callback match-open-url(string);
    callback match-check(int);
    in property <bool> match-can-check;

    in property <int> sync-ticked;
    // First Download on a Spotify link: explain where the audio comes from.
    in-out property <bool> spotify-heads-up;
    in-out property <bool> spotify-heads-up-skip: true;
    in-out property <bool> spotify-explain: true; // Settings: show the heads-up
    callback spotify-heads-up-ok(bool);
    callback sync-toggle(int, bool);
    callback sync-delete-selected();
    callback sync-keep-all();

    // Queue
    in property <[JobItem]> jobs;
    in property <int> active-count;
    // Downloading or processing right now (waiting ones not counted): the "3 going" badge.
    in property <int> running-count;
    in property <int> paused-count;
    in property <int> finished-count;
    callback pause-job(int);
    callback resume-job(int);
    callback toggle-group(int);
    callback pause-all();
    callback resume-all();
    // Duplicate check on the preview: "" when this link is new.
    in property <string> dup-text;
    // ...and whether there's a file to show.
    in property <bool> dup-file;
    callback dup-show();
    // A video link that's also in a playlist: the playlist's own link ("" otherwise).
    in property <string> playlist-url;
    callback use-playlist();

    // Settings
    in-out property <string> output-dir;
    in-out property <int> container-index;
    in-out property <int> audio-format-index;
    in-out property <bool> prefer-h264;
    in-out property <bool> embed-thumbnail;
    in-out property <bool> save-thumbnail;
    in-out property <bool> sort-folders: true;
    in-out property <bool> number-items: true;
    in-out property <bool> embed-metadata;
    in-out property <bool> embed-subs;
    in-out property <bool> sponsorblock;
    in-out property <bool> allow-playlists;
    in-out property <bool> x-gifs-as-gif: true;
    in-out property <int> cookies-index;
    in-out property <string> rate-limit;
    in-out property <string> filename-template;
    in-out property <string> extra-args;
    in-out property <int> max-concurrent: 2;
    in property <string> ytdlp-version;
    in property <string> app-version;
    // One "name version" per line, filled in once the tools are ready.
    in property <string> tool-versions;
    // Short message at the bottom of the window ("Report copied…"); Rust clears it.
    in property <string> toast;

    // Updates. update-state: 0 idle, 1 checking, 2 downloading, 3 ready to restart, 4 failed
    in-out property <bool> check-updates: true;
    in-out property <int> theme-index; // 0 system, 1 dark, 2 light
    in property <int> update-state;
    in property <string> update-version; // "" = no newer Neria found
    in property <string> update-url;
    in property <string> update-notes;
    in property <string> update-status;
    in property <float> update-progress;
    in property <bool> update-banner;
    in property <string> tools-outdated; // tool labels, one per line
    in property <string> tools-status;
    in property <bool> tools-updating;

    in-out property <int> page;
    // Compact: Settings is a sheet over the page, so picking a tab closes it.
    changed page => {
        if Screen.compact {
            root.drawer-open = false;
        }
        if root.page != 0 {
            root.refresh-recent();
        }
    }
    // Recent downloads for the empty Clip and Compress pages (Rust fills them).
    in property <[RecentItem]> recent-clip;
    in property <[RecentItem]> recent-compress;
    callback refresh-recent();
    // First run: "How it works" on the empty queue until a download starts or it's hidden.
    in-out property <bool> show-tips;
    callback hide-tips();
    // Where downloads go, short: "Videos › Neria".
    in property <string> output-short;
    // A file dragged in from Explorer. drop-kind: 0 not media, 1 video, 2 audio.
    in property <bool> drop-hover;
    in property <string> drop-name;
    in property <int> drop-kind;
    in property <string> drop-file;
    in-out property <bool> drop-choice-open;
    callback drop-choose(int); // 1 clip, 2 compress
    in-out property <bool> drawer-open;
    // Settings section to show: 0 Download, 1 Spotify, 2 Network, 3 Appearance, 4 About.
    in-out property <int> settings-section;

    // Clipper
    in property <bool> clip-loaded;
    in property <bool> clip-has-video;
    in property <string> clip-name;
    in property <image> clip-frame;
    in property <float> clip-duration;
    in property <float> clip-position;
    in property <bool> clip-playing;
    in-out property <float> clip-in;
    in-out property <float> clip-out;
    in-out property <int> clip-mode;
    // Play the selection on repeat instead of stopping at Out.
    in-out property <bool> clip-loop;
    in property <[image]> clip-thumbs;
    in property <image> clip-wave;
    in property <bool> clip-exporting;
    in property <float> clip-export-progress;
    in-out property <string> clip-status;
    in property <bool> clip-has-output;
    in property <[float]> clip-keyframes;
    in property <[float]> clip-keyframe-ticks;
    // Link mode: streaming a URL; export downloads just the selection.
    in property <bool> clip-is-link;
    // The link is an X GIF (from the Download page's preview): saved as is, no quality to pick.
    in property <bool> clip-is-gif;
    in property <bool> clip-buffering;

    // A stale "Saved · …" message shouldn't hide what the new selection will do.
    changed clip-in => { if !root.clip-exporting { root.clip-status = ""; } }
    changed clip-out => { if !root.clip-exporting { root.clip-status = ""; } }
    changed clip-mode => { if !root.clip-exporting { root.clip-status = ""; } }

    callback clip-open();
    callback clip-toggle-play();
    callback clip-seek(float);
    callback clip-frame-step(int);
    callback clip-export();
    callback clip-cancel-export();
    callback clip-show-output();
    callback clip-job(int);
    callback clip-open-path(string);
    callback clip-open-link(string, string); // url, title
    callback clip-paste-link();

    // Compressor
    in property <bool> cmp-loaded;
    in property <string> cmp-name;
    in property <string> cmp-info;
    in property <image> cmp-thumb;
    in-out property <int> cmp-mode;
    in-out property <int> cmp-size-index;
    in-out property <string> cmp-custom-mb: "8";
    in-out property <float> cmp-quality: 0.6;
    in-out property <int> cmp-codec;
    in-out property <bool> cmp-use-gpu: true;
    in property <bool> cmp-gpu-available;
    in property <string> cmp-gpu-label: "Use GPU";
    in-out property <int> cmp-res-index: 1; // Original size by default
    in-out property <int> cmp-fps-index;
    in-out property <int> cmp-audio-index;
    in property <string> cmp-estimate;
    in property <bool> cmp-warning;
    in property <bool> cmp-can-start;
    in property <bool> cmp-running;
    in property <float> cmp-progress;
    in property <string> cmp-status;
    in property <bool> cmp-has-output;

    callback cmp-open();
    callback cmp-open-path(string);
    callback cmp-job(int);
    callback cmp-options-changed();
    callback cmp-start();
    callback cmp-cancel();
    callback cmp-show-output();


    // "mp4 · H.264" and "mp3": what the quality rows say you'll get.
    property <string> video-format: Formats.containers[root.container-index] + (root.prefer-h264 ? " · H.264" : "");
    property <string> audio-format: Formats.audio[root.audio-format-index];

    callback paste();
    callback url-edited(string);
    callback start-download();
    callback cancel-job(int);
    callback remove-job(int);
    callback retry-job(int);
    callback open-job(int);
    callback open-output();
    callback choose-output();
    callback settings-changed();
    callback clear-finished();
    callback retry-setup();
    callback setup-copy-details();
    callback setup-show-folder();
    callback report-job(int);
    // Flagged songs: open the file to listen; "It's right" drops the doubt.
    callback play-job(int);
    callback accept-job(int);
    // Queue filter: 0 all, 1 active, 2 done, 3 needs a look; counts in that order.
    in-out property <int> queue-filter;
    in property <[int]> filter-counts: [0, 0, 0, 0];
    callback queue-filter-changed(int);
    callback copy-report();
    callback update-check();
    callback update-install();
    callback update-restart();
    callback update-later();
    callback tools-update();
    callback theme-changed();

    // Rail on the left, or tabs along the bottom on compact windows. The pages stay put
    // when the window crosses the breakpoint, so nothing reloads.
    HorizontalLayout {
        if !Screen.compact: Sidebar {
            page <=> root.page;
            settings-open: root.drawer-open;
            open-settings => { root.drawer-open = true; }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            Rectangle {
                vertical-stretch: 1;

                if root.page == 0: DownloadPage {
                    window-width: root.width;
                    window-height: root.height;
                    tools-ready: root.tools-ready;

                    update-banner: root.update-banner;
                    update-state: root.update-state;
                    update-version: root.update-version;
                    update-status: root.update-status;
                    update-progress: root.update-progress;
                    update-install => { root.update-install(); }
                    update-restart => { root.update-restart(); }
                    update-later => { root.update-later(); }

                    url <=> root.url;
                    probe-state: root.probe-state;
                    probe-blocked: root.probe-blocked;
                    probe-title: root.probe-title;
                    probe-meta: root.probe-meta;
                    probe-thumb: root.probe-thumb;
                    probe-is-spotify: root.probe-is-spotify;
                    quality <=> root.quality;
                    gif-mode: root.gif-mode;
                    dup-text: root.dup-text;
                    dup-file: root.dup-file;
                    playlist-url: root.playlist-url;
                    paste => { root.paste(); }
                    url-edited(t) => { root.url-edited(t); }
                    start-download => { root.start-download(); }
                    dup-show => { root.dup-show(); }
                    use-playlist => { root.use-playlist(); }
                    clip-open-link(url, title) => { root.clip-open-link(url, title); }

                    video-format: root.video-format;
                    audio-format: root.audio-format;
                    lyrics: root.lyrics;
                    settings-changed => { root.settings-changed(); }
                    open-settings => {
                        root.settings-section = 0;
                        root.drawer-open = true;
                    }
                    whats-new => {
                        root.settings-section = 4;
                        root.drawer-open = true;
                    }

                    pick-items: root.pick-items;
                    pick-checked: root.pick-checked;
                    pick-note: root.pick-note;
                    number-items <=> root.number-items;
                    pick-toggle(i, on) => { root.pick-toggle(i, on); }
                    pick-all(on) => { root.pick-all(on); }
                    pick-quality(i, q) => { root.pick-quality(i, q); }

                    spotify-count: root.spotify-count;
                    spotify-note: root.spotify-note;
                    sync-items: root.sync-items;
                    review-removed => { root.sync-open = true; }

                    jobs: root.jobs;
                    active-count: root.active-count;
                    running-count: root.running-count;
                    paused-count: root.paused-count;
                    finished-count: root.finished-count;
                    pause-all => { root.pause-all(); }
                    resume-all => { root.resume-all(); }
                    clear-finished => { root.clear-finished(); }
                    open-output => { root.open-output(); }
                    cancel-job(id) => { root.cancel-job(id); }
                    remove-job(id) => { root.remove-job(id); }
                    retry-job(id) => { root.retry-job(id); }
                    open-job(id) => { root.open-job(id); }
                    clip-job(id) => { root.clip-job(id); }
                    cmp-job(id) => { root.cmp-job(id); }
                    match-pick(id) => { root.match-pick(id); }
                    report-job(id) => { root.report-job(id); }
                    play-job(id) => { root.play-job(id); }
                    accept-job(id) => { root.accept-job(id); }
                    filter <=> root.queue-filter;
                    filter-counts: root.filter-counts;
                    filter-changed(f) => { root.queue-filter-changed(f); }
                    show-tips: root.show-tips;
                    hide-tips => { root.hide-tips(); }
                    output-short: root.output-short;
                    pause-job(id) => { root.pause-job(id); }
                    resume-job(id) => { root.resume-job(id); }
                    toggle-group(id) => { root.toggle-group(id); }
                }

                if root.page == 1: ClipPage {
                    tools-ready: root.tools-ready;
                    loaded: root.clip-loaded;
                    has-video: root.clip-has-video;
                    name: root.clip-name;
                    frame: root.clip-frame;
                    duration: root.clip-duration;
                    position: root.clip-position;
                    playing: root.clip-playing;
                    in-time <=> root.clip-in;
                    out-time <=> root.clip-out;
                    mode <=> root.clip-mode;
                    loop <=> root.clip-loop;
                    thumbs: root.clip-thumbs;
                    wave: root.clip-wave;
                    exporting: root.clip-exporting;
                    export-progress: root.clip-export-progress;
                    status: root.clip-status;
                    has-output: root.clip-has-output;
                    keyframes: root.clip-keyframes;
                    keyframe-ticks: root.clip-keyframe-ticks;
                    is-link: root.clip-is-link;
                    gif: root.clip-is-gif && root.x-gifs-as-gif;
                    buffering: root.clip-buffering;
                    quality <=> root.quality;
                    video-format: root.video-format;
                    audio-format: root.audio-format;
                    open-file => { root.clip-open(); }
                recent: root.recent-clip;
                open-path(p) => { root.clip-open-path(p); }
                    paste-link => { root.clip-paste-link(); }
                    toggle-play => { root.clip-toggle-play(); }
                    seek(t) => { root.clip-seek(t); }
                    frame-step(n) => { root.clip-frame-step(n); }
                    export-clip => { root.clip-export(); }
                    cancel-export => { root.clip-cancel-export(); }
                    show-output => { root.clip-show-output(); }
                    view-queue => { root.page = 0; }
                    settings-changed => { root.settings-changed(); }
                    open-settings => {
                        root.settings-section = 0;
                        root.drawer-open = true;
                    }
                }

                if root.page == 2: CompressPage {
                    loaded: root.cmp-loaded;
                    name: root.cmp-name;
                    info: root.cmp-info;
                    thumb: root.cmp-thumb;
                    mode <=> root.cmp-mode;
                    size-index <=> root.cmp-size-index;
                    custom-mb <=> root.cmp-custom-mb;
                    quality <=> root.cmp-quality;
                    codec <=> root.cmp-codec;
                    use-gpu <=> root.cmp-use-gpu;
                    gpu-available: root.cmp-gpu-available;
                    gpu-label: root.cmp-gpu-label;
                    res-index <=> root.cmp-res-index;
                    fps-index <=> root.cmp-fps-index;
                    audio-index <=> root.cmp-audio-index;
                    estimate: root.cmp-estimate;
                    warning: root.cmp-warning;
                    can-start: root.cmp-can-start;
                    running: root.cmp-running;
                    progress: root.cmp-progress;
                    status: root.cmp-status;
                    has-output: root.cmp-has-output;
                    open-file => { root.cmp-open(); }
                recent: root.recent-compress;
                open-path(p) => { root.cmp-open-path(p); }
                    options-changed => { root.cmp-options-changed(); }
                    start-compress => { root.cmp-start(); }
                    cancel => { root.cmp-cancel(); }
                    show-output => { root.cmp-show-output(); }
                }
            }

            if Screen.compact: TabBar {
                page <=> root.page;
                settings-open: root.drawer-open;
                open-settings => { root.drawer-open = true; }
            }
        }
    }

    if root.drawer-open: SettingsDrawer {
        x: 0;
        y: 0;
        width: root.width;
        // Compact: a full sheet that leaves the tab bar showing.
        height: Screen.compact ? root.height - 66px : root.height;
        section <=> root.settings-section;
        output-dir: root.output-dir;
        sort-folders <=> root.sort-folders;
        number-items <=> root.number-items;
        container-index <=> root.container-index;
        prefer-h264 <=> root.prefer-h264;
        embed-subs <=> root.embed-subs;
        audio-format-index <=> root.audio-format-index;
        embed-thumbnail <=> root.embed-thumbnail;
        save-thumbnail <=> root.save-thumbnail;
        embed-metadata <=> root.embed-metadata;
        sponsorblock <=> root.sponsorblock;
        allow-playlists <=> root.allow-playlists;
        x-gifs-as-gif <=> root.x-gifs-as-gif;
        cookies-index <=> root.cookies-index;
        rate-limit <=> root.rate-limit;
        max-concurrent <=> root.max-concurrent;
        lyrics <=> root.lyrics;
        verify-audio <=> root.verify-audio;
        spotify-explain <=> root.spotify-explain;
        spotify-client-id <=> root.spotify-client-id;
        spotify-client-secret <=> root.spotify-client-secret;
        theme-index <=> root.theme-index;
        filename-template <=> root.filename-template;
        extra-args <=> root.extra-args;
        check-updates <=> root.check-updates;
        app-version: root.app-version;
        update-state: root.update-state;
        update-version: root.update-version;
        update-notes: root.update-notes;
        update-status: root.update-status;
        update-progress: root.update-progress;
        tool-versions: root.tool-versions;
        tools-outdated: root.tools-outdated;
        tools-status: root.tools-status;
        tools-updating: root.tools-updating;
        close => { root.drawer-open = false; }
        choose-output => { root.choose-output(); }
        open-output => { root.open-output(); }
        settings-changed => { root.settings-changed(); }
        theme-changed => { root.theme-changed(); }
        update-install => { root.update-install(); }
        update-restart => { root.update-restart(); }
        update-check => { root.update-check(); }
        tools-update => { root.tools-update(); }
        copy-report => { root.copy-report(); }
    }

    if root.toast != "": Toast {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (Screen.compact ? 66px + 14px : 26px);
        widest: root.width - (Screen.compact ? 32px : 80px);
        text: root.toast;
    }

    if root.match-open: MatchDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        heading: root.match-heading;
        sub: root.match-sub;
        items: root.match-items;
        loading: root.match-loading;
        status: root.match-status;
        can-check: root.match-can-check;
        query <=> root.match-query;
        close => { root.match-open = false; }
        search => { root.match-search(); }
        check(i) => { root.match-check(i); }
        open-url(url) => { root.match-open-url(url); }
        use(i) => { root.match-use(i); }
    }

    if Extras.open != 0: TracksDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    if root.sync-open: SyncDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        items: root.sync-items;
        ticked: root.sync-ticked;
        toggle(i, on) => { root.sync-toggle(i, on); }
        delete-selected => { root.sync-delete-selected(); }
        keep-all => { root.sync-keep-all(); }
    }

    if root.spotify-heads-up: SpotifyHeadsUp {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        skip <=> root.spotify-heads-up-skip;
        ok(skip) => { root.spotify-heads-up-ok(skip); }
        cancel => { root.spotify-heads-up = false; }
    }

    if root.drop-hover: DropOverlay {
        x: Screen.compact ? 0 : 80px;
        y: 0;
        width: root.width - self.x;
        height: root.height - (Screen.compact ? 66px : 0);
        kind: root.drop-kind;
        name: root.drop-name;
        page: root.page;
    }

    if root.drop-choice-open: DropChoice {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        name: root.drop-name;
        close => { root.drop-choice-open = false; }
        choose(kind) => { root.drop-choose(kind); }
    }

    if !root.tools-ready: SetupScreen {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        label: root.setup-label;
        error: root.setup-error;
        copied: root.setup-copied;
        blocked-dir: root.setup-blocked-dir;
        missing: root.setup-missing;
        tools: root.setup-tools;
        retry => { root.retry-setup(); }
        copy-details => { root.setup-copy-details(); }
        show-folder => { root.setup-show-folder(); }
    }
}
