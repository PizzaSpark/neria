import { LineEdit, CheckBox, ComboBox, SpinBox, ScrollView, ListView } from "std-widgets.slint";

export struct JobItem {
    id: int,
    title: string,
    // 0 queued, 1 downloading, 2 processing, 3 done, 4 failed, 5 cancelled
    state: int,
    progress: float,
    status: string,
    stats: string,
}

global Theme {
    out property <color> bg: #0e1014;
    out property <color> sidebar: #12151b;
    out property <color> surface: #171a21;
    out property <color> surface-hi: #20242e;
    out property <color> border: #272c37;
    out property <color> text: #e9ebf1;
    out property <color> muted: #8a91a3;
    out property <color> accent: #7c5cff;
    out property <color> accent-hi: #9a82ff;
    out property <color> success: #3ecf8e;
    out property <color> danger: #ff5c7a;
    out property <color> warn: #f5a524;
    out property <string> icons: "Segoe Fluent Icons";
}

// Formatting helpers implemented in Rust.
export global Fmt {
    pure callback time(float) -> string;
    // Latest keyframe at or before t: where a lossless cut really starts.
    pure callback keyframe-before(float, [float]) -> float;
}

component Icon inherits Text {
    font-family: Theme.icons;
    font-size: 16px;
    color: Theme.text;
    vertical-alignment: center;
    horizontal-alignment: center;
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    height: 44px;
    border-radius: 10px;
    background: !root.enabled ? Theme.surface-hi : ta.pressed ? #6a4ae6 : ta.has-hover ? Theme.accent-hi : Theme.accent;
    animate background { duration: 120ms; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            text: root.icon;
            color: root.enabled ? white : Theme.muted;
        }
        Text {
            text: root.text;
            color: root.enabled ? white : Theme.muted;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component GhostButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked();
    height: 44px;
    border-radius: 10px;
    background: ta.pressed ? Theme.border : ta.has-hover ? Theme.surface-hi : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    animate background { duration: 120ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            text: root.icon;
            font-size: 14px;
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.muted;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface-hi : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        text: root.icon;
        font-size: 13px;
        color: ta.has-hover ? Theme.text : root.tint;
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    border-radius: 17px;
    background: root.selected ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.surface-hi : transparent;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    animate background, border-color { duration: 120ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            color: root.selected ? Theme.accent-hi : Theme.text;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }
}

component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.accent;
    height: 6px;
    border-radius: 3px;
    background: Theme.surface-hi;
    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * max(0, min(1, root.value));
        border-radius: 3px;
        background: root.fill;
        animate width { duration: 180ms; }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 60px;
    border-radius: 12px;
    background: root.active ? Theme.accent.with-alpha(0.16) : ta.has-hover ? Theme.surface-hi : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 5px;
        Icon {
            text: root.icon;
            font-size: 18px;
            color: root.active ? Theme.accent-hi : Theme.muted;
        }
        Text {
            text: root.label;
            font-size: 11px;
            color: root.active ? Theme.text : Theme.muted;
            horizontal-alignment: center;
        }
    }
}

component JobRow inherits Rectangle {
    in property <JobItem> job;
    callback cancel();
    callback remove();
    callback retry();
    callback open();
    callback open-clipper();

    property <color> tone: root.job.state == 3 ? Theme.success : root.job.state == 4 ? Theme.danger : root.job.state == 5 ? Theme.muted : Theme.accent;
    property <string> glyph: root.job.state == 0 ? "\u{E823}" : root.job.state == 1 ? "\u{E896}" : root.job.state == 2 ? "\u{E9F5}" : root.job.state == 3 ? "\u{E73E}" : root.job.state == 4 ? "\u{E783}" : "\u{E711}";
    property <bool> active: root.job.state <= 2;

    height: 76px;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: root.tone.with-alpha(0.15);
                Icon {
                    text: root.glyph;
                    color: root.tone;
                    font-size: 15px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 7px;
            horizontal-stretch: 1;
            Text {
                text: root.job.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            if root.active: Bar {
                value: root.job.progress;
                fill: root.tone;
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.job.status;
                    color: root.job.state == 4 ? Theme.danger : Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.job.stats;
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-stretch: 0;
                }
            }
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 0;
            VerticalLayout {
                alignment: center;
                if root.active: IconButton {
                    icon: "\u{E711}";
                    clicked => { root.cancel(); }
                }
                if root.job.state == 3: IconButton {
                    icon: "\u{E838}";
                    clicked => { root.open(); }
                }
            }
            VerticalLayout {
                alignment: center;
                if root.job.state == 3: IconButton {
                    icon: "\u{E8C6}";
                    clicked => { root.open-clipper(); }
                }
                if root.job.state == 4 || root.job.state == 5: IconButton {
                    icon: "\u{E72C}";
                    clicked => { root.retry(); }
                }
            }
            VerticalLayout {
                alignment: center;
                if !root.active: IconButton {
                    icon: "\u{E894}";
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

// Filmstrip + waveform with draggable in/out handles and a playhead.
component Timeline inherits Rectangle {
    in property <float> duration;
    in property <float> position;
    in-out property <float> in-time;
    in-out property <float> out-time;
    in property <[image]> thumbs;
    in property <image> wave;
    in property <bool> has-video;
    // Lossless mode: keyframe ticks and where the cut will really start.
    in property <bool> show-keyframes;
    in property <[float]> keyframe-ticks;
    in property <float> effective-in;
    callback seek(float);

    property <float> dur: max(0.001, root.duration);
    property <length> eff-x: root.width * (root.effective-in / root.dur);
    property <bool> early-start: root.show-keyframes && root.effective-in < root.in-time - 0.05;
    property <length> handle-w: 14px;
    property <length> in-x: root.width * (root.in-time / root.dur);
    property <length> out-x: root.width * (root.out-time / root.dur);
    property <length> pos-x: root.width * (root.position / root.dur);
    property <length> strip-h: root.has-video ? 66px : 0px;

    height: root.has-video ? 100px : 64px;
    border-radius: 10px;
    background: Theme.surface-hi;
    clip: true;

    if root.has-video: HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.strip-h;
        for t in root.thumbs: Image {
            source: t;
            image-fit: cover;
            min-width: 0;
            horizontal-stretch: 1;
        }
    }
    Image {
        x: 0;
        y: root.strip-h;
        width: root.width;
        height: root.height - root.strip-h;
        source: root.wave;
        image-fit: fill;
    }

    // Dim everything outside the selection.
    Rectangle {
        x: 0;
        width: root.in-x;
        height: root.height;
        background: #0b0d12c8;
    }
    Rectangle {
        x: root.out-x;
        width: max(0px, root.width - root.out-x);
        height: root.height;
        background: #0b0d12c8;
    }
    Rectangle {
        x: root.in-x;
        width: max(0px, root.out-x - root.in-x);
        height: root.height;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 8px;
    }

    // Lossless cut starts earlier than the in point: show the extra footage.
    if root.early-start: Rectangle {
        x: root.eff-x;
        width: max(0px, root.in-x - root.eff-x);
        height: root.height;
        background: Theme.warn.with-alpha(0.28);
    }
    if root.early-start: Rectangle {
        x: root.eff-x - 1px;
        width: 2px;
        height: root.height;
        background: Theme.warn;
    }

    // Keyframe ticks along the bottom edge.
    if root.show-keyframes: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        for k in root.keyframe-ticks: Rectangle {
            x: root.width * (k / root.dur) - 1px;
            y: root.height - 12px;
            width: 2px;
            height: 12px;
            border-radius: 1px;
            background: #ffffffc0;
        }
    }

    // Click or drag anywhere to scrub.
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.seek(max(0, min(1, self.mouse-x / root.width)) * root.duration);
            }
        }
        moved => {
            if self.pressed {
                root.seek(max(0, min(1, self.mouse-x / root.width)) * root.duration);
            }
        }
    }

    // Playhead
    Rectangle {
        x: root.pos-x - 1px;
        width: 2px;
        height: root.height;
        background: white;
    }
    Rectangle {
        x: root.pos-x - 5px;
        y: 0;
        width: 10px;
        height: 6px;
        border-radius: 2px;
        background: white;
    }

    // In handle (sits just inside the selection)
    Rectangle {
        x: root.in-x;
        width: root.handle-w;
        height: root.height;
        border-radius: 6px;
        background: in-ta.pressed || in-ta.has-hover ? Theme.accent-hi : Theme.accent;
        Rectangle {
            width: 2px;
            height: 24px;
            border-radius: 1px;
            background: #ffffffd0;
        }
        in-ta := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed {
                    root.in-time = max(0, min(root.out-time - 0.1, root.in-time + (self.mouse-x - self.pressed-x) / root.width * root.duration));
                    root.seek(root.in-time);
                }
            }
        }
    }

    // Out handle
    Rectangle {
        x: root.out-x - root.handle-w;
        width: root.handle-w;
        height: root.height;
        border-radius: 6px;
        background: out-ta.pressed || out-ta.has-hover ? Theme.accent-hi : Theme.accent;
        Rectangle {
            width: 2px;
            height: 24px;
            border-radius: 1px;
            background: #ffffffd0;
        }
        out-ta := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed {
                    root.out-time = min(root.duration, max(root.in-time + 0.1, root.out-time + (self.mouse-x - self.pressed-x) / root.width * root.duration));
                    root.seek(root.out-time);
                }
            }
        }
    }
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 13px;
    font-weight: 700;
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

export component AppWindow inherits Window {
    title: "Neria";
    preferred-width: 1040px;
    preferred-height: 740px;
    min-width: 780px;
    min-height: 580px;
    background: Theme.bg;
    default-font-family: "Segoe UI";

    // Setup
    in property <bool> tools-ready;
    in property <string> setup-label: "Checking tools…";
    in property <float> setup-progress;
    in property <string> setup-error;

    // Link + preview
    in-out property <string> url;
    in property <int> probe-state; // 0 none, 1 loading, 2 ok, 3 error
    in property <string> probe-title;
    in property <string> probe-meta;
    in property <image> probe-thumb;
    in-out property <int> quality;

    // Queue
    in property <[JobItem]> jobs;
    in property <int> active-count;

    // Settings
    in-out property <string> output-dir;
    in-out property <int> container-index;
    in-out property <int> audio-format-index;
    in-out property <bool> prefer-h264;
    in-out property <bool> embed-thumbnail;
    in-out property <bool> embed-metadata;
    in-out property <bool> embed-subs;
    in-out property <bool> sponsorblock;
    in-out property <bool> allow-playlists;
    in-out property <int> cookies-index;
    in-out property <string> rate-limit;
    in-out property <string> filename-template;
    in-out property <string> extra-args;
    in-out property <int> max-concurrent: 2;
    in property <string> ytdlp-version;

    in-out property <int> page;
    in-out property <bool> drawer-open;

    // Clipper
    in property <bool> clip-loaded;
    in property <bool> clip-has-video;
    in property <string> clip-name;
    in property <image> clip-frame;
    in property <float> clip-duration;
    in property <float> clip-position;
    in property <bool> clip-playing;
    in-out property <float> clip-in;
    in-out property <float> clip-out;
    in-out property <int> clip-mode;
    in property <[image]> clip-thumbs;
    in property <image> clip-wave;
    in property <bool> clip-exporting;
    in property <float> clip-export-progress;
    in-out property <string> clip-status;
    in property <bool> clip-has-output;
    in property <[float]> clip-keyframes;
    in property <[float]> clip-keyframe-ticks;
    // Link mode: streaming a URL; export downloads just the selection.
    in property <bool> clip-is-link;
    in property <bool> clip-buffering;
    property <float> clip-effective-in: Fmt.keyframe-before(root.clip-in, root.clip-keyframes);
    property <bool> clip-early-start: !root.clip-is-link && root.clip-mode == 0 && root.clip-effective-in < root.clip-in - 0.05;

    // A stale "Saved · …" message shouldn't hide what the new selection will do.
    changed clip-in => { if !root.clip-exporting { root.clip-status = ""; } }
    changed clip-out => { if !root.clip-exporting { root.clip-status = ""; } }
    changed clip-mode => { if !root.clip-exporting { root.clip-status = ""; } }

    callback clip-open();
    callback clip-toggle-play();
    callback clip-seek(float);
    callback clip-frame-step(int);
    callback clip-export();
    callback clip-cancel-export();
    callback clip-show-output();
    callback clip-job(int);
    callback clip-open-path(string);
    callback clip-open-link(string, string); // url, title
    callback clip-paste-link();

    function set-in() {
        root.clip-in = min(root.clip-position, root.clip-duration);
        if root.clip-out <= root.clip-in + 0.05 {
            root.clip-out = root.clip-duration;
        }
    }
    function set-out() {
        root.clip-out = max(root.clip-position, 0);
        if root.clip-out <= root.clip-in + 0.05 {
            root.clip-in = 0;
        }
    }

    property <[string]> containers: ["mp4", "mkv", "webm"];
    property <[string]> audio-formats: ["mp3", "m4a", "opus", "flac", "wav"];

    callback paste();
    callback url-edited(string);
    callback start-download();
    callback cancel-job(int);
    callback remove-job(int);
    callback retry-job(int);
    callback open-job(int);
    callback open-output();
    callback choose-output();
    callback settings-changed();
    callback clear-finished();
    callback retry-setup();

    HorizontalLayout {
        // ───────────── Sidebar ─────────────
        Rectangle {
            width: 88px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Text {
                    text: "neria";
                    height: 56px;
                    color: Theme.accent-hi;
                    font-size: 19px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                NavItem {
                    icon: "\u{E896}";
                    label: "Download";
                    active: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    icon: "\u{E8C6}";
                    label: "Clip";
                    active: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavItem {
                    icon: "\u{E73F}";
                    label: "Compress";
                    active: root.page == 2;
                    clicked => { root.page = 2; }
                }
                Rectangle { vertical-stretch: 1; }
                NavItem {
                    icon: "\u{E713}";
                    label: "Settings";
                    active: root.drawer-open;
                    clicked => { root.drawer-open = true; }
                }
            }
        }

        // ───────────── Main ─────────────
        Rectangle {
            horizontal-stretch: 1;

            if root.page == 0: VerticalLayout {
                padding: 28px;
                spacing: 18px;

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text {
                            text: "Download";
                            color: Theme.text;
                            font-size: 26px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Paste a link from YouTube, TikTok, X, Instagram, Twitch, Reddit and 1000+ more sites.";
                            color: Theme.muted;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        GhostButton {
                            text: "Advanced";
                            icon: "\u{E9E9}";
                            clicked => { root.drawer-open = true; }
                        }
                    }
                }

                // Input card
                Rectangle {
                    background: Theme.surface;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                horizontal-stretch: 1;
                                height: 44px;
                                font-size: 14px;
                                placeholder-text: "https://…";
                                text <=> root.url;
                                edited(t) => { root.url-edited(t); }
                                accepted(t) => { root.start-download(); }
                            }
                            GhostButton {
                                horizontal-stretch: 0;
                                text: "Paste";
                                icon: "\u{E77F}";
                                clicked => { root.paste(); }
                            }
                        }

                        if root.probe-state != 0: Rectangle {
                            height: 84px;
                            border-radius: 10px;
                            background: Theme.surface-hi;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 14px;
                                Rectangle {
                                    width: 114px;
                                    border-radius: 6px;
                                    background: Theme.bg;
                                    clip: true;
                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.probe-thumb;
                                        image-fit: cover;
                                    }
                                    if root.probe-state != 2: Icon {
                                        text: root.probe-state == 1 ? "\u{E895}" : "\u{E783}";
                                        color: root.probe-state == 3 ? Theme.danger : Theme.muted;
                                        font-size: 20px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: root.probe-state == 1 ? "Looking up link…" : root.probe-title;
                                        color: root.probe-state == 3 ? Theme.danger : Theme.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.probe-meta;
                                        color: Theme.muted;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                if root.probe-state == 2: VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    GhostButton {
                                        text: "Clip first";
                                        icon: "\u{E8C6}";
                                        clicked => { root.clip-open-link(root.url, root.probe-title); }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Chip {
                                horizontal-stretch: 0;
                                text: "Best";
                                selected: root.quality == 0;
                                clicked => { root.quality = 0; root.settings-changed(); }
                            }
                            Chip {
                                horizontal-stretch: 0;
                                text: "1080p";
                                selected: root.quality == 1;
                                clicked => { root.quality = 1; root.settings-changed(); }
                            }
                            Chip {
                                horizontal-stretch: 0;
                                text: "720p";
                                selected: root.quality == 2;
                                clicked => { root.quality = 2; root.settings-changed(); }
                            }
                            Chip {
                                horizontal-stretch: 0;
                                text: "480p";
                                selected: root.quality == 3;
                                clicked => { root.quality = 3; root.settings-changed(); }
                            }
                            Chip {
                                horizontal-stretch: 0;
                                text: "Audio only";
                                selected: root.quality == 4;
                                clicked => { root.quality = 4; root.settings-changed(); }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.quality == 4
                                    ? root.audio-formats[root.audio-format-index]
                                    : root.containers[root.container-index] + (root.prefer-h264 ? " · H.264" : "");
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                            PrimaryButton {
                                horizontal-stretch: 0;
                                text: "Download";
                                icon: "\u{E896}";
                                enabled: root.tools-ready && root.url != "";
                                clicked => { root.start-download(); }
                            }
                        }
                    }
                }

                // Queue header
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Queue";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: root.active-count > 0 ? root.active-count + " active" : "";
                        color: Theme.accent-hi;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.jobs.length > root.active-count: Text {
                        text: "Clear finished";
                        color: clear-ta.has-hover ? Theme.text : Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        clear-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clear-finished(); }
                        }
                    }
                    IconButton {
                        icon: "\u{E838}";
                        clicked => { root.open-output(); }
                    }
                }

                if root.jobs.length == 0: Rectangle {
                    vertical-stretch: 1;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Icon {
                            text: "\u{E896}";
                            font-size: 28px;
                            color: Theme.border;
                        }
                        Text {
                            text: "Nothing here yet";
                            color: Theme.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Downloads show up here. Press Enter in the link box to start.";
                            color: Theme.muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.jobs.length > 0: ListView {
                    vertical-stretch: 1;
                    for job in root.jobs: VerticalLayout {
                        padding-bottom: 8px;
                        JobRow {
                            job: job;
                            cancel => { root.cancel-job(job.id); }
                            remove => { root.remove-job(job.id); }
                            retry => { root.retry-job(job.id); }
                            open => { root.open-job(job.id); }
                            open-clipper => { root.clip-job(job.id); }
                        }
                    }
                }
            }

            if root.page == 1: clip-fs := FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if !root.clip-loaded {
                        return reject;
                    }
                    if event.text == " " || event.text == "k" || event.text == "K" {
                        root.clip-toggle-play();
                        return accept;
                    }
                    if event.text == "i" || event.text == "I" {
                        root.set-in();
                        return accept;
                    }
                    if event.text == "o" || event.text == "O" {
                        root.set-out();
                        return accept;
                    }
                    if event.text == Key.LeftArrow || event.text == "j" || event.text == "J" {
                        root.clip-seek(max(0, root.clip-position - (event.modifiers.shift ? 1 : 5)));
                        return accept;
                    }
                    if event.text == Key.RightArrow || event.text == "l" || event.text == "L" {
                        root.clip-seek(min(root.clip-duration, root.clip-position + (event.modifiers.shift ? 1 : 5)));
                        return accept;
                    }
                    if event.text == "," {
                        root.clip-frame-step(-1);
                        return accept;
                    }
                    if event.text == "." {
                        root.clip-frame-step(1);
                        return accept;
                    }
                    if event.text == Key.Home {
                        root.clip-seek(root.clip-in);
                        return accept;
                    }
                    if event.text == Key.End {
                        root.clip-seek(root.clip-out);
                        return accept;
                    }
                    reject
                }

                VerticalLayout {
                    padding: 28px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Text {
                                text: "Clip";
                                color: Theme.text;
                                font-size: 26px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.clip-loaded ? root.clip-name : "Trim a file, or preview a link and download only the part you want.";
                                color: Theme.muted;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            GhostButton {
                                text: "Paste link";
                                icon: "\u{E71B}";
                                clicked => { root.clip-paste-link(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            GhostButton {
                                text: "Open file…";
                                icon: "\u{E8E5}";
                                clicked => { root.clip-open(); }
                            }
                        }
                    }

                    if !root.clip-loaded: Rectangle {
                        vertical-stretch: 1;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            Icon {
                                text: "\u{E8C6}";
                                font-size: 36px;
                                color: Theme.accent-hi;
                            }
                            Text {
                                text: "Open a file, or paste a link to clip before downloading";
                                color: Theme.text;
                                font-size: 15px;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                PrimaryButton {
                                    text: "Paste link";
                                    icon: "\u{E71B}";
                                    clicked => { root.clip-paste-link(); }
                                }
                                GhostButton {
                                    text: "Open file…";
                                    icon: "\u{E8E5}";
                                    clicked => { root.clip-open(); }
                                }
                            }
                            Text {
                                text: root.clip-status != "" ? root.clip-status : "Tip: finished downloads and link previews have a scissors button that opens them here.";
                                color: Theme.muted;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.clip-loaded: Rectangle {
                        vertical-stretch: 1;
                        min-height: 180px;
                        border-radius: 12px;
                        background: #000000;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.clip-frame;
                            image-fit: contain;
                        }
                        if !root.clip-has-video: Icon {
                            text: "\u{E8D6}";
                            font-size: 56px;
                            color: Theme.border;
                        }
                        if root.clip-buffering: Rectangle {
                            width: 150px;
                            height: 40px;
                            border-radius: 20px;
                            background: #000000b0;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Icon {
                                    text: "\u{E895}";
                                    font-size: 14px;
                                    color: Theme.accent-hi;
                                }
                                Text {
                                    text: "Loading…";
                                    color: Theme.text;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.clip-toggle-play();
                                clip-fs.focus();
                            }
                        }
                    }

                    if root.clip-loaded: HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: root.clip-playing ? "\u{E769}" : "\u{E768}";
                                tint: Theme.text;
                                clicked => { root.clip-toggle-play(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: "\u{E892}";
                                clicked => { root.clip-frame-step(-1); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: "\u{E893}";
                                clicked => { root.clip-frame-step(1); }
                            }
                        }
                        Text {
                            text: Fmt.time(root.clip-position) + "  /  " + Fmt.time(root.clip-duration);
                            color: Theme.text;
                            font-family: "Consolas";
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        GhostButton {
                            horizontal-stretch: 0;
                            text: "In  " + Fmt.time(root.clip-in);
                            clicked => { root.set-in(); }
                        }
                        GhostButton {
                            horizontal-stretch: 0;
                            text: "Out  " + Fmt.time(root.clip-out);
                            clicked => { root.set-out(); }
                        }
                    }

                    if root.clip-loaded: Timeline {
                        duration: root.clip-duration;
                        position: root.clip-position;
                        in-time <=> root.clip-in;
                        out-time <=> root.clip-out;
                        thumbs: root.clip-thumbs;
                        wave: root.clip-wave;
                        has-video: root.clip-has-video;
                        show-keyframes: root.clip-mode == 0 && !root.clip-is-link;
                        keyframe-ticks: root.clip-keyframe-ticks;
                        effective-in: root.clip-effective-in;
                        seek(t) => {
                            root.clip-seek(t);
                            clip-fs.focus();
                        }
                    }

                    if root.clip-loaded: Text {
                        text: "Space play/pause  ·  I / O set in / out  ·  ← → 5s (Shift 1s)  ·  , . frame step  ·  Home / End jump to in / out";
                        color: Theme.muted;
                        font-size: 11px;
                        overflow: elide;
                    }

                    if root.clip-loaded: HorizontalLayout {
                        spacing: 8px;
                        Chip {
                            horizontal-stretch: 0;
                            text: "Fast · lossless";
                            selected: root.clip-mode == 0;
                            clicked => { root.clip-mode = 0; }
                        }
                        Chip {
                            horizontal-stretch: 0;
                            text: "Exact · re-encode";
                            selected: root.clip-mode == 1;
                            clicked => { root.clip-mode = 1; }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.clip-status != "" ? root.clip-status
                                : root.clip-is-link ? "Downloads only " + Fmt.time(root.clip-out - root.clip-in)
                                    + (root.clip-mode == 0 ? "  ·  fast, may start a few seconds early" : "  ·  frame-exact (slower)")
                                : root.clip-mode == 1 ? "Selection " + Fmt.time(root.clip-out - root.clip-in) + "  ·  frame-exact H.264"
                                : root.clip-early-start ? "Lossless cut starts earlier, at " + Fmt.time(root.clip-effective-in) + " (keyframe)"
                                : "Selection " + Fmt.time(root.clip-out - root.clip-in) + "  ·  lossless, starts on a keyframe";
                            color: root.clip-status == "" && root.clip-early-start ? Theme.warn : Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        if root.clip-status == "" && root.clip-early-start: GhostButton {
                            horizontal-stretch: 0;
                            text: "Snap to keyframe";
                            clicked => {
                                root.clip-in = root.clip-effective-in;
                                root.clip-seek(root.clip-in);
                            }
                        }
                        if root.clip-has-output && !root.clip-exporting: GhostButton {
                            horizontal-stretch: 0;
                            text: "Show file";
                            icon: "\u{E838}";
                            clicked => { root.clip-show-output(); }
                        }
                        if root.clip-is-link && root.clip-status != "": GhostButton {
                            horizontal-stretch: 0;
                            text: "View queue";
                            clicked => { root.page = 0; }
                        }
                        PrimaryButton {
                            horizontal-stretch: 0;
                            text: root.clip-exporting ? "Cancel  " + Math.round(root.clip-export-progress * 100) + "%"
                                : root.clip-is-link ? "Download clip" : "Export clip";
                            icon: root.clip-exporting ? "" : root.clip-is-link ? "\u{E896}" : "\u{E8C6}";
                            enabled: root.clip-out > root.clip-in && root.tools-ready;
                            clicked => {
                                if root.clip-exporting {
                                    root.clip-cancel-export();
                                } else {
                                    root.clip-export();
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 2: VerticalLayout {
                alignment: center;
                padding: 48px;
                spacing: 12px;
                Icon {
                    text: "\u{E73F}";
                    font-size: 44px;
                    color: Theme.accent-hi;
                }
                Text {
                    text: "Compressor is coming";
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Shrink videos to fit Discord and friends: pick a target size, Neria works out the bitrate and uses your GPU encoder.";
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // ───────────── Settings drawer ─────────────
    if root.drawer-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea {
            clicked => { root.drawer-open = false; }
        }

        Rectangle {
            x: parent.width - self.width;
            y: 0;
            width: 400px;
            height: parent.height;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }

            VerticalLayout {
                padding: 22px;
                spacing: 14px;

                HorizontalLayout {
                    Text {
                        text: "Advanced settings";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: "\u{E711}";
                        clicked => { root.drawer-open = false; }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 22px;
                        padding-right: 14px;
                        alignment: start;

                        VerticalLayout {
                            spacing: 8px;
                            SectionTitle { text: "Save to"; }
                            Text {
                                text: root.output-dir;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                GhostButton {
                                    text: "Change…";
                                    clicked => { root.choose-output(); }
                                }
                                GhostButton {
                                    text: "Open folder";
                                    clicked => { root.open-output(); }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            SectionTitle { text: "Video"; }
                            HorizontalLayout {
                                spacing: 10px;
                                Hint {
                                    text: "Container";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                ComboBox {
                                    width: 140px;
                                    model: root.containers;
                                    current-index <=> root.container-index;
                                    selected => { root.settings-changed(); }
                                }
                            }
                            CheckBox {
                                text: "Prefer H.264 (plays everywhere, max 1080p on YouTube)";
                                checked <=> root.prefer-h264;
                                toggled => { root.settings-changed(); }
                            }
                            CheckBox {
                                text: "Embed subtitles";
                                checked <=> root.embed-subs;
                                toggled => { root.settings-changed(); }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            SectionTitle { text: "Audio only"; }
                            HorizontalLayout {
                                spacing: 10px;
                                Hint {
                                    text: "Convert to";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                ComboBox {
                                    width: 140px;
                                    model: root.audio-formats;
                                    current-index <=> root.audio-format-index;
                                    selected => { root.settings-changed(); }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            SectionTitle { text: "Extras"; }
                            CheckBox {
                                text: "Embed thumbnail as cover art";
                                checked <=> root.embed-thumbnail;
                                toggled => { root.settings-changed(); }
                            }
                            CheckBox {
                                text: "Embed title, artist and other metadata";
                                checked <=> root.embed-metadata;
                                toggled => { root.settings-changed(); }
                            }
                            CheckBox {
                                text: "Cut out sponsor segments (SponsorBlock)";
                                checked <=> root.sponsorblock;
                                toggled => { root.settings-changed(); }
                            }
                            CheckBox {
                                text: "Download whole playlists";
                                checked <=> root.allow-playlists;
                                toggled => { root.settings-changed(); }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            SectionTitle { text: "Network"; }
                            HorizontalLayout {
                                spacing: 10px;
                                Hint {
                                    text: "Cookies from browser";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                ComboBox {
                                    width: 140px;
                                    model: ["None", "Chrome", "Edge", "Firefox", "Brave", "Opera", "Vivaldi"];
                                    current-index <=> root.cookies-index;
                                    selected => { root.settings-changed(); }
                                }
                            }
                            Hint { text: "Use this for age-restricted, members-only or \"confirm you're not a bot\" videos."; }
                            HorizontalLayout {
                                spacing: 10px;
                                Hint {
                                    text: "Speed limit";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                LineEdit {
                                    width: 140px;
                                    placeholder-text: "e.g. 5M";
                                    text <=> root.rate-limit;
                                    edited => { root.settings-changed(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Hint {
                                    text: "Downloads at once";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                SpinBox {
                                    width: 140px;
                                    minimum: 1;
                                    maximum: 8;
                                    value <=> root.max-concurrent;
                                    edited => { root.settings-changed(); }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 8px;
                            SectionTitle { text: "Expert"; }
                            Hint { text: "File name template"; }
                            LineEdit {
                                text <=> root.filename-template;
                                edited => { root.settings-changed(); }
                            }
                            Hint { text: "Extra yt-dlp arguments"; }
                            LineEdit {
                                placeholder-text: "e.g. --write-description";
                                text <=> root.extra-args;
                                edited => { root.settings-changed(); }
                            }
                            Hint { text: root.ytdlp-version == "" ? "" : "yt-dlp " + root.ytdlp-version + "  ·  auto-updates daily"; }
                        }
                    }
                }
            }
        }
    }

    // ───────────── First-run setup ─────────────
    if !root.tools-ready: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.bg;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            padding: 80px;
            spacing: 14px;
            Text {
                text: "neria";
                color: Theme.accent-hi;
                font-size: 40px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            Text {
                text: root.setup-error != "" ? "Setup hit a snag" : "Getting things ready";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: root.setup-error != "" ? root.setup-error : root.setup-label;
                color: root.setup-error != "" ? Theme.danger : Theme.muted;
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Bar {
                    width: 380px;
                    value: root.setup-progress;
                }
            }
            if root.setup-error != "": HorizontalLayout {
                alignment: center;
                PrimaryButton {
                    text: "Try again";
                    clicked => { root.retry-setup(); }
                }
            }
            Text {
                text: "First run only: yt-dlp, FFmpeg and Deno go into the bin folder next to Neria. Nothing is installed system-wide.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }
}
