import { Theme, Screen } from "../theme.slint";
import { Fmt } from "../types.slint";
import { Icon, PrimaryButton, GhostButton, IconButton, ChoiceChips, Chip, PageTitle, Notice, Divider, Tag, Hint, CropFrame } from "../widgets.slint";
import { QualityRow } from "../components/quality-row.slint";
import { RecentList } from "../components/recent-list.slint";
import { RecentItem, ChapterMark } from "../types.slint";
import { Timeline, ChapterStrip } from "../components/timeline.slint";
import { Presets, Watch, ClipSound, ClipGif, ClipPicture, ClipList, ClipLive, ClipView, QueueActions, Transcribe, ClipChat } from "../globals.slint";
import { ChatPanel } from "../components/chat-panel.slint";
import { Menu, MenuItem, TextLink } from "../widgets.slint";

// The timeline's zoom: out, in, fit the clip, the whole video, and how much is on screen.
// Ctrl+scroll on the timeline (or a touchpad pinch) and + / − do the same.
component ZoomButtons inherits HorizontalLayout {
    spacing: 2px;
    horizontal-stretch: 0;
    if Screen.wide: Text {
        text: ClipView.span-text;
        color: Theme.muted;
        font-size: 11px;
        vertical-alignment: center;
    }
    if Screen.wide: Rectangle {
        width: 6px;
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            icon: "\u{E71F}";
            label: "Zoom out";
            tint: ClipView.zoomed ? Theme.text : Theme.dim;
            clicked => { ClipView.zoom(1.6, -1); }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            icon: "\u{E8A3}";
            label: "Zoom in";
            tint: ClipView.can-zoom-in ? Theme.text : Theme.dim;
            clicked => { ClipView.zoom(1 / 1.6, -1); }
        }
    }
    if !ClipLive.on && !Watch.on: VerticalLayout {
        alignment: center;
        GhostButton {
            compact: true;
            icon: "\u{E9A6}";
            text: Screen.wide ? "Fit clip" : "";
            label: "Zoom to the clip";
            clicked => { ClipView.fit-clip(); }
        }
    }
    // Always there (with nothing to do when it all shows), so the buttons never move under
    // the pointer.
    VerticalLayout {
        alignment: center;
        GhostButton {
            compact: true;
            icon: "\u{E740}";
            text: Screen.wide ? (ClipLive.on ? "All of it" : "Whole video") : "";
            label: ClipLive.on ? "Show all the site keeps" : "Show the whole video";
            clicked => { ClipView.whole(); }
        }
    }
}

// A live stream: save the last bit with one press (rewound from the site's window, or from
// the replay buffer), go back to live, or keep the last few minutes when the site can't
// rewind. Wraps on narrow windows.
// "Save the last ▾": the last 30 s / 1 min / 5 min / 10 min as a file of their own, from a
// recording or from what the site (or the replay buffer) keeps. `note` instead of the picks
// says why it can't yet.
component LastMenu inherits VerticalLayout {
    in property <string> note;
    callback picked(float);
    alignment: center;
    horizontal-stretch: Screen.compact ? 1 : 0;
    GhostButton {
        text: Screen.compact ? "Last" : "Save the last";
        label: "Save the last few minutes";
        icon: "\u{E81C}";
        trail: "\u{E70E}";
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0;
        y: root.note == "" ? -174px : -54px;
        Menu {
            width: 210px;
            if root.note != "": MenuItem {
                text: root.note;
            }
            if root.note == "": MenuItem {
                text: "30 seconds";
                clicked => { root.picked(30); }
            }
            if root.note == "": MenuItem {
                text: "1 minute";
                clicked => { root.picked(60); }
            }
            if root.note == "": MenuItem {
                text: "5 minutes";
                clicked => { root.picked(300); }
            }
            if root.note == "": MenuItem {
                text: "10 minutes";
                clicked => { root.picked(600); }
            }
        }
    }
}

// Record a live stream: from now (one press), and when the site keeps it from its start, its
// ▾ offers that too, with what it costs.
component RecordMenu inherits VerticalLayout {
    in property <bool> enabled;
    alignment: center;
    horizontal-stretch: Screen.compact ? 1 : 0;
    PrimaryButton {
        text: "Record";
        icon: "\u{E7C8}";
        has-menu: ClipLive.from-start != "";
        enabled: root.enabled;
        clicked => { Watch.record(); }
        menu-clicked => { menu.show(); }
    }
    menu := PopupWindow {
        // Under the right edge of the button, opening upwards (the bar is at the bottom).
        x: root.width - 320px;
        y: -98px;
        Menu {
            width: 320px;
            MenuItem {
                icon: "\u{E7C8}";
                text: "From now";
                clicked => { Watch.record(); }
            }
            MenuItem {
                icon: "\u{E72C}";
                text: "From the start · " + ClipLive.from-start;
                clicked => { Watch.record-from-start(); }
            }
        }
    }
}

component LiveRow inherits FlexboxLayout {
    spacing: 8px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    // Not rewindable: how much to keep (one row of chips, so it wraps as a whole), then go.
    if !ClipLive.can-rewind && !ClipLive.buffering && !Screen.compact: Text {
        text: "Keep the last";
        color: Theme.muted;
        font-size: 12px;
        height: 30px;
        vertical-alignment: center;
    }
    for m[i] in (!ClipLive.can-rewind && !ClipLive.buffering ? ["5 min", "10 min", "30 min", "60 min"] : []): Chip {
        text: m;
        selected: ClipLive.keep == i;
        clicked => { ClipLive.keep = i; }
    }
    if !ClipLive.can-rewind && !ClipLive.buffering: GhostButton {
        compact: true;
        icon: "\u{E7C8}";
        text: "Start keeping";
        label: "Keep the last " + (ClipLive.keep == 0 ? "5" : ClipLive.keep == 1 ? "10" : ClipLive.keep == 2 ? "30" : "60") + " minutes";
        clicked => { ClipLive.buffer-start(); }
    }
    if (ClipLive.can-rewind || ClipLive.buffering) && !Screen.compact: Text {
        text: "Save the last";
        color: Theme.muted;
        font-size: 12px;
        height: 30px;
        vertical-alignment: center;
    }
    if ClipLive.can-rewind || ClipLive.buffering: GhostButton {
        compact: true;
        text: Screen.compact ? "Last 30 s" : "30 s";
        label: "Save the last 30 seconds";
        clicked => { ClipLive.last(30); }
    }
    if ClipLive.can-rewind || ClipLive.buffering: GhostButton {
        compact: true;
        text: "1 min";
        label: "Save the last minute";
        clicked => { ClipLive.last(60); }
    }
    if ClipLive.can-rewind || ClipLive.buffering: GhostButton {
        compact: true;
        text: "5 min";
        label: "Save the last 5 minutes";
        clicked => { ClipLive.last(300); }
    }
    if ClipLive.can-rewind || ClipLive.buffering: GhostButton {
        compact: true;
        text: "10 min";
        label: "Save the last 10 minutes";
        clicked => { ClipLive.last(600); }
    }
    if ClipLive.buffering: GhostButton {
        compact: true;
        icon: "\u{E71A}";
        text: "Stop keeping";
        clicked => { ClipLive.buffer-stop(); }
    }
    if ClipLive.can-rewind && !Screen.compact: ZoomButtons { }
}

// Clip page → Picture: the shape chips, turn and mirror, Reset and Done. Takes the place of
// the bottom bar while the crop frame is up.
component PictureBar inherits VerticalLayout {
    spacing: 8px;
    vertical-stretch: 0;
    ChoiceChips {
        options: ["Whole picture", "Free", "9:16", "1:1", "4:5", "16:9"];
        current <=> ClipPicture.aspect;
        changed => { ClipPicture.aspect-picked(); }
    }
    HorizontalLayout {
        spacing: 8px;
        GhostButton {
            horizontal-stretch: 0;
            compact: Screen.compact;
            icon: "\u{E7A7}";
            text: Screen.wide ? "Turn left" : "";
            label: "Turn left";
            clicked => {
                ClipPicture.turns = Math.mod(ClipPicture.turns + 3, 4);
                ClipPicture.aspect-picked();
            }
        }
        GhostButton {
            horizontal-stretch: 0;
            compact: Screen.compact;
            icon: "\u{E7A6}";
            text: Screen.wide ? "Turn right" : "";
            label: "Turn right";
            clicked => {
                ClipPicture.turns = Math.mod(ClipPicture.turns + 1, 4);
                ClipPicture.aspect-picked();
            }
        }
        GhostButton {
            horizontal-stretch: 0;
            compact: Screen.compact;
            icon: "\u{E8AB}";
            text: Screen.wide ? "Mirror" : "";
            label: "Mirror left to right";
            on: ClipPicture.flip-h;
            clicked => {
                ClipPicture.flip-h = !ClipPicture.flip-h;
                ClipPicture.changed();
            }
        }
        GhostButton {
            horizontal-stretch: 0;
            compact: Screen.compact;
            icon: "\u{E8CB}";
            text: Screen.wide ? "Upside down" : "";
            label: "Flip upside down";
            on: ClipPicture.flip-v;
            clicked => {
                ClipPicture.flip-v = !ClipPicture.flip-v;
                ClipPicture.changed();
            }
        }
        Rectangle { horizontal-stretch: 1; }
        GhostButton {
            horizontal-stretch: 0;
            compact: Screen.compact;
            text: "Reset";
            clicked => { ClipPicture.reset(); }
        }
        PrimaryButton {
            horizontal-stretch: 0;
            text: "Done";
            icon: "\u{E73E}";
            clicked => {
                ClipPicture.editing = false;
                ClipPicture.changed();
            }
        }
    }
    if !Screen.compact: Hint {
        text: "Turning, mirroring and cropping re-encode the video, so it's saved frame-exact. Drag the frame to move it, a corner to size it.";
    }
}
import { Slider } from "std-widgets.slint";

// The Export button with its ▾: the same export, or Make a GIF. The menu opens upwards,
// right-aligned with the button (it sits at the bottom of the page).
component ExportButton inherits HorizontalLayout {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> has-menu;
    in property <string> menu-text;
    in property <string> menu-icon;
    callback clicked();
    PrimaryButton {
        text: root.text;
        icon: root.icon;
        enabled: root.enabled;
        has-menu: root.has-menu;
        menu-clicked => { menu.show(); }
        clicked => { root.clicked(); }
    }
    menu := PopupWindow {
        x: root.width - 250px;
        y: -144px;
        width: 250px;
        height: 138px;
        Menu {
            x: 0;
            y: 0;
            width: 250px;
            MenuItem {
                icon: root.menu-icon;
                text: root.menu-text;
                clicked => { root.clicked(); }
            }
            MenuItem {
                icon: "\u{E8B9}";
                text: "Make a GIF…";
                clicked => {
                    ClipGif.open = true;
                    ClipGif.changed();
                }
            }
            MenuItem {
                icon: "\u{E70B}";
                text: "Transcribe…";
                clicked => { Transcribe.open-for-clip(); }
            }
        }
    }
}
// Trim a file, or preview a link and download only the selection. Takes the keyboard
// (Space, I/O, J/L, arrows, `,` `.`, R, Home/End) while it's open.
export component ClipPage inherits FocusScope {
    in property <bool> tools-ready;
    in property <bool> loaded;
    in property <bool> has-video;
    // False for a silent video: no Sound button then.
    in property <bool> has-audio: true;
    in property <string> name;
    in property <image> frame;
    in property <float> duration;
    in property <float> position;
    in property <bool> playing;
    in-out property <float> in-time;
    in-out property <float> out-time;
    // 0 fast (lossless), 1 exact (re-encode)
    in-out property <int> mode;
    // Play the selection on repeat instead of stopping at Out.
    in-out property <bool> loop;
    in property <[image]> thumbs;
    in property <image> wave;
    in property <bool> exporting;
    in property <float> export-progress;
    in property <string> status;
    in property <bool> has-output;
    in property <[float]> keyframes;
    in property <[float]> keyframe-ticks;
    in property <[ChapterMark]> chapters;
    // Link mode: streaming a URL; export downloads just the selection.
    in property <bool> is-link;
    // The link is an X GIF saved as a real .gif: no quality to pick.
    in property <bool> gif;
    // A .gif file is open: it's saved as a GIF again (no Fast / Exact).
    in property <bool> gif-file;
    in property <bool> buffering;

    // Link mode's quality row (shared with the Download page).
    in-out property <int> quality;
    in-out property <int> container-index;
    in-out property <int> audio-format-index;
    in property <string> video-format;
    in property <string> audio-format;

    callback open-file();
    callback paste-link();
    // Empty page: recent downloads, opened by path.
    in property <[RecentItem]> recent;
    callback open-path(string);
    callback toggle-play();
    callback seek(float);
    callback frame-step(int);
    callback export-clip();
    callback cancel-export();
    callback show-output();
    callback view-queue();
    callback settings-changed();
    callback open-settings();

    property <float> effective-in: Fmt.keyframe-before(root.in-time, root.keyframes);
    // Sound only (files) cuts exactly at In, whatever the mode.
    property <bool> sound-only: !root.is-link && root.has-video && ClipSound.save == 1;
    // A sound file saved as another format: also cut exactly at In.
    property <bool> converts: !root.is-link && !root.has-video && ClipSound.file-format > 0;
    // A changed picture is always re-encoded (frame-exact), whatever the mode says.
    property <bool> picture-changed: root.has-video && ClipPicture.changed-any && !root.sound-only;
    property <int> clips: ClipList.items.length;
    // The bottom bar fits on one line (chips, Sound, Picture, status, Export) only from here;
    // narrower, the status gets its own line above.
    property <bool> one-bar: Screen.width - (root.chat-tall ? 356px : 0px) >= 1200px;
    // The clip list: how it'll be saved, from the choices as they are now.
    property <string> clips-how: ClipList.join && root.clips > 1
        ? (root.is-link ? "joined into one file, in time order" : "joined into one file (cut frame-exact)")
        : root.is-link ? root.clips + " downloads"
        : root.gif-file ? "one GIF each"
        : root.mode == 0 && root.has-video && !root.picture-changed && !root.sound-only
            ? "one file each, each starts on the keyframe before its In"
        : "one file each";
    property <bool> early-start: !root.is-link && !root.sound-only && !root.converts && !root.gif-file && !root.picture-changed
        && root.clips == 0 && root.mode == 0 && root.effective-in < root.in-time - 0.05;
    // What the export will do (or how it went), next to the Export button.
    // While the buffer keeps, its line stays (a save's "Saved · …" goes after it).
    property <string> status-text: ClipLive.on && ClipLive.buffering
            ? ClipLive.buffer-text + (root.status != "" ? "  ·  " + root.status : "")
        : root.status != "" ? root.status
        : ClipLive.on ? (ClipLive.can-rewind ? "Downloads " + Fmt.time(root.out-time - root.in-time) + " from " + Fmt.time(max(0, root.duration - root.in-time)) + " ago  ·  the site keeps the last " + Fmt.time(root.duration)
            : ClipLive.buffering ? ClipLive.buffer-text : "This stream can't be rewound: keep the last few minutes to save them")
        : root.clips > 0 ? ClipList.note + "  ·  " + root.clips-how
        : root.gif-file ? "Selection " + Fmt.time(root.out-time - root.in-time) + "  ·  saved as a GIF again"
        : root.picture-changed && !root.is-link ? "Selection " + Fmt.time(root.out-time - root.in-time) + "  ·  frame-exact, the picture changed"
        : root.is-link ? "Downloads only " + Fmt.time(root.out-time - root.in-time)
            + (root.mode == 0 ? "  ·  best quality, may start a few seconds early" : "  ·  exact cut, re-encoded (slower)")
        : root.sound-only ? "Selection " + Fmt.time(root.out-time - root.in-time) + "  ·  sound only"
        : root.converts ? "Selection " + Fmt.time(root.out-time - root.in-time) + "  ·  saved as " + ["mp3", "m4a", "opus", "flac", "wav"][ClipSound.file-format - 1] + ", cut exactly"
        : root.mode == 1 ? "Selection " + Fmt.time(root.out-time - root.in-time) + "  ·  exact cut, re-encoded (slower, a little quality lost)"
        : root.early-start ? "Lossless cut starts earlier, at " + Fmt.time(root.effective-in) + " (keyframe)"
        : "Selection " + Fmt.time(root.out-time - root.in-time) + "  ·  original quality, instant, starts on a keyframe";
    property <bool> status-warn: root.status == "" && root.early-start;
    property <string> export-text: root.clips > 0 ? (root.is-link ? "Download " : "Export ") + root.clips + (root.clips == 1 ? " clip" : " clips")
        : root.is-link ? "Download clip" : root.sound-only ? "Export sound" : "Export clip";
    // The Export button's ▾ (Make a GIF): not while exporting, nor for an X GIF link.
    property <bool> gif-menu: !root.exporting && !root.gif && root.has-video && !ClipLive.on;

    // In / Out make sense: not on a live stream the site can't rewind (the buffer saves it).
    property <bool> marks: !ClipLive.on || ClipLive.can-rewind;
    // A mark on a live stream reads as time behind live ("−4:30").
    function mark(t: float) -> string {
        ClipLive.on ? "−" + Fmt.time(max(0, root.duration - t)) : Fmt.time(t)
    }
    function set-in() {
        root.in-time = min(root.position, root.duration);
        if root.out-time <= root.in-time + 0.05 {
            root.out-time = root.duration;
        }
    }
    function set-out() {
        root.out-time = max(root.position, 0);
        if root.out-time <= root.in-time + 0.05 {
            root.in-time = 0;
        }
    }

    init => { self.focus(); }
    // A dialog or the crop frame took the keyboard; give it back when it closes (Space, I/O…).
    property <bool> sound-open: ClipSound.open || ClipGif.open || ClipList.open || ClipPicture.editing || ClipChat.open || ClipChat.sheet;
    // Compact: the chat is a sheet over the page, opened from the player's Chat button.
    // (ClipChat.sheet: compact, the chat as a sheet over the page.)
    // Wide and medium: the panel beside the player (it can be hidden, and shown again).
    property <bool> chat-beside: root.loaded && ClipChat.available && ClipChat.shown && !Screen.compact && !root.chat-tall;
    // 1200 px and up: the chat is a full-height column on the right (like the sites' own),
    // beside the player, the timeline and the bars. Narrower it sits beside the player only.
    property <bool> chat-tall: root.loaded && ClipChat.available && ClipChat.shown && Screen.width >= 1200px;
    changed sound-open => {
        if !self.sound-open {
            self.focus();
        }
    }
    key-pressed(event) => {
        if !root.loaded {
            return reject;
        }
        if event.text == " " || event.text == "k" || event.text == "K" {
            root.toggle-play();
            return accept;
        }
        if Watch.on && (event.text == Key.Home || event.text == Key.End) {
            root.seek(event.text == Key.Home ? 0 : root.duration);
            return accept;
        }
        if Watch.on && (event.text == "m" || event.text == "M") {
            Watch.muted = !Watch.muted;
            Watch.volume-changed();
            return accept;
        }
        if Watch.on && (event.text == "i" || event.text == "I" || event.text == "o" || event.text == "O"
                || event.text == "r" || event.text == "R" || event.text == "," || event.text == ".") {
            return reject;
        }
        if event.text == "i" || event.text == "I" {
            root.set-in();
            return accept;
        }
        if event.text == "o" || event.text == "O" {
            root.set-out();
            return accept;
        }
        if event.text == Key.LeftArrow || event.text == "j" || event.text == "J" {
            root.seek(max(0, root.position - (event.modifiers.shift ? 1 : 5)));
            return accept;
        }
        if event.text == Key.RightArrow || event.text == "l" || event.text == "L" {
            root.seek(min(root.duration, root.position + (event.modifiers.shift ? 1 : 5)));
            return accept;
        }
        if event.text == "," {
            root.frame-step(-1);
            return accept;
        }
        if event.text == "." {
            root.frame-step(1);
            return accept;
        }
        if event.text == "r" || event.text == "R" {
            root.loop = !root.loop;
            return accept;
        }
        // A: add the selection to the clip list.
        // Not where the Clips button is hidden (live streams, watching, X GIFs).
        if (event.text == "a" || event.text == "A") && root.out-time > root.in-time && !ClipLive.on && !Watch.on && !root.gif {
            ClipList.add();
            return accept;
        }
        // + / −: zoom the timeline (around the playhead).
        if event.text == "+" || event.text == "=" {
            ClipView.zoom(1 / 1.6, -1);
            return accept;
        }
        if event.text == "-" || event.text == "_" {
            ClipView.zoom(1.6, -1);
            return accept;
        }
        if event.text == Key.Home {
            root.seek(root.in-time);
            return accept;
        }
        if event.text == Key.End {
            root.seek(root.out-time);
            return accept;
        }
        reject
    }

    // Compact: everything stacks, the player gives up height first, and the Export bar
    // stays pinned at the bottom. Wide: the chat column on the right, the full height.
    HorizontalLayout {
      padding-right: root.chat-tall ? 28px : 0px;
      spacing: 0px;
    VerticalLayout {
        horizontal-stretch: 1;
        padding: Screen.compact ? Screen.pad : 28px;
        padding-right: root.chat-tall ? 20px : (Screen.compact ? Screen.pad : 28px);
        padding-bottom: Screen.compact ? 12px : 28px;
        spacing: Screen.compact ? 8px : 14px;

        HorizontalLayout {
            spacing: Screen.compact ? 6px : 12px;
            PageTitle {
                horizontal-stretch: 1;
                spacing: 4px;
                title: !Watch.on ? "Cut the good part." : Watch.recording-id != 0 && !Watch.rec-done ? "Recording it live." : Watch.recording-id != 0 || ClipLive.on ? "Watching it live." : "Watch it first.";
                subtitle: root.loaded ? root.name : Screen.compact ? "" : "Trim a file, or preview a link and download only the part you want.";
            }
            // Watching: back to the preview it came from.
            if root.loaded && Watch.on: VerticalLayout {
                alignment: Screen.compact ? start : center;
                horizontal-stretch: 0;
                GhostButton {
                    compact: true;
                    text: "Back";
                    icon: "\u{E72B}";
                    clicked => { Watch.back(); }
                }
            }
            // Compact: the chat opens as a sheet over the page.
            if root.loaded && Screen.compact && ClipChat.available: VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;
                GhostButton {
                    compact: true;
                    text: "";
                    icon: "\u{E8BD}";
                    label: "Show the chat";
                    clicked => { ClipChat.sheet = true; }
                }
            }
            // Once something is open; compact: icons only, level with the headline.
            if root.loaded && !Watch.on: VerticalLayout {
                alignment: Screen.compact ? start : center;
                horizontal-stretch: 0;
                GhostButton {
                    compact: true;
                    text: Screen.compact ? "" : "Paste link";
                    icon: "\u{E71B}";
                    label: "Paste link";
                    clicked => { root.paste-link(); }
                }
            }
            if root.loaded && !Watch.on: VerticalLayout {
                alignment: Screen.compact ? start : center;
                horizontal-stretch: 0;
                GhostButton {
                    compact: true;
                    text: Screen.compact ? "" : "Open file…";
                    icon: "\u{E8E5}";
                    label: "Open file";
                    clicked => { root.open-file(); }
                }
            }
        }

        // Nothing open: the two ways in, then recent downloads (left-aligned like every page).
        if !root.loaded: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            spacing: 14px;
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                PrimaryButton {
                    text: "Paste link";
                    icon: "\u{E71B}";
                    clicked => { root.paste-link(); }
                }
                GhostButton {
                    text: "Open file…";
                    icon: "\u{E8E5}";
                    label: "Open file";
                    clicked => { root.open-file(); }
                }
            }
            if root.status != "": Notice {
                icon: "\u{E946}";
                text: root.status;
                color: Theme.muted;
                font-size: 12.5px;
                wrap: true;
            }
            Divider { }
            RecentList {
                items: root.recent;
                action: "Clip";
                empty-text: "Open a video or audio file, or paste a link to clip it before downloading. Finished downloads show up here, ready to trim.";
                open(path) => { root.open-path(path); }
            }
        }

        // The black box hugs the video's own shape (no side bars in a wide
        // window); 16:9 until the first frame arrives or for audio files. Live chat (or a
        // stream's saved chat) sits beside it.
        if root.loaded: HorizontalLayout {
          vertical-stretch: 1;
          spacing: 16px;
          Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            min-height: Screen.compact ? 64px : Screen.wide ? 180px : 120px;
            // Fixed hints so the inner box (sized from this one) can't feed its
            // size back into the page layout.
            min-width: 0px;
            preferred-width: 0px;
            preferred-height: 0px;
            property <float> aspect: root.has-video && root.frame.width > 0 && root.frame.height > 0
                ? root.frame.width / root.frame.height : 16 / 9;
            Rectangle {
                width: min(parent.width, parent.height * parent.aspect);
                height: min(parent.height, parent.width / parent.aspect);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 12px;
                background: Theme.video;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.frame;
                    image-fit: contain;
                }
                if !root.has-video: Icon {
                    text: "\u{E8D6}";
                    font-size: 56px;
                    color: Theme.border;
                }
                if root.buffering: Rectangle {
                    width: 150px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.video-veil;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Icon {
                            text: "\u{E895}";
                            font-size: 14px;
                            color: Theme.accent-hi;
                        }
                        Text {
                            text: "Loading…";
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }
                // keyboard: Space plays and pauses (the page takes the keyboard).
                TouchArea {
                    clicked => {
                        root.toggle-play();
                        root.focus();
                    }
                }
                // Picture mode: the crop frame over the turned picture.
                if ClipPicture.editing && ClipPicture.aspect != 0 && root.has-video: CropFrame {
                    width: parent.width;
                    height: parent.height;
                    cx <=> ClipPicture.cx;
                    cy <=> ClipPicture.cy;
                    cw <=> ClipPicture.cw;
                    ch <=> ClipPicture.ch;
                    ratio: ClipPicture.aspect == 2 ? 9 / 16 : ClipPicture.aspect == 3 ? 1 : ClipPicture.aspect == 4 ? 4 / 5
                        : ClipPicture.aspect == 5 ? 16 / 9 : 0;
                    moved => { ClipPicture.changed(); }
                }
                // What plays is the finished picture (cropped, turned): say so.
                if ClipLive.on: Tag {
                    x: parent.width - self.width - 10px;
                    y: 10px;
                    width: self.preferred-width;
                    height: self.preferred-height;
                    text: "LIVE";
                    kind: 3;
                }
                if !ClipPicture.editing && root.picture-changed: Tag {
                    x: 10px;
                    y: 10px;
                    // Its own size (placed by hand, not in a layout).
                    width: self.preferred-width;
                    height: self.preferred-height;
                    text: "Result: " + ClipPicture.short-text;
                    kind: 4;
                }
            }
          }
          if root.chat-beside: ChatPanel {
            width: Screen.wide ? 320px : 260px;
            horizontal-stretch: 0;
            roomy: root.height >= 700px;
            very-roomy: root.height >= 780px;
          }
        }

        if root.loaded: HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.playing ? "\u{E769}" : "\u{E768}";
                    label: root.playing ? "Pause" : "Play";
                    tint: Theme.text;
                    clicked => { root.toggle-play(); }
                }
            }
            if !Watch.on: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "\u{E892}";
                    label: "Previous frame";
                    clicked => { root.frame-step(-1); }
                }
            }
            if !Watch.on: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "\u{E893}";
                    label: "Next frame";
                    clicked => { root.frame-step(1); }
                }
            }
            if !Watch.on: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: root.loop ? Theme.accent.with-alpha(0.2) : transparent;
                    IconButton {
                        icon: "\u{E8EE}";
                        label: "Play the selection on repeat";
                        tint: root.loop ? Theme.accent-hi : Theme.muted;
                        clicked => { root.loop = !root.loop; }
                    }
                }
            }
            Text {
                text: ClipLive.on ? (!ClipLive.can-rewind || root.duration - root.position < ClipLive.live-slack ? "Live" : Fmt.time(root.duration - root.position) + " behind live") : Fmt.time(root.position) + "  /  " + Fmt.time(root.duration);
                color: Theme.text;
                font-family: Theme.mono;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            // Behind live: back to the live edge.
            if ClipLive.on && ClipLive.can-rewind && root.duration - root.position >= 15: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                GhostButton {
                    compact: true;
                    icon: "\u{E893}";
                    // Room for the time first: an icon below wide windows (at 400 the text
                    // cut "0:24.93 behind live" short).
                    text: Screen.wide ? "Go live" : "";
                    label: "Go live";
                    clicked => { ClipLive.go-live(); }
                }
            }
            // Compact while watching: zoom out / in here (no In / Out row then).
            if Screen.compact && Watch.on && (!ClipLive.on || ClipLive.can-rewind): VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                IconButton {
                    icon: "\u{E71F}";
                    label: "Zoom out";
                    tint: ClipView.zoomed ? Theme.text : Theme.dim;
                    clicked => { ClipView.zoom(1.6, -1); }
                }
            }
            if Screen.compact && Watch.on && (!ClipLive.on || ClipLive.can-rewind): VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                IconButton {
                    icon: "\u{E8A3}";
                    label: "Zoom in";
                    tint: ClipView.can-zoom-in ? Theme.text : Theme.dim;
                    clicked => { ClipView.zoom(1 / 1.6, -1); }
                }
            }
            // The chat panel, hidden: show it again (compact: the header's button opens it).
            if ClipChat.available && !Screen.compact && !ClipChat.shown: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                IconButton {
                    icon: "\u{E8BD}";
                    label: "Show the chat";
                    tint: Theme.text;
                    clicked => { ClipChat.shown = true; }
                }
            }
            // Listening volume: the player's own, never what gets saved.
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                IconButton {
                    icon: Watch.muted || Watch.volume == 0 ? "\u{E74F}" : "\u{E767}";
                    label: Watch.muted ? "Unmute" : "Mute";
                    clicked => {
                        Watch.muted = !Watch.muted;
                        Watch.volume-changed();
                    }
                }
            }
            // A live stream below wide windows: the time behind live comes first. So does the
            // time on narrow medium windows (720 cut "0:05.00 / 0:20.00" short): mute stays.
            if !Screen.compact && (Screen.wide || (!ClipLive.on && Screen.width >= 820px)): Slider {
                width: 96px;
                horizontal-stretch: 0;
                minimum: 0;
                maximum: 100;
                value <=> Watch.volume;
                accessible-label: "Volume";
                changed => {
                    Watch.muted = false;
                    Watch.volume-changed();
                }
            }
            if !Screen.compact && !Watch.on && root.marks: GhostButton {
                horizontal-stretch: 0;
                text: "In  " + root.mark(root.in-time);
                clicked => { root.set-in(); }
            }
            if !Screen.compact && !Watch.on && root.marks: GhostButton {
                horizontal-stretch: 0;
                text: "Out  " + root.mark(root.out-time);
                clicked => { root.set-out(); }
            }
        }

        // Compact: In and Out get a row of their own, half each.
        if root.loaded && Screen.compact && !Watch.on && root.marks: HorizontalLayout {
            spacing: 8px;
            GhostButton {
                horizontal-stretch: 1;
                compact: true;
                text: "In  " + root.mark(root.in-time);
                clicked => { root.set-in(); }
            }
            GhostButton {
                horizontal-stretch: 1;
                compact: true;
                text: "Out  " + root.mark(root.out-time);
                clicked => { root.set-out(); }
            }
            // Zoom out / in (no keyboard on a phone).
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                IconButton {
                    icon: "\u{E71F}";
                    label: "Zoom out";
                    tint: ClipView.zoomed ? Theme.text : Theme.dim;
                    clicked => { ClipView.zoom(1.6, -1); }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                IconButton {
                    icon: "\u{E8A3}";
                    label: "Zoom in";
                    tint: ClipView.can-zoom-in ? Theme.text : Theme.dim;
                    clicked => { ClipView.zoom(1 / 1.6, -1); }
                }
            }
            if !root.gif && !ClipLive.on: GhostButton {
                horizontal-stretch: 0;
                compact: true;
                icon: "\u{E8FD}";
                text: root.clips > 0 ? "" + root.clips : "";
                label: root.clips > 0 ? "Clips: " + root.clips : "Clips";
                on: root.clips > 0;
                clicked => { ClipList.open = true; }
            }
        }

        // How busy chat is along the timeline: the busy spikes are the moments to clip.
        if root.loaded && (ClipChat.state == 3 || ClipChat.state == 4) && !Screen.compact: Image {
            height: 18px;
            source: ClipChat.activity;
            image-fit: fill;
        }
        if root.loaded: Timeline {
            duration: root.duration;
            position: root.position;
            in-time <=> root.in-time;
            out-time <=> root.out-time;
            thumbs: root.thumbs;
            wave: root.wave;
            has-video: root.has-video;
            show-keyframes: root.mode == 0 && !root.is-link && !Watch.on;
            handles: !Watch.on;
            keyframe-ticks: root.keyframe-ticks;
            effective-in: root.effective-in;
            marks: Watch.on ? [] : ClipList.items;
            seek(t) => {
                root.seek(t);
                root.focus();
            }
        }

        // Chapters: click one to select it (In and Out jump to its edges).
        if root.loaded && root.chapters.length > 0: ChapterStrip {
            duration: root.duration;
            chapters: root.chapters;
            in-time: root.in-time;
            out-time: root.out-time;
            picked(i) => {
                if !Watch.on {
                    root.in-time = root.chapters[i].start;
                    root.out-time = min(root.chapters[i].end, root.duration);
                }
                root.seek(root.chapters[i].start);
            }
        }

        // Keyboard shortcuts (not on compact: no keyboard on a phone), and the clip list.
        // A live stream: the live row takes the shortcuts' place.
        if root.loaded && !Screen.compact && !ClipPicture.editing && ClipLive.on && !Watch.on: LiveRow { }
        if root.loaded && !Screen.compact && !ClipPicture.editing && !(ClipLive.on && !Watch.on): HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: Watch.on ? "Space play / pause  ·  ← → 5s (Shift 1s)  ·  M mute  ·  + − zoom  ·  Home / End start / end" : "Space play clip  ·  I / O set in / out  ·  A add to clips  ·  R loop " + (root.loop ? "on" : "off") + "  ·  ← → 5s (Shift 1s)  ·  , . frame  ·  + − zoom  ·  Home / End jump to in / out";
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
            ZoomButtons { }
            if !Watch.on && !root.gif && !ClipLive.on: GhostButton {
                horizontal-stretch: 0;
                compact: true;
                icon: "\u{E8FD}";
                text: root.clips > 0 ? "Clips · " + root.clips : "Clips";
                on: root.clips > 0;
                clicked => { ClipList.open = true; }
            }
        }

        // Picture mode: shape, turn, mirror in place of the bottom bar.
        if root.loaded && ClipPicture.editing && !Watch.on: PictureBar { }

        // Link mode: the same quality and file type as the Download page
        // (shared settings, so both pages always agree). Files keep their own.
        if root.loaded && root.is-link && !ClipPicture.editing && Watch.recording-id == 0: QualityRow {
            quality <=> root.quality;
            container-index <=> root.container-index;
            audio-format-index <=> root.audio-format-index;
            spotify: root.gif;
            spotify-text: "Saved as a .gif (X keeps GIFs as short silent videos)";
            format-text: root.gif ? "gif" : Presets.preset == 3 ? root.audio-format : root.video-format;
            changed => { root.settings-changed(); }
            open-settings => { root.open-settings(); }
            show-clip: false;
        }

        // Narrow: the part before, on its own line above the buttons.
        if root.loaded && Watch.on && Watch.recording-id != 0 && !Watch.rec-done && Screen.compact
            && Watch.rec-earlier != "": HorizontalLayout {
            alignment: start;
            if Watch.rec-earlier-link: TextLink {
                text: Watch.rec-earlier;
                clicked => { Watch.earlier(); }
            }
            if !Watch.rec-earlier-link: Text {
                text: Watch.rec-earlier;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        // Watching a recording: clip a part (Start / End, or the last few minutes), or stop it.
        if root.loaded && Watch.on && Watch.recording-id != 0 && !Watch.rec-done: HorizontalLayout {
            spacing: 8px;
            if !Screen.compact: VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: Watch.rec-text;
                    color: Watch.rec-clipping ? Theme.ink : Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                }
                // "Also get the 2 h 19 min before": fetched next to it, joined in front.
                if Watch.rec-earlier != "" && Watch.rec-earlier-link: HorizontalLayout {
                    alignment: start;
                    TextLink {
                        text: Watch.rec-earlier;
                        clicked => { Watch.earlier(); }
                    }
                }
                if Watch.rec-earlier != "" && !Watch.rec-earlier-link: Text {
                    text: Watch.rec-earlier;
                    color: Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            // Start a clip (10 s back), End clip saves it; the recording goes on.
            if !Watch.rec-clipping: PrimaryButton {
                horizontal-stretch: Screen.compact ? 1 : 0;
                text: "Start clip";
                icon: "\u{E7C8}";
                enabled: Watch.rec-can-clip;
                clicked => { QueueActions.clip-start(Watch.recording-id); }
            }
            if Watch.rec-clipping: PrimaryButton {
                horizontal-stretch: Screen.compact ? 1 : 0;
                text: "End clip";
                icon: "\u{E8C6}";
                clicked => { QueueActions.clip-end(Watch.recording-id); }
            }
            LastMenu {
                note: Watch.rec-can-clip ? "" : "You can clip once it has caught up";
                picked(secs) => { QueueActions.clip-last(Watch.recording-id, secs); }
            }
            GhostButton {
                horizontal-stretch: Screen.compact ? 1 : 0;
                text: "Stop";
                label: "Stop and save the recording";
                icon: "\u{E71A}";
                clicked => { QueueActions.stop(Watch.recording-id); }
            }
        }
        // The recording ended: where it is, trim it, or record again while the stream's on.
        if root.loaded && Watch.on && Watch.recording-id != 0 && Watch.rec-done: HorizontalLayout {
            spacing: 8px;
            if !Screen.compact && Watch.rec-saved: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Tag {
                    text: "Saved";
                    kind: 1;
                }
            }
            if !Screen.compact: Text {
                horizontal-stretch: 1;
                text: Watch.rec-text;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
            if Screen.compact && !Watch.rec-saved && !Watch.rec-again: Text {
                horizontal-stretch: 1;
                text: Watch.rec-text;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            if Watch.rec-saved: GhostButton {
                horizontal-stretch: Screen.compact ? 1 : 0;
                text: Screen.compact ? "Show" : "Show file";
                label: "Show the file";
                icon: "\u{E838}";
                clicked => { Watch.show-file(); }
            }
            if Watch.rec-saved: GhostButton {
                horizontal-stretch: Screen.compact ? 1 : 0;
                text: Screen.compact ? "Trim" : "Trim it";
                label: "Trim the recording";
                icon: "\u{E8C6}";
                clicked => { Watch.trim(); }
            }
            if Watch.rec-again: PrimaryButton {
                horizontal-stretch: Screen.compact ? 1 : 0;
                text: Screen.compact ? "Again" : "Record again";
                icon: "\u{E7C8}";
                enabled: root.tools-ready;
                clicked => { Watch.record(); }
            }
        }
        // Watching a live stream, not recording: save the last few minutes, or record.
        if root.loaded && Watch.on && Watch.recording-id == 0 && ClipLive.on: HorizontalLayout {
            spacing: 8px;
            if !Screen.compact: Text {
                horizontal-stretch: 1;
                text: ClipLive.can-rewind ? "Not recording · you can still save the last few minutes"
                    : ClipLive.buffering ? "Not recording · " + ClipLive.buffer-text
                    : ClipLive.buffer-text != "" ? "Not recording · " + ClipLive.buffer-text : "Not recording";
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
            LastMenu {
                note: ClipLive.can-rewind || ClipLive.buffering ? "" : "Nothing kept to clip from yet";
                picked(secs) => { ClipLive.last(secs); }
            }
            RecordMenu {
                enabled: root.tools-ready;
            }
        }
        // Watching: download the whole thing, or start clipping it.
        if root.loaded && Watch.on && Watch.recording-id == 0 && !ClipLive.on: HorizontalLayout {
            spacing: 8px;
            if !Screen.compact: Text {
                horizontal-stretch: 1;
                text: "Nothing is saved until you download it.";
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
            GhostButton {
                horizontal-stretch: Screen.compact ? 1 : 0;
                text: "Clip this";
                icon: "\u{E8C6}";
                clicked => { Watch.clip-this(); }
            }
            PrimaryButton {
                horizontal-stretch: Screen.compact ? 1 : 0;
                text: "Download";
                icon: "\u{E896}";
                enabled: root.tools-ready;
                clicked => { Watch.download(); }
            }
        }

        if root.loaded && Screen.compact && !Watch.on && !ClipPicture.editing: VerticalLayout {
            // Spare height goes to the player, not here.
            vertical-stretch: 0;
            spacing: 8px;
            // Sound and Picture are icons here; a yellow outline says something's set.
            HorizontalLayout {
                spacing: 8px;
                // A .gif has no chips: the icons keep their size, on the left.
                alignment: root.gif-file ? start : stretch;
                if ClipLive.on: LiveRow { }
                if !root.gif-file && !ClipLive.on: ChoiceChips {
                    // What each gets you: copying keeps the quality, re-encoding cuts exactly.
                    options: ["Best quality", "Exact cut"];
                    current <=> root.mode;
                }
                if root.has-audio && !root.gif: VerticalLayout {
                    alignment: start;
                    horizontal-stretch: 0;
                    GhostButton {
                        compact: true;
                        icon: "\u{E767}";
                        label: ClipSound.button-text;
                        on: ClipSound.button-text != "Sound: as is";
                        clicked => { ClipSound.open = true; }
                    }
                }
                if root.has-video && !root.gif: VerticalLayout {
                    alignment: start;
                    horizontal-stretch: 0;
                    GhostButton {
                        compact: true;
                        icon: "\u{E7A8}";
                        label: ClipPicture.button-text;
                        on: root.picture-changed;
                        clicked => {
                            ClipPicture.editing = true;
                            ClipPicture.changed();
                        }
                    }
                }
                if ClipChat.available && !root.gif: VerticalLayout {
                    alignment: start;
                    horizontal-stretch: 0;
                    GhostButton {
                        compact: true;
                        icon: "\u{E8BD}";
                        label: ClipChat.button-text;
                        on: ClipChat.set;
                        clicked => { ClipChat.open = true; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                min-height: 30px;
                Text {
                    horizontal-stretch: 1;
                    text: root.status-text;
                    color: root.status-warn ? Theme.warn : Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.status-warn: GhostButton {
                    horizontal-stretch: 0;
                    compact: true;
                    text: "Snap to keyframe";
                    clicked => {
                        root.in-time = root.effective-in;
                        root.seek(root.in-time);
                    }
                }
                if root.has-output && !root.exporting: GhostButton {
                    horizontal-stretch: 0;
                    compact: true;
                    text: "Show file";
                    icon: "\u{E838}";
                    clicked => { root.show-output(); }
                }
                if root.is-link && root.status != "" && !root.has-output: GhostButton {
                    horizontal-stretch: 0;
                    compact: true;
                    text: "View queue";
                    clicked => { root.view-queue(); }
                }
            }
            ExportButton {
                text: root.exporting ? "Cancel  " + Math.round(root.export-progress * 100) + "%" : root.export-text;
                icon: root.exporting ? "" : root.is-link ? "\u{E896}" : "\u{E8C6}";
                enabled: (root.clips > 0 || root.out-time > root.in-time) && root.tools-ready && (!ClipLive.on || ClipLive.can-rewind);
                has-menu: root.gif-menu;
                menu-text: root.export-text;
                menu-icon: root.is-link ? "\u{E896}" : "\u{E8C6}";
                clicked => {
                    if root.exporting {
                        root.cancel-export();
                    } else {
                        root.export-clip();
                    }
                }
            }
        }

        // 1200 px and up: one bar. Narrower: what it'll do (and its fixes) on a line above the buttons,
        // so neither squeezes the other.
        if root.loaded && !Screen.compact && !Watch.on && !ClipPicture.editing: VerticalLayout {
            vertical-stretch: 0;
            spacing: 6px;
            if !root.one-bar: HorizontalLayout {
                spacing: 8px;
                min-height: 30px;
                Text {
                    horizontal-stretch: 1;
                    text: root.status-text;
                    color: root.status-warn ? Theme.warn : Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.status-warn: GhostButton {
                    horizontal-stretch: 0;
                    compact: true;
                    text: "Snap to keyframe";
                    clicked => {
                        root.in-time = root.effective-in;
                        root.seek(root.in-time);
                    }
                }
                if root.has-output && !root.exporting: GhostButton {
                    horizontal-stretch: 0;
                    compact: true;
                    text: "Show file";
                    icon: "\u{E838}";
                    clicked => { root.show-output(); }
                }
                if root.is-link && root.status != "" && !root.has-output: GhostButton {
                    horizontal-stretch: 0;
                    compact: true;
                    text: "View queue";
                    clicked => { root.view-queue(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                // Medium: short chip names (the line above says what they mean).
                if !root.gif-file && !ClipLive.on: ChoiceChips {
                    horizontal-stretch: 0;
                    options: root.one-bar ? ["Best quality · may start early", "Exact cut · re-encoded"] : ["Best quality", "Exact cut"];
                    current <=> root.mode;
                }
                if root.has-audio && !root.gif: GhostButton {
                    horizontal-stretch: 0;
                    text: root.one-bar ? ClipSound.button-text : ClipSound.short-text;
                    label: ClipSound.button-text;
                    icon: "\u{E767}";
                    on: ClipSound.button-text != "Sound: as is";
                    clicked => { ClipSound.open = true; }
                }
                if root.has-video && !root.gif: GhostButton {
                    horizontal-stretch: 0;
                    text: root.one-bar ? ClipPicture.button-text : ClipPicture.short-text;
                    label: ClipPicture.button-text;
                    icon: "\u{E7A8}";
                    on: root.picture-changed;
                    clicked => {
                        ClipPicture.editing = true;
                        ClipPicture.changed();
                    }
                }
                // Below 760 px the bar is full: the chat panel's own button opens the dialog.
                if ClipChat.available && !root.gif && Screen.width >= 760px: GhostButton {
                    horizontal-stretch: 0;
                    // Narrow medium windows: an icon (the line above says what's set).
                    text: root.one-bar ? ClipChat.button-text : Screen.width >= 840px ? ClipChat.short-text : "";
                    label: ClipChat.button-text;
                    icon: "\u{E8BD}";
                    on: ClipChat.set;
                    clicked => { ClipChat.open = true; }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.one-bar ? root.status-text : "";
                    color: root.status-warn ? Theme.warn : Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
                if root.one-bar && root.status-warn: GhostButton {
                    horizontal-stretch: 0;
                    text: "Snap to keyframe";
                    clicked => {
                        root.in-time = root.effective-in;
                        root.seek(root.in-time);
                    }
                }
                if root.one-bar && root.has-output && !root.exporting: GhostButton {
                    horizontal-stretch: 0;
                    text: "Show file";
                    icon: "\u{E838}";
                    clicked => { root.show-output(); }
                }
                if root.one-bar && root.is-link && root.status != "" && !root.has-output: GhostButton {
                    horizontal-stretch: 0;
                    text: "View queue";
                    clicked => { root.view-queue(); }
                }
                ExportButton {
                    horizontal-stretch: 0;
                    text: root.exporting ? "Cancel  " + Math.round(root.export-progress * 100) + "%" : root.export-text;
                    icon: root.exporting ? "" : root.is-link ? "\u{E896}" : "\u{E8C6}";
                    enabled: (root.clips > 0 || root.out-time > root.in-time) && root.tools-ready && (!ClipLive.on || ClipLive.can-rewind);
                    has-menu: root.gif-menu;
                    menu-text: root.export-text;
                    menu-icon: root.is-link ? "\u{E896}" : "\u{E8C6}";
                    clicked => {
                        if root.exporting {
                            root.cancel-export();
                        } else {
                            root.export-clip();
                        }
                    }
                }
            }
        }
    }
    if root.chat-tall: VerticalLayout {
        horizontal-stretch: 0;
        padding-top: 28px;
        padding-bottom: 28px;
        ChatPanel {
            width: 336px;
            roomy: true;
            very-roomy: true;
        }
    }
    }

    // Compact: the chat over the lower part of the page (closed with its ×).
    if ClipChat.sheet && root.loaded && ClipChat.available: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        // keyboard: the sheet's own × closes it.
        TouchArea {
            clicked => { ClipChat.sheet = false; }
        }
        ChatPanel {
            x: 0;
            y: parent.height * 0.25;
            width: parent.width;
            height: parent.height * 0.75;
            sheet: true;
            closed => { ClipChat.sheet = false; }
        }
    }
}
