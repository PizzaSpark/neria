import { LineEdit, ComboBox, SpinBox, ScrollView } from "std-widgets.slint";
import { Theme, Screen } from "../theme.slint";
import { Formats } from "../types.slint";
import { Accounts, Background, Names, Bulk, Following, FollowItem, Music } from "../globals.slint";
import { PrimaryButton, GhostButton, IconButton, Icon, Bar, SectionTitle, Hint, Tag, Tick, KeyPress, TextLink, Divider } from "../widgets.slint";

// One group of settings under a small heading.
component Group inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    SectionTitle { text: root.title; }
    @children
}

// A followed channel or playlist: name, how it's going, and what you can do.
component FollowRow inherits VerticalLayout {
    in property <FollowItem> item;
    spacing: 6px;
    padding-bottom: 10px;
    Text {
        text: root.item.name;
        color: root.item.paused ? Theme.muted : Theme.ink;
        font-size: 13.5px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        text: root.item.detail;
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
    }
    // Compact: two lines, so the four controls fit a 400px window.
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        ComboBox {
            width: 104px;
            model: ["Hourly", "Daily", "Weekly"];
            current-index: root.item.every;
            selected => { Following.every(root.item.url, self.current-index); }
        }
        GhostButton {
            compact: true;
            text: root.item.checking ? "Checking…" : "Check now";
            clicked => { Following.check-now(root.item.url); }
        }
        if !Screen.compact: GhostButton {
            compact: true;
            text: root.item.paused ? "Resume" : "Pause";
            clicked => { Following.pause(root.item.url, !root.item.paused); }
        }
        if !Screen.compact: GhostButton {
            compact: true;
            text: "Unfollow";
            clicked => { Following.unfollow(root.item.url); }
        }
    }
    if Screen.compact: HorizontalLayout {
        spacing: 6px;
        alignment: start;
        GhostButton {
            compact: true;
            text: root.item.paused ? "Resume" : "Pause";
            clicked => { Following.pause(root.item.url, !root.item.paused); }
        }
        GhostButton {
            compact: true;
            text: "Unfollow";
            clicked => { Following.unfollow(root.item.url); }
        }
    }
    Divider { }
}

// A label on the left, its control (150px wide) on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    Text {
        text: root.label;
        color: Theme.ink;
        font-family: Theme.body;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    @children
}

// A section in the list on the left of the drawer: icon and name, outlined when open.
component SectionLink inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    // The compact strip is words only, so all five fit at the 400px minimum.
    in property <bool> show-icon: true;
    callback clicked();
    height: 38px;
    border-radius: 9px;
    border-width: 2px;
    border-color: root.active ? Theme.line-strong : transparent;
    background: root.active ? Theme.bg : ta.has-hover ? Theme.raised : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }
    KeyPress {
        radius: 9px;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.show-icon ? 10px : 9px;
        padding-right: root.show-icon ? 8px : 9px;
        spacing: 9px;
        if root.show-icon: Icon {
            text: root.icon;
            font-size: 14px;
            color: root.active ? Theme.ink : Theme.dim;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Theme.ink : Theme.muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// The Settings drawer, sliding over the right edge of the window. Put it over the whole
// window: clicking the dimmed part closes it. Sections on the left, one shown at a time.
// Compact windows: a full sheet, sections as a strip along the top (it scrolls sideways).
// Clip and Compress have no settings of their own: clips from links use the Download
// formats, and both pages pick everything per file.
export component SettingsDrawer inherits Rectangle {
    // 0 Download, 1 Spotify, 2 Network, 3 General (closing, notifications, theme), 4 About.
    in-out property <int> section;

    in property <string> output-dir;
    in-out property <bool> sort-folders;
    in-out property <bool> number-items;
    in-out property <int> container-index;
    in-out property <bool> prefer-h264;
    in-out property <bool> embed-subs;
    in-out property <int> audio-format-index;
    in-out property <bool> embed-thumbnail;
    in-out property <bool> save-thumbnail;
    in-out property <bool> embed-metadata;
    in-out property <bool> sponsorblock;
    in-out property <bool> allow-playlists;
    in-out property <bool> x-gifs-as-gif;
    in-out property <int> cookies-index;
    in-out property <string> rate-limit;
    in-out property <int> max-concurrent;
    in-out property <bool> lyrics;
    in-out property <bool> verify-audio;
    in-out property <bool> spotify-explain;
    in-out property <string> spotify-client-id;
    in-out property <string> spotify-client-secret;
    in-out property <int> theme-index;
    in-out property <string> filename-template;
    in-out property <string> extra-args;
    in-out property <bool> check-updates;

    // About and updates (update-state: 0 idle, 1 checking, 2 downloading, 3 ready, 4 failed)
    in property <string> app-version;
    in property <int> update-state;
    in property <string> update-version;
    in property <string> update-notes;
    in property <string> update-status;
    in property <float> update-progress;
    in property <string> tool-versions;
    in property <string> tools-outdated;
    in property <string> tools-status;
    in property <bool> tools-updating;

    callback close();
    callback choose-output();
    callback open-output();
    callback settings-changed();
    callback theme-changed();
    callback update-install();
    callback update-restart();
    callback update-check();
    callback tools-update();
    callback copy-report();

    background: Screen.compact ? transparent : Theme.scrim;
    // keyboard: Esc closes the drawer.
    TouchArea {
        clicked => { root.close(); }
    }

    changed section => { scroll.content-y = 0; }

    property <[{icon: string, label: string}]> sections: [
        { icon: "\u{E896}", label: "Download" },
        { icon: "\u{E728}", label: "Following" },
        { icon: "\u{E8D6}", label: "Spotify" },
        { icon: "\u{E774}", label: "Network" },
        { icon: "\u{E790}", label: "General" },
        { icon: "\u{E946}", label: "About" },
    ];

    // Esc closes it, from anywhere inside; it takes the keyboard when it opens.
    init => { keys.focus(); }
    keys := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            reject
        }
        Rectangle {
            x: Screen.compact ? 0 : parent.width - self.width;
            y: 0;
            // Wide enough for the section list plus the old 400px column; on medium windows
            // it leaves a strip of the page showing so it still reads as a drawer.
            width: Screen.compact ? parent.width : min(600px, parent.width - 120px);
            height: parent.height;
            background: Theme.surface;
            border-width: Screen.compact ? 0 : 1px;
            border-color: Theme.border;
            TouchArea { }

            VerticalLayout {
                padding-top: Screen.compact ? 16px : 22px;
                spacing: Screen.compact ? 10px : 14px;

                HorizontalLayout {
                    padding-left: Screen.compact ? 16px : 22px;
                    padding-right: Screen.compact ? 12px : 22px;
                    Text {
                        text: "Settings";
                        color: Theme.text;
                        font-family: Theme.display;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: "\u{E711}";
                        label: "Close Settings";
                        clicked => { root.close(); }
                    }
                }

                if Screen.compact: VerticalLayout {
                    Flickable {
                        height: 46px;
                        content-width: max(self.width, strip.preferred-width);
                        // Too narrow for all five: keep the open one in view (Appearance and
                        // About sit at the end).
                        function reveal() {
                            self.content-x = root.section >= 4 ? min(0px, self.width - self.content-width) : 0px;
                        }
                        init => { self.reveal(); }
                        changed width => { self.reveal(); }
                        changed content-width => { self.reveal(); }
                        strip := HorizontalLayout {
                            alignment: start;
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-bottom: 8px;
                            spacing: 2px;
                            for s[i] in root.sections: SectionLink {
                                show-icon: false;
                                icon: s.icon;
                                label: s.label;
                                active: root.section == i;
                                clicked => { root.section = i; }
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                }

                HorizontalLayout {
                    vertical-stretch: 1;

                    if !Screen.compact: VerticalLayout {
                        width: 150px;
                        padding-left: 14px;
                        padding-right: 12px;
                        padding-bottom: 22px;
                        spacing: 4px;
                        alignment: start;
                        for s[i] in root.sections: SectionLink {
                            icon: s.icon;
                            label: s.label;
                            active: root.section == i;
                            clicked => { root.section = i; }
                        }
                    }

                    if !Screen.compact: Rectangle {
                        width: 1px;
                        background: Theme.line;
                    }

                    scroll := ScrollView {
                        horizontal-stretch: 1;

                        // ---- Download ----
                        if root.section == 0: VerticalLayout {
                            spacing: 22px;
                            padding-top: Screen.compact ? 14px : 0px;
                            padding-left: Screen.compact ? 16px : 20px;
                            padding-right: Theme.lane;
                            padding-bottom: 22px;
                            alignment: start;

                            Group {
                                title: "Save to";
                                Text {
                                    text: root.output-dir;
                                    color: Theme.muted;
                                    font-family: Theme.mono;
                                    font-size: 11.5px;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    GhostButton {
                                        text: "Change…";
                                        clicked => { root.choose-output(); }
                                    }
                                    GhostButton {
                                        text: "Open folder";
                                        clicked => { root.open-output(); }
                                    }
                                }
                                Tick {
                                    text: "Sort into Audio, Video and Photos folders";
                                    checked <=> root.sort-folders;
                                    toggled => { root.settings-changed(); }
                                }
                                Hint {
                                    text: "Playlists and posts get a folder of their own, inside Audio, Video or Photos when everything in it is one kind.";
                                }
                                Tick {
                                    text: "Number playlist and post items in order (01, 02…)";
                                    checked <=> root.number-items;
                                    toggled => { root.settings-changed(); }
                                }
                                Tick {
                                    text: "Offer links I copy in other apps";
                                    checked <=> Bulk.watch;
                                    toggled => { Bulk.watch-changed(); }
                                }
                                Hint {
                                    text: "A strip on the Download page (a notification while Neria is in the tray) lets you download or preview it. Neria only looks when something is copied, and only at a lone link.";
                                }
                            }

                            Group {
                                title: "Video";
                                SettingRow {
                                    label: "Container";
                                    ComboBox {
                                        width: 150px;
                                        model: Formats.containers;
                                        current-index <=> root.container-index;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                                Tick {
                                    text: "Prefer H.264 (plays everywhere, max 1080p on YouTube)";
                                    checked <=> root.prefer-h264;
                                    toggled => { root.settings-changed(); }
                                }
                                Tick {
                                    text: "Embed subtitles";
                                    checked <=> root.embed-subs;
                                    toggled => { root.settings-changed(); }
                                }
                            }

                            Group {
                                title: "Audio only";
                                SettingRow {
                                    label: "Convert to";
                                    ComboBox {
                                        width: 150px;
                                        model: Formats.audio;
                                        current-index <=> root.audio-format-index;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                                Hint { text: "Spotify songs are saved in this format too."; }
                            }

                            Group {
                                title: "Extras";
                                Tick {
                                    text: "Embed thumbnail as cover art";
                                    checked <=> root.embed-thumbnail;
                                    toggled => { root.settings-changed(); }
                                }
                                Tick {
                                    text: "Also save the thumbnail as a .jpg";
                                    checked <=> root.save-thumbnail;
                                    toggled => { root.settings-changed(); }
                                }
                                Tick {
                                    text: "Embed title, artist and other metadata";
                                    checked <=> root.embed-metadata;
                                    toggled => { root.settings-changed(); }
                                }
                                Tick {
                                    text: "Cut out sponsor segments (SponsorBlock)";
                                    checked <=> root.sponsorblock;
                                    toggled => { root.settings-changed(); }
                                }
                                Tick {
                                    text: "Download whole playlists";
                                    checked <=> root.allow-playlists;
                                    toggled => { root.settings-changed(); }
                                }
                                Tick {
                                    text: "Save X (Twitter) GIFs as real .gif files";
                                    checked <=> root.x-gifs-as-gif;
                                    toggled => { root.settings-changed(); }
                                }
                            }

                            Group {
                                title: "File names";
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: Names.summary;
                                        color: Theme.ink;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    GhostButton {
                                        horizontal-stretch: 0;
                                        compact: true;
                                        text: "Change";
                                        clicked => { Names.show(); }
                                    }
                                }
                                Hint { text: "For single videos. Items picked from a playlist or post are named by their number and title."; }
                            }
                        }

                        // ---- Following ----
                        if root.section == 1: VerticalLayout {
                            spacing: 22px;
                            padding-top: Screen.compact ? 14px : 0px;
                            padding-left: Screen.compact ? 16px : 20px;
                            padding-right: Theme.lane;
                            padding-bottom: 22px;
                            alignment: start;

                            Group {
                                title: "Following";
                                if Following.items.length == 0: Hint {
                                    text: "Nothing yet. Paste a channel or playlist link and press Follow under its preview: Neria then downloads its new uploads by itself.";
                                }
                                for f in Following.items: FollowRow { item: f; }
                            }
                            Hint {
                                text: "Only uploads that are new since you followed are downloaded, into a folder named after the channel or playlist, in the kind of file you had picked. Checks run while Neria is open (the tray counts); one that was missed runs when Neria starts.";
                            }
                        }

                        // ---- Spotify ----
                        if root.section == 2: VerticalLayout {
                            spacing: 22px;
                            padding-top: Screen.compact ? 14px : 0px;
                            padding-left: Screen.compact ? 16px : 20px;
                            padding-right: Theme.lane;
                            padding-bottom: 22px;
                            alignment: start;

                            Group {
                                title: "Songs";
                                Hint { text: "Song info comes from Spotify, audio from YouTube Music. Songs use the \"Audio only\" format under Download."; }
                                Tick {
                                    text: "Number playlist songs (01 Artist - Title)";
                                    checked <=> Music.number-songs;
                                    toggled => { root.settings-changed(); }
                                }
                                Hint { text: "So the folder sorts in playlist order. Songs you already have are renamed, not downloaded again. Albums are always numbered."; }
                                Tick {
                                    text: "Check each song against Spotify's 30 s preview";
                                    checked <=> root.verify-audio;
                                    toggled => { root.settings-changed(); }
                                }
                                Hint { text: "Catches re-recordings, live and cover versions by their sound, and tries other versions automatically. Adds about a second per song."; }
                                Tick {
                                    text: "Explain where the audio comes from before downloading";
                                    checked <=> root.spotify-explain;
                                    toggled => { root.settings-changed(); }
                                }
                            }

                            Group {
                                title: "Lyrics";
                                Tick {
                                    text: "Add lyrics (inside the song + a synced .lrc file next to it)";
                                    checked <=> root.lyrics;
                                    toggled => { root.settings-changed(); }
                                }
                                if root.lyrics: Hint { text: "Neria asks these in order and stops at the first synced lyrics. Each song's row says what it found."; }
                                if root.lyrics: Tick {
                                    text: "LRCLIB: synced, free and open";
                                    checked <=> Music.lrclib;
                                    toggled => { root.settings-changed(); }
                                }
                                if root.lyrics: Tick {
                                    text: "Spotify's own synced lyrics (Musixmatch): needs a Spotify sign-in";
                                    checked <=> Music.spotify;
                                    toggled => { root.settings-changed(); }
                                }
                                // The warning comes before any sign-in, and stays while it's on.
                                if root.lyrics && Music.spotify: HorizontalLayout {
                                    alignment: start;
                                    Tag {
                                        text: "Use a spare account";
                                        kind: 2;
                                    }
                                }
                                if root.lyrics && Music.spotify: Hint {
                                    text: "This reads lyrics the way Spotify's web player does, which is against Spotify's terms: the account could be restricted or banned. Sign in with a spare (burner) Spotify account, never your main one. Neria uses it for lyrics only, never for audio, and only when LRCLIB has no synced lyrics.";
                                }
                                if root.lyrics && Music.spotify && !Music.spotify-signed-in: HorizontalLayout {
                                    alignment: start;
                                    GhostButton {
                                        text: Accounts.busy ? "Signing in…" : "Sign in to Spotify…";
                                        icon: "\u{E77B}";
                                        clicked => { Accounts.sign-in("spotify.com"); }
                                    }
                                }
                                if root.lyrics && Music.spotify && Music.spotify-signed-in: HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Icon {
                                        text: "\u{E73E}";
                                        color: Theme.ok;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Signed in to Spotify";
                                        color: Theme.ink;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    TextLink {
                                        text: "Sign out";
                                        clicked => { Accounts.sign-out("spotify.com"); }
                                    }
                                }
                                if root.lyrics: Tick {
                                    text: "Genius: plain text only";
                                    checked <=> Music.genius;
                                    toggled => { root.settings-changed(); }
                                }
                                if root.lyrics: Tick {
                                    text: "Synced lyrics only (never save plain text)";
                                    checked <=> Music.synced-only;
                                    toggled => { root.settings-changed(); }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    TextLink {
                                        text: "Add lyrics to songs I already have…";
                                        icon: "\u{E8B7}";
                                        clicked => { Music.add-lyrics(); }
                                    }
                                }
                                Hint { text: "Pick a folder of songs (tagged with artist and title, like Neria's): each gets lyrics inside it and a .lrc next to it. Songs that have a .lrc already are skipped."; }
                            }

                            Group {
                                title: "Your own Spotify key";
                                Hint { text: "Optional: your own Spotify app (developer.spotify.com → Create app) unlocks playlists over 100 songs. Never shared, stored only in settings.json next to Neria."; }
                                LineEdit {
                                    placeholder-text: "Client ID";
                                    text <=> root.spotify-client-id;
                                    edited => { root.settings-changed(); }
                                }
                                LineEdit {
                                    placeholder-text: "Client secret";
                                    input-type: password;
                                    text <=> root.spotify-client-secret;
                                    edited => { root.settings-changed(); }
                                }
                            }
                        }

                        // ---- Network ----
                        if root.section == 3: VerticalLayout {
                            spacing: 22px;
                            padding-top: Screen.compact ? 14px : 0px;
                            padding-left: Screen.compact ? 16px : 20px;
                            padding-right: Theme.lane;
                            padding-bottom: 22px;
                            alignment: start;

                            Group {
                                title: "Signed in";
                                Hint {
                                    text: "For private, age-restricted and members-only videos. Sign in from a link's problem, or here. Cookies stay in Neria's folder and are only sent to the site they came from.";
                                }
                                for s in Accounts.sites: VerticalLayout {
                                    HorizontalLayout {
                                        spacing: 10px;
                                        padding-top: 7px;
                                        padding-bottom: 7px;
                                        Text {
                                            text: s.name;
                                            color: Theme.ink;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                        Text {
                                            text: s.detail;
                                            color: Theme.muted;
                                            font-family: Theme.mono;
                                            font-size: 11.5px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        TextLink {
                                            text: "Sign out";
                                            clicked => { Accounts.sign-out(s.site); }
                                        }
                                    }
                                    Divider { }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    // As tall as the button's face (41px), level with it.
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        height: 41px;
                                        y: 0;
                                        placeholder-text: "A site, e.g. vimeo.com";
                                        text <=> Accounts.other-site;
                                        accepted => { Accounts.sign-in(Accounts.other-site); }
                                    }
                                    GhostButton {
                                        horizontal-stretch: 0;
                                        text: Accounts.busy ? "Signing in…" : "Sign in";
                                        icon: "\u{E77B}";
                                        clicked => { Accounts.sign-in(Accounts.other-site); }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    TextLink {
                                        text: "Import a cookies.txt file";
                                        icon: "\u{E8E5}";
                                        clicked => { Accounts.import-file(); }
                                    }
                                }
                            }

                            Group {
                                title: "Or use a browser's cookies";
                                SettingRow {
                                    label: "Borrow sign-in from";
                                    ComboBox {
                                        width: 150px;
                                        model: ["None", "Chrome", "Edge", "Firefox", "Brave", "Opera", "Vivaldi"];
                                        current-index <=> root.cookies-index;
                                        selected => { root.settings-changed(); }
                                    }
                                }
                                Hint { text: "For sites you haven't signed in to above. Also helps with \"confirm you're not a bot\"."; }
                                // Chromium browsers lock their cookie file while open and encrypt it.
                                // Two separate `if`s: wrapped text nested inside a sub-layout gets
                                // measured as one line and squashes the next group.
                                if root.cookies-index == 1 || root.cookies-index == 2 || root.cookies-index >= 4: HorizontalLayout {
                                    alignment: start;
                                    Tag {
                                        text: "Heads-up";
                                        kind: 2;
                                    }
                                }
                                if root.cookies-index == 1 || root.cookies-index == 2: Hint {
                                    text: "This browser usually blocks it: it locks its cookies while open and encrypts them. Firefox works best: sign in there and pick Firefox.";
                                }
                                if root.cookies-index >= 4: Hint {
                                    text: (root.cookies-index == 4 ? "Brave" : root.cookies-index == 5 ? "Opera" : "Vivaldi")
                                        + " locks its cookies while it's open: close it fully before downloading. Firefox works even while open.";
                                }
                            }

                            Group {
                                title: "Speed";
                                SettingRow {
                                    label: "Speed limit";
                                    LineEdit {
                                        width: 150px;
                                        placeholder-text: "e.g. 5M";
                                        text <=> root.rate-limit;
                                        edited => { root.settings-changed(); }
                                    }
                                }
                                Hint { text: "Per download, in bytes a second: 500K, 5M. Empty means no limit."; }
                                SettingRow {
                                    label: "Downloads at once";
                                    SpinBox {
                                        width: 150px;
                                        minimum: 1;
                                        maximum: 8;
                                        value <=> root.max-concurrent;
                                        edited => { root.settings-changed(); }
                                    }
                                }
                            }

                            Group {
                                title: "Expert";
                                Text {
                                    text: "Extra yt-dlp arguments";
                                    color: Theme.ink;
                                    font-family: Theme.body;
                                    font-size: 13px;
                                }
                                LineEdit {
                                    placeholder-text: "e.g. --write-description";
                                    text <=> root.extra-args;
                                    edited => { root.settings-changed(); }
                                }
                                Hint { text: "Added to every download. Leave empty unless you know yt-dlp."; }
                            }
                        }

                        // ---- General: closing, notifications, theme ----
                        if root.section == 4: VerticalLayout {
                            spacing: 22px;
                            padding-top: Screen.compact ? 14px : 0px;
                            padding-left: Screen.compact ? 16px : 20px;
                            padding-right: Theme.lane;
                            padding-bottom: 22px;
                            alignment: start;

                            Group {
                                title: "When I close Neria";
                                SettingRow {
                                    label: "With downloads going";
                                    ComboBox {
                                        width: 150px;
                                        model: ["Ask", "Keep going in the tray", "Stop and quit"];
                                        current-index <=> Background.close-action;
                                        selected => { Background.settings-changed(); }
                                    }
                                }
                                Hint { text: "In the tray (next to the clock) downloads, Download later and followed channels keep going. With nothing going, closing just quits."; }
                            }

                            Group {
                                title: "Notifications";
                                Tick {
                                    text: "Tell me when a download, clip or compress finishes or fails";
                                    checked <=> Background.notify;
                                    toggled => { Background.settings-changed(); }
                                }
                                if Background.notify: Tick {
                                    text: "Only when I'm not looking at Neria";
                                    checked <=> Background.notify-unfocused;
                                    toggled => { Background.settings-changed(); }
                                }
                                if Background.notify: SettingRow {
                                    label: "Sound when done";
                                    ComboBox {
                                        width: 150px;
                                        model: ["Neria chime", "Windows' sound", "None"];
                                        current-index <=> Background.sound-done;
                                        selected => {
                                            Background.settings-changed();
                                            Background.test-sound(false);
                                        }
                                    }
                                }
                                if Background.notify: SettingRow {
                                    label: "Sound when it fails";
                                    ComboBox {
                                        width: 150px;
                                        model: ["Low chime", "Windows' sound", "None"];
                                        current-index <=> Background.sound-failed;
                                        selected => {
                                            Background.settings-changed();
                                            Background.test-sound(true);
                                        }
                                    }
                                }
                                if Background.notify: Hint { text: "A group (a playlist, an album) sends one: \"12 songs saved\"."; }
                            }

                            Group {
                                title: "Theme";
                                SettingRow {
                                    label: "Colours";
                                    ComboBox {
                                        width: 150px;
                                        model: ["Same as Windows", "Dark", "Light"];
                                        current-index <=> root.theme-index;
                                        selected => {
                                            root.theme-changed();
                                            root.settings-changed();
                                        }
                                    }
                                }
                                Hint { text: "\"Same as Windows\" follows your app colour in Windows settings."; }
                            }
                        }

                        // ---- About ----
                        if root.section == 5: VerticalLayout {
                            spacing: 22px;
                            padding-top: Screen.compact ? 14px : 0px;
                            padding-left: Screen.compact ? 16px : 20px;
                            padding-right: Theme.lane;
                            padding-bottom: 22px;
                            alignment: start;

                            Group {
                                title: "Neria " + root.app-version;
                                if root.update-status != "": Text {
                                    text: root.update-status;
                                    color: root.update-state == 4 ? Theme.danger : root.update-version != "" ? Theme.accent-hi : Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                if root.update-version != "" && root.update-notes != "": Rectangle {
                                    border-radius: 8px;
                                    background: Theme.surface-hi;
                                    VerticalLayout {
                                        padding: 10px;
                                        Hint { text: root.update-notes; }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    if root.update-version != "" && (root.update-state == 0 || root.update-state == 4): PrimaryButton {
                                        text: "Update to " + root.update-version;
                                        clicked => { root.update-install(); }
                                    }
                                    if root.update-state == 3: PrimaryButton {
                                        text: "Restart now";
                                        clicked => { root.update-restart(); }
                                    }
                                    if root.update-state == 0 || root.update-state == 4: GhostButton {
                                        text: "Check now";
                                        icon: "\u{E72C}";
                                        clicked => { root.update-check(); }
                                    }
                                }
                                if root.update-state == 2: Bar { value: root.update-progress; }
                                Tick {
                                    text: "Check for updates when Neria starts";
                                    checked <=> root.check-updates;
                                    toggled => { root.settings-changed(); }
                                }
                            }

                            Group {
                                title: "Tools";
                                Text {
                                    text: root.tool-versions == "" ? "Checking tool versions…" : root.tool-versions;
                                    color: Theme.muted;
                                    font-family: Theme.mono;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                }
                                Hint { text: "yt-dlp updates itself daily. FFmpeg, Deno and libmpv are offered an update once a newer build exists and yours is over a month old."; }
                                if root.tools-status != "": Text {
                                    text: root.tools-status;
                                    color: root.tools-outdated != "" ? Theme.accent-hi : Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                if root.tools-outdated != "" && !root.tools-updating: HorizontalLayout {
                                    alignment: start;
                                    GhostButton {
                                        text: "Update tools";
                                        icon: "\u{E896}";
                                        clicked => { root.tools-update(); }
                                    }
                                }
                            }

                            Group {
                                title: "Report a problem";
                                Hint { text: "Something not working? Copy a report and paste it in a message. It has the versions above and your settings, never your Spotify key. Failed downloads have their own report button (bug icon) with the link and log."; }
                                HorizontalLayout {
                                    alignment: start;
                                    GhostButton {
                                        text: "Copy report";
                                        icon: "\u{EBE8}";
                                        clicked => { root.copy-report(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
