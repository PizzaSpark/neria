import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Screen } from "../theme.slint";
import { PrimaryButton, GhostButton, IconButton, TextLink, Bar, ChoiceChips, PageTitle, Notice, Divider, Thumb, Tick, Tag, Icon, ChoiceRow, CompareSlider, KeyPress } from "../widgets.slint";
import { RecentList } from "../components/recent-list.slint";
import { TrimStrip } from "../components/trim-strip.slint";
import { RecentItem } from "../types.slint";
import { Compress, CmpFile } from "../globals.slint";

// A small muted heading over a group of options ("Format", "Picture"…).
component OptionHead inherits Text {
    color: Theme.muted;
    font-family: Theme.body;
    font-size: 12px;
}

// One file in the list when several are open: thumbnail, name, length and size, what
// happens to it (tag + hint), a meter while it runs; × to take it off, or Show when saved.
component FileRow inherits Rectangle {
    in property <CmpFile> file;
    in property <bool> running;
    callback remove();
    callback show();
    min-height: row.preferred-height;
    Rectangle {
        x: 0;
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: Theme.line;
    }
    row := HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;
        Thumb {
            width: 64px;
            height: 36px;
            source: root.file.thumb;
            background: Theme.video;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.file.name;
                color: Theme.ink;
                font-size: 14px;
                font-weight: 500;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 0;
                    text: root.file.meta;
                    color: Theme.muted;
                    font-family: Theme.mono;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }
                if root.file.tag != "": Tag {
                    horizontal-stretch: 0;
                    text: root.file.tag;
                    kind: root.file.state == 2 || root.file.state == 3 ? 1 : root.file.state == 4 || root.file.state == 5 ? 3 : root.file.state == 1 ? 4 : 0;
                }
                if Screen.compact: Rectangle { horizontal-stretch: 1; }
                if !Screen.compact: Text {
                    horizontal-stretch: 1;
                    text: root.file.detail;
                    color: root.file.state == 4 || root.file.state == 5 ? Theme.bad : Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if Screen.compact && root.file.detail != "": Text {
                text: root.file.detail;
                color: root.file.state == 4 || root.file.state == 5 ? Theme.bad : Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.file.state == 1: Bar {
                value: root.file.progress;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            if root.file.state == 2: GhostButton {
                compact: true;
                text: Screen.compact ? "" : "Show";
                icon: "\u{E838}";
                label: "Show in folder";
                clicked => { root.show(); }
            }
            if root.file.state != 2 && !root.running: IconButton {
                icon: "\u{E711}";
                label: "Take it off the list";
                clicked => { root.remove(); }
            }
        }
    }
}

// The goals (direction A in design/compress-track.html): every goal a row with what it'll
// look like and its size for this file, so you compare before picking.
component Goals inherits VerticalLayout {
    spacing: 0px;
    Divider { }
    for g[i] in Compress.goals: ChoiceRow {
        title: g.name;
        hint: g.hint;
        value: g.size;
        warn: g.warn;
        selected: Compress.goal == i;
        clicked => {
            Compress.goal = i;
            Compress.changed();
        }
    }
    if Compress.goal == 5: HorizontalLayout {
        padding-top: 10px;
        padding-left: 36px;
        spacing: 8px;
        LineEdit {
            width: 90px;
            placeholder-text: "MB";
            text <=> Compress.custom-mb;
            edited => { Compress.changed(); }
        }
        Text {
            text: "MB";
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// The 10 s sample, played here: Now (the file as it is) or After (compressed, with the
// volume evened out if asked), switching at the same moment.
component Player inherits VerticalLayout {
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        GhostButton {
            compact: true;
            text: Compress.player-busy ? "Making a sample…"
                : Compress.player-on ? ""
                : Compress.sound-file ? "Listen to 10 s" : "Play 10 s";
            icon: Compress.playing ? "\u{E769}" : "\u{E768}";
            label: Compress.playing ? "Pause" : Compress.sound-file ? "Listen to a 10 s sample" : "Play a 10 s sample";
            clicked => {
                if !Compress.player-busy {
                    Compress.play-pause();
                }
            }
        }
        ChoiceChips {
            horizontal-stretch: 0;
            options: ["Now", "After"];
            current <=> Compress.side;
            changed => { Compress.hear(); }
        }
        if Compress.player-on: Text {
            horizontal-stretch: 0;
            text: Compress.player-time;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    if Compress.player-on: Bar {
        value: Compress.player-pos;
    }
}

// Before / after, the sizes, and the sample to play.
component Result inherits VerticalLayout {
    spacing: 10px;
    if Compress.verdict != "": Text {
        text: Compress.verdict;
        color: Theme.ink;
        font-family: Theme.display;
        font-size: 18px;
        font-weight: 700;
        wrap: word-wrap;
    }
    if Compress.sizes != "": Text {
        text: Compress.sizes;
        color: Theme.muted;
        font-family: Theme.mono;
        font-size: 12px;
        wrap: word-wrap;
    }
    // A video: before / after pictures, or the sample playing in their place. A sound file
    // has no pictures: the player is how to hear it.
    if !Compress.sound-file && !Compress.player-on: CompareSlider {
        height: self.width * 9 / 16;
        before: Compress.before;
        after: Compress.after;
        before-label: "Now";
        after-label: Compress.after-label;
        busy-text: Compress.preview-busy ? "Working it out…" : "";
    }
    if !Compress.sound-file && Compress.player-on: Rectangle {
        height: self.width * 9 / 16;
        border-radius: 10px;
        clip: true;
        background: Theme.video;
        Image {
            width: parent.width;
            height: parent.height;
            source: Compress.player-frame;
            image-fit: contain;
        }
    }
    Player { }
}

component Advanced inherits VerticalLayout {
    spacing: 12px;
    adv-head := Rectangle {
        height: 30px;
        accessible-role: button;
        accessible-label: (Compress.advanced-open ? "Hide" : "Show") + " advanced options";
        accessible-action-default => { Compress.advanced-open = !Compress.advanced-open; }
        KeyPress {
            radius: 6px;
            activated => { Compress.advanced-open = !Compress.advanced-open; }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Compress.advanced-open = !Compress.advanced-open; }
        }
        HorizontalLayout {
            spacing: 8px;
            Icon {
                horizontal-stretch: 0;
                text: Compress.advanced-open ? "\u{E70E}" : "\u{E70D}";
                font-size: 11px;
                color: ta.has-hover ? Theme.ink : Theme.muted;
            }
            Text {
                horizontal-stretch: 0;
                text: "Advanced";
                color: ta.has-hover ? Theme.ink : Theme.muted;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: Compress.advanced-line;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    if Compress.advanced-open: VerticalLayout {
        spacing: 14px;
        padding-left: 4px;
        VerticalLayout {
            spacing: 6px;
            OptionHead { text: "Format"; }
            ChoiceChips {
                options: ["Plays everywhere", "Smaller", "Smallest"];
                current <=> Compress.format;
                changed => { Compress.changed(); }
            }
            if Compress.format-warning != "": Notice {
                text: Compress.format-warning;
                wrap: true;
            }
        }
        // A sound file: only the format matters (Plays everywhere is AAC, the others Opus).
        if !Compress.sound-file: Tick {
            text: Compress.gpu-text;
            checked <=> Compress.use-gpu;
            toggled => { Compress.changed(); }
        }
        if !Compress.sound-file: VerticalLayout {
            spacing: 6px;
            OptionHead { text: "Picture"; }
            ChoiceChips {
                options: ["Auto", "Keep it", "1080p", "720p", "480p"];
                current <=> Compress.picture;
                changed => { Compress.changed(); }
            }
        }
        if !Compress.sound-file: VerticalLayout {
            spacing: 6px;
            OptionHead { text: "Sound"; }
            ChoiceChips {
                options: ["128 kbps", "96 kbps", "64 kbps", "No sound"];
                current <=> Compress.sound;
                changed => { Compress.changed(); }
            }
        }
        // Even out the sound (as the Clip page's Sound does), unless there's none kept.
        if Compress.sound-file || Compress.sound != 3: VerticalLayout {
            spacing: 6px;
            OptionHead { text: "Volume"; }
            ChoiceChips {
                options: ["As is", "Even out"];
                current <=> Compress.volume;
                changed => { Compress.changed(); }
            }
            if Compress.volume == 1: ChoiceChips {
                options: ["Online video · -14 LUFS", "Podcast · -16 LUFS"];
                current <=> Compress.loudness;
                changed => { Compress.changed(); }
            }
        }
        if Compress.tracks-text != "" && !Compress.sound-file: Tick {
            text: "Keep " + Compress.tracks-text;
            checked <=> Compress.keep-tracks;
            toggled => { Compress.changed(); }
        }
        if Compress.bars-text != "" && !Compress.sound-file: Tick {
            text: "Cut off the black bars (" + Compress.bars-text + ")";
            checked <=> Compress.cut-bars;
            toggled => { Compress.changed(); }
        }
        if Compress.summary != "": Text {
            text: Compress.summary;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 11.5px;
            wrap: word-wrap;
        }
    }
}

// Pick goals in plain words, see what each will look like, compress one file or several.
export component CompressPage inherits Rectangle {
    in property <[RecentItem]> recent;
    property <bool> one: Compress.count == 1;
    property <bool> many: Compress.count > 1;

    VerticalLayout {
        padding: Screen.compact ? Screen.pad : 28px;
        padding-bottom: Screen.compact ? 12px : 28px;
        // Wide windows: keep a readable column instead of stretching edge to edge.
        padding-left: max(Screen.pad, (parent.width - 1240px) / 2);
        padding-right: max(Screen.pad, (parent.width - 1240px) / 2);
        spacing: Screen.compact ? 12px : 16px;

        HorizontalLayout {
            spacing: 12px;
            PageTitle {
                horizontal-stretch: 1;
                spacing: 4px;
                title: root.many ? "Make them smaller." : "Make it smaller.";
                subtitle: Screen.compact ? "" : "Pick where it's going, or how it should look.";
            }
            if Compress.count > 0 && !Compress.running: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                GhostButton {
                    compact: true;
                    text: Screen.compact ? "" : "Add files…";
                    icon: "\u{E710}";
                    label: "Add files";
                    clicked => { Compress.open-file(); }
                }
            }
        }

        // Nothing open: the way in, then recent video downloads.
        if Compress.count == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            spacing: 14px;
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                PrimaryButton {
                    text: "Open files…";
                    icon: "\u{E8E5}";
                    clicked => { Compress.open-file(); }
                }
                GhostButton {
                    text: "Open a folder…";
                    icon: "\u{E8B7}";
                    clicked => { Compress.open-folder(); }
                }
            }
            Divider { }
            RecentList {
                items: root.recent;
                action: "Compress";
                empty-text: "Open videos, sound files or a folder, or drop them here. Finished downloads show up here, ready to shrink for Discord or email.";
                open(path) => { Compress.open-path(path); }
            }
        }

        // One file: its card, with Trim and ×.
        if root.one: HorizontalLayout {
            spacing: Screen.compact ? 12px : 16px;
            height: Screen.compact ? 63px : 90px;
            Thumb {
                width: Screen.compact ? 112px : 160px;
                border-radius: 10px;
                background: Theme.video;
                source: Compress.thumb;
                if Compress.sound-file: Icon {
                    text: "\u{E8D6}";
                    font-size: Screen.compact ? 24px : 32px;
                    color: Theme.border;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    text: Compress.name;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: Compress.info;
                    color: Theme.muted;
                    font-family: Theme.mono;
                    font-size: 11.5px;
                    wrap: word-wrap;
                }
            }
            if !Compress.running: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    GhostButton {
                        compact: true;
                        text: Screen.compact ? "" : "Trim…";
                        icon: "\u{E8C6}";
                        label: "Trim";
                        on: Compress.trim-open;
                        clicked => {
                            Compress.trim-open = !Compress.trim-open;
                            if Compress.trim-open {
                                // Rust sets the ends and makes the filmstrip.
                                Compress.trim-changed();
                            } else {
                                Compress.trim-whole();
                            }
                        }
                    }
                    IconButton {
                        icon: "\u{E711}";
                        label: Compress.sound-file ? "Close this file" : "Close this video";
                        clicked => { Compress.clear(); }
                    }
                }
            }
        }

        // Options scroll on short windows; the Compress bar stays pinned below.
        if Compress.count > 0: ScrollView {
            vertical-stretch: 1;
            // One plain layout (no Rectangle in between): wrapping chips are only measured
            // at their real width through layouts, so a Rectangle would leave gaps.
            VerticalLayout {
                spacing: 16px;
                padding-right: Theme.lane;
                padding-bottom: 4px;
                alignment: start;

                if root.one && Compress.trim-open: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 0;
                            // With parts kept, the strip picks the next one to add.
                            text: Compress.parts.length > 0 ? "Next part" : "Only this part";
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: Compress.trim-text;
                            color: Theme.ink;
                            font-family: Theme.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TextLink {
                            horizontal-stretch: 0;
                            text: Compress.sound-file ? "Whole file" : "Whole video";
                            clicked => { Compress.trim-whole(); }
                        }
                    }
                    TrimStrip {
                        duration: Compress.duration;
                        frames: Compress.strip;
                        start <=> Compress.trim-in;
                        end <=> Compress.trim-out;
                        changed => { Compress.trim-changed(); }
                    }
                    if Compress.chapters.length > 0: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 0;
                            text: "Chapter";
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        ChoiceChips {
                            options: Compress.chapters;
                            current <=> Compress.chapter;
                            changed => { Compress.trim-chapter(Compress.chapter); }
                        }
                    }
                    // Several parts: keep this one, pick the next on the strip, and so on.
                    HorizontalLayout {
                        spacing: 10px;
                        GhostButton {
                            horizontal-stretch: 0;
                            compact: true;
                            text: Compress.parts.length == 0 ? "Keep this part, add more" : "Add this part";
                            icon: "\u{E710}";
                            clicked => { Compress.add-part(); }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: Compress.parts-text;
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    for p[i] in Compress.parts: HorizontalLayout {
                        spacing: 10px;
                        Text {
                            horizontal-stretch: 0;
                            min-width: 46px;
                            text: "Part " + (i + 1);
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: p.text;
                            color: Theme.ink;
                            font-family: Theme.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        IconButton {
                            icon: "\u{E711}";
                            label: "Take part " + (i + 1) + " off";
                            clicked => { Compress.remove-part(i); }
                        }
                    }
                    if Compress.parts.length >= 2: ChoiceChips {
                        options: ["Joined into one file", "One file each"];
                        current <=> Compress.split;
                        changed => { Compress.changed(); }
                    }
                }

                // Several files: the list.
                if root.many: VerticalLayout {
                    spacing: 0px;
                    for f[i] in Compress.files: FileRow {
                        file: f;
                        running: Compress.running;
                        remove => { Compress.remove(i); }
                        show => { Compress.show(i); }
                    }
                }

                // Goals beside the result on wide windows; stacked below that, so the hints
                // keep their room (the picture then stays a readable size, not full width).
                if root.one && Screen.wide: HorizontalLayout {
                    spacing: 22px;
                    Goals {
                        horizontal-stretch: 1;
                    }
                    Result {
                        horizontal-stretch: 0;
                        width: 340px;
                    }
                }
                if root.one && !Screen.wide: VerticalLayout {
                    spacing: 16px;
                    Goals { }
                    Result {
                        max-width: 460px;
                    }
                }
                if root.many: Goals { }

                if Compress.problem != "": HorizontalLayout {
                    spacing: 10px;
                    Notice {
                        text: Compress.problem;
                        wrap: true;
                        font-size: 13px;
                    }
                    if Compress.fix-text != "": VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        GhostButton {
                            compact: true;
                            text: Compress.fix-text;
                            icon: "\u{E8C6}";
                            clicked => { Compress.fix(); }
                        }
                    }
                }

                Divider { }
                Advanced { }
            }
        }

        if Compress.count > 0 && Compress.running && root.one: Bar {
            value: Compress.progress;
        }

        // Compact: status (or, before starting, what you'll get: the result and the problem
        // may be scrolled away) and Show file on a line, the main button across the bottom.
        if Compress.count > 0 && Screen.compact && (Compress.status != "" || (root.one && Compress.verdict != "") || Compress.problem != "" || (Compress.has-output && !Compress.running && root.one)): HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: Compress.status != "" ? Compress.status : Compress.problem != "" ? Compress.problem : Compress.verdict + "  ·  " + Compress.sizes;
                color: Compress.status == "" && Compress.problem != "" ? Theme.warn : Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            if Compress.has-output && !Compress.running && root.one: GhostButton {
                horizontal-stretch: 0;
                compact: true;
                text: "Show file";
                icon: "\u{E838}";
                clicked => { Compress.show(-1); }
            }
        }
        if Compress.count > 0 && Screen.compact: PrimaryButton {
            text: Compress.running ? "Cancel  " + Math.round(Compress.progress * 100) + "%" : Compress.start-text;
            icon: Compress.running ? "" : "\u{E73F}";
            enabled: Compress.running || Compress.can-start;
            clicked => {
                if Compress.running {
                    Compress.cancel();
                } else {
                    Compress.start();
                }
            }
        }

        if Compress.count > 0 && !Screen.compact: HorizontalLayout {
            spacing: 8px;
            // Medium windows stack the result under the goals: say it here too.
            Text {
                horizontal-stretch: 1;
                text: Compress.status != "" || Screen.wide ? Compress.status : Compress.problem != "" ? Compress.problem : root.one && Compress.verdict != "" ? Compress.verdict + "  ·  " + Compress.sizes : "";
                color: Compress.status == "" && !Screen.wide && Compress.problem != "" ? Theme.warn : Theme.muted;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
            if Compress.has-output && !Compress.running && root.one: GhostButton {
                horizontal-stretch: 0;
                text: "Show file";
                icon: "\u{E838}";
                clicked => { Compress.show(-1); }
            }
            PrimaryButton {
                horizontal-stretch: 0;
                text: Compress.running ? "Cancel  " + Math.round(Compress.progress * 100) + "%" : Compress.start-text;
                icon: Compress.running ? "" : "\u{E73F}";
                enabled: Compress.running || Compress.can-start;
                clicked => {
                    if Compress.running {
                        Compress.cancel();
                    } else {
                        Compress.start();
                    }
                }
            }
        }
    }
}
