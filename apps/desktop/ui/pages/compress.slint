import { LineEdit, CheckBox, ComboBox, ScrollView, Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PrimaryButton, GhostButton, Bar, ChoiceChips, PageTitle, EmptyState, Notice, Divider, Thumb } from "../widgets.slint";

// The label on the left of an option row ("Goal", "Size"…).
component OptionLabel inherits Text {
    width: 90px;
    color: Theme.muted;
    font-size: 13px;
    vertical-alignment: center;
}

// Fit a size or pick a quality; codec, resolution, fps, audio; the estimate; Compress.
export component CompressPage inherits Rectangle {
    in property <bool> loaded;
    in property <string> name;
    in property <string> info;
    in property <image> thumb;
    // 0 fit a size, 1 pick a quality
    in-out property <int> mode;
    in-out property <int> size-index;
    in-out property <string> custom-mb;
    in-out property <float> quality;
    in-out property <int> codec;
    in-out property <bool> use-gpu;
    in property <bool> gpu-available;
    in property <string> gpu-label;
    in-out property <int> res-index;
    in-out property <int> fps-index;
    in-out property <int> audio-index;
    in property <string> estimate;
    in property <bool> warning;
    in property <bool> can-start;
    in property <bool> running;
    in property <float> progress;
    in property <string> status;
    in property <bool> has-output;

    callback open-file();
    callback options-changed();
    callback start-compress();
    callback cancel();
    callback show-output();

    VerticalLayout {
        padding: 28px;
        // Wide windows: keep a readable column instead of stretching edge to edge.
        padding-left: max(26px, (parent.width - 1240px) / 2);
        padding-right: max(26px, (parent.width - 1240px) / 2);
        spacing: 16px;

        HorizontalLayout {
            spacing: 12px;
            PageTitle {
                horizontal-stretch: 1;
                spacing: 4px;
                title: "Make it smaller.";
                subtitle: "Fit Discord, email or any size limit, or just save space.";
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                GhostButton {
                    compact: true;
                    text: "Open file…";
                    icon: "\u{E8E5}";
                    clicked => { root.open-file(); }
                }
            }
        }

        if !root.loaded: EmptyState {
            icon: "\u{E73F}";
            title: "Drop in a video to shrink it";
            tip: "Tip: finished downloads have a compress button too.";
            PrimaryButton {
                text: "Open file…";
                icon: "\u{E8E5}";
                clicked => { root.open-file(); }
            }
        }

        // File card
        if root.loaded: Rectangle {
            height: 104px;
            HorizontalLayout {
                padding: 0px;
                spacing: 16px;
                Thumb {
                    width: 184px;
                    border-radius: 10px;
                    background: #000000;
                    source: root.thumb;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.name;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: root.info;
                        color: Theme.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }
        }

        // Options scroll on short windows; the Compress bar stays pinned below.
        if root.loaded: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 16px;
                padding-right: 12px;
                alignment: start;
                Rectangle {
                    Divider {
                        y: 0;
                    }
                    VerticalLayout {
                        padding-top: 18px;
                        padding-bottom: 4px;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 8px;
                            OptionLabel { text: "Goal"; }
                            ChoiceChips {
                                options: ["Fit a size", "Pick a quality"];
                                current <=> root.mode;
                                changed => { root.options-changed(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if root.mode == 0: HorizontalLayout {
                            spacing: 8px;
                            OptionLabel { text: "Size"; }
                            ChoiceChips {
                                options: ["20 MB · Discord", "25 MB", "50 MB", "100 MB", "Custom"];
                                current <=> root.size-index;
                                changed => { root.options-changed(); }
                            }
                            if root.size-index == 4: LineEdit {
                                width: 90px;
                                placeholder-text: "MB";
                                text <=> root.custom-mb;
                                edited => { root.options-changed(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if root.mode == 1: HorizontalLayout {
                            spacing: 12px;
                            OptionLabel { text: "Quality"; }
                            Text {
                                text: "Smaller";
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Slider {
                                horizontal-stretch: 1;
                                minimum: 0;
                                maximum: 1;
                                value <=> root.quality;
                                changed => { root.options-changed(); }
                            }
                            Text {
                                text: "Better";
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            OptionLabel { text: "Codec"; }
                            ChoiceChips {
                                options: ["H.264 · plays everywhere", "H.265 · smaller", "AV1 · smallest"];
                                current <=> root.codec;
                                changed => { root.options-changed(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            OptionLabel { text: "Output"; }
                            ComboBox {
                                width: 150px;
                                model: ["Auto resolution", "Original size", "Max 1080p", "Max 720p", "Max 480p"];
                                current-index <=> root.res-index;
                                selected => { root.options-changed(); }
                            }
                            ComboBox {
                                width: 130px;
                                model: ["Original fps", "Max 60 fps", "Max 30 fps"];
                                current-index <=> root.fps-index;
                                selected => { root.options-changed(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            OptionLabel { text: "Audio"; }
                            ComboBox {
                                width: 150px;
                                model: ["128 kbps", "96 kbps", "64 kbps", "No audio"];
                                current-index <=> root.audio-index;
                                selected => { root.options-changed(); }
                            }
                            Rectangle { width: 6px; }
                            CheckBox {
                                text: root.gpu-label;
                                enabled: root.gpu-available;
                                checked <=> root.use-gpu;
                                toggled => { root.options-changed(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }

        if root.loaded: Notice {
            spacing: 10px;
            icon: root.warning ? "\u{E7BA}" : "\u{E946}";
            icon-size: 14px;
            icon-color: root.warning ? Theme.warn : Theme.accent-hi;
            text: root.estimate;
            color: root.warning ? Theme.warn : Theme.text;
            font-size: 13px;
            wrap: true;
        }

        if root.loaded && root.running: Bar {
            value: root.progress;
        }

        if root.loaded: HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: root.status;
                color: Theme.muted;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.has-output && !root.running: GhostButton {
                horizontal-stretch: 0;
                text: "Show file";
                icon: "\u{E838}";
                clicked => { root.show-output(); }
            }
            PrimaryButton {
                horizontal-stretch: 0;
                text: root.running ? "Cancel  " + Math.round(root.progress * 100) + "%" : "Compress";
                icon: root.running ? "" : "\u{E73F}";
                enabled: root.running || root.can-start;
                clicked => {
                    if root.running {
                        root.cancel();
                    } else {
                        root.start-compress();
                    }
                }
            }
        }
    }
}
