import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme, Screen } from "../theme.slint";
import { Menu, MenuItem, PrimaryButton, GhostButton, IconButton, TextLink, ChoiceChips, PageTitle, SettingsGear, Notice, Divider, Thumb, Tick, Tag, Icon, KeyPress, SectionTitle, FilterTab, Toast, Head, Hint } from "../widgets.slint";
import { Capture, CaptureSource, CaptureTrack, CaptureApp, Voice, Phone } from "../globals.slint";
import { SavedList } from "../components/saved-list.slint";
import { QualityChoice } from "../components/quality-choice.slint";
import { PhonePane } from "phone.slint";

// The Capture page (mock: design/capture.html, picks 1A · 2A · 3A · 4A): instant replay of a
// game, a window or a monitor; its Phone tab is `phone.slint` (design/phone.html). The status and its buttons stay at the top; what to record,
// how much, the sound and the key scroll under it; then the clips it saved.

// One thing to record: a round mark (ink when picked), its icon, name and hint, "Game".
component SourceRow inherits Rectangle {
    in property <CaptureSource> item;
    in property <bool> selected;
    callback clicked();
    min-height: row.preferred-height;
    accessible-role: radio-button;
    accessible-label: root.item.name;
    accessible-description: root.item.hint;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    kp := KeyPress {
        radius: 8px;
        activated => { root.clicked(); }
    }
    background: ta.has-hover ? Theme.raised : transparent;
    border-radius: 8px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { kp.take(); root.clicked(); }
    }
    Rectangle {
        x: 0;
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: Theme.line;
    }
    row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: root.selected ? 6px : 2px;
                border-color: root.selected ? Theme.ink : ta.has-hover ? Theme.muted : Theme.edge;
                animate border-width, border-color { duration: 90ms; }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                background: Theme.raised;
                Icon {
                    text: root.item.kind == 0 ? "\u{E7FC}" : root.item.kind == 2 ? "\u{E7F4}" : root.item.kind == 3 ? "\u{E945}" : "\u{ECAA}";
                    font-size: 14px;
                    color: Theme.dim;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.name;
                color: Theme.ink;
                font-family: Theme.body;
                font-size: 13.5px;
                font-weight: root.selected ? 600 : 500;
                overflow: elide;
            }
            if root.item.hint != "": Text {
                text: root.item.hint;
                color: Theme.muted;
                font-family: Theme.body;
                font-size: 12px;
                overflow: elide;
            }
        }
        if root.item.kind == 0: VerticalLayout {
            alignment: center;
            Tag { text: "Game"; }
        }
        if root.item.kind == 3 && root.selected && Capture.state == 2: VerticalLayout {
            alignment: center;
            Tag {
                text: "Following";
                kind: 1;
            }
        }
    }
}

// One track the next save holds: its number, icon, name, level, and "Never record" for apps.
component TrackRow inherits Rectangle {
    in property <CaptureTrack> track;
    min-height: row.preferred-height;
    Rectangle {
        x: 0;
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: Theme.line;
    }
    row := HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        padding-left: 4px;
        spacing: 8px;
        Text {
            width: 18px;
            text: root.track.n;
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
        if !Screen.compact: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 6px;
                background: Theme.raised;
                Icon {
                    text: root.track.kind == 0 ? "\u{E767}" : root.track.kind == 1 ? "\u{E7FC}" : root.track.kind == 3 ? "\u{E720}" : "\u{ECAA}";
                    font-size: 12px;
                    color: Theme.dim;
                }
            }
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            Text {
                horizontal-stretch: 0;
                text: root.track.name;
                color: Theme.ink;
                font-family: Theme.body;
                font-size: 13px;
                font-weight: root.track.kind == 0 ? 600 : 400;
                vertical-alignment: center;
            }
            if root.track.note != "" && !Screen.compact: Text {
                horizontal-stretch: 1;
                text: root.track.note;
                color: Theme.muted;
                font-family: Theme.body;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.track.note == "" || Screen.compact: Rectangle { horizontal-stretch: 1; }
        }
        if root.track.kind != 3: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 2px;
            alignment: center;
            for k in [0.55, 1.0, 0.7]: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 3px;
                    height: 3px + 9px * min(1, root.track.level * 2.2 * k);
                    border-radius: 1px;
                    background: root.track.level > 0.005 ? Theme.ok : Theme.line-strong;
                }
            }
        }
        if root.track.exe != "": VerticalLayout {
            alignment: center;
            TextLink {
                text: Screen.compact ? "Never" : "Never record";
                clicked => { Capture.never-add(root.track.exe); }
            }
        }
    }
}

// Never record: the apps as chips with ×, then "+ Add an app" (a menu of apps playing sound
// and programs open now).
component NeverList inherits FlexboxLayout {
    spacing: 6px;
    for a in Capture.never: Rectangle {
        height: 30px;
        min-width: chip.preferred-width;
        border-radius: 9px;
        border-width: 2px;
        border-color: Theme.line-strong;
        chip := HorizontalLayout {
            padding-left: 8px;
            padding-right: 2px;
            spacing: 2px;
            Text {
                text: a.name;
                color: Theme.ink;
                font-family: Theme.body;
                font-size: 12.5px;
                vertical-alignment: center;
            }
            IconButton {
                icon: "\u{E711}";
                label: "Record " + a.name + " again";
                clicked => { Capture.never-remove(a.exe); }
            }
        }
    }
    VerticalLayout {
        GhostButton {
            compact: true;
            text: "Add an app";
            icon: "\u{E710}";
            label: "Add an app to Never record";
            clicked => {
                Capture.never-menu();
                menu.show();
            }
        }
        menu := PopupWindow {
            x: 0;
            y: 34px;
            Menu {
                width: 240px;
                if Capture.never-choices.length == 0: MenuItem {
                    text: "No other app is playing sound or open";
                }
                for a in Capture.never-choices: MenuItem {
                    text: a.name;
                    clicked => { Capture.never-add(a.exe); }
                }
            }
        }
    }
}

// The save key: the key in a box and Change; while picking, "Press a key…" takes the next
// key pressed (Esc puts the old one back).
component KeyBox inherits HorizontalLayout {
    spacing: 8px;
    alignment: start;
    Rectangle {
        min-width: max(110px, keytext.preferred-width + 24px);
        height: 34px;
        border-radius: 9px;
        background: Theme.panel;
        border-width: 2px;
        border-color: Capture.picking-key ? Theme.ink : Theme.line-strong;
        keytext := Text {
            text: Capture.picking-key ? "Press a key…" : Capture.key;
            color: Capture.picking-key ? Theme.muted : Theme.ink;
            font-family: Capture.picking-key ? Theme.body : Theme.mono;
            font-size: Capture.picking-key ? 12.5px : 12px;
        }
        if Capture.picking-key: catcher := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    Capture.key-pick-cancel();
                    return accept;
                }
                // A modifier alone waits for the key that goes with it.
                if event.text == Key.Shift || event.text == Key.Control || event.text == Key.Alt || event.text == Key.Meta || event.text == Key.AltGr || event.text == Key.ShiftR || event.text == Key.ControlR || event.text == Key.MetaR {
                    return accept;
                }
                Capture.key-picked(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                accept
            }
            focus-changed-event => {
                if !self.has-focus && Capture.picking-key {
                    Capture.key-pick-cancel();
                }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        GhostButton {
            compact: true;
            text: Capture.picking-key ? "Cancel" : "Change";
            label: Capture.picking-key ? "Cancel changing the save key" : "Change the save key";
            clicked => {
                if Capture.picking-key {
                    Capture.key-pick-cancel();
                } else {
                    Capture.key-pick-start();
                }
            }
        }
    }
}

// 'Listening for "clip that"' while voice listens with instant replay on; a click opens
// Settings → Voice. Compact: the mic and its level only.
component ListenBadge inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 0;
    Rectangle {
        height: 30px;
        min-width: row.preferred-width;
        border-radius: 9px;
        border-width: 2px;
        border-color: ta.has-hover ? Theme.muted : Theme.line-strong;
        background: ta.has-hover ? Theme.raised : transparent;
        accessible-role: button;
        accessible-label: Voice.mic-missing ? "Mic not found: open Settings, Voice" : Voice.listen-text + ". Open Settings, Voice";
        accessible-action-default => { Voice.mark-clicked(); }
        kp := KeyPress {
            radius: 9px;
            activated => { Voice.mark-clicked(); }
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { kp.take(); Voice.mark-clicked(); }
        }
        row := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            Icon {
                text: "\u{E720}";
                font-size: 13px;
                color: Voice.mic-missing ? Theme.warn : Theme.ink;
            }
            if !Screen.compact || Voice.mic-missing: Text {
                text: Voice.mic-missing ? "Mic not found" : Voice.listen-text;
                color: Voice.mic-missing ? Theme.warn : Theme.ink;
                font-family: Theme.body;
                font-size: 12px;
                vertical-alignment: center;
            }
            if !Voice.mic-missing: HorizontalLayout {
                spacing: 2px;
                alignment: center;
                for k in [0.55, 1.0, 0.7]: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 3px;
                        height: 3px + 9px * min(1, Voice.level * 2.2 * k);
                        border-radius: 1px;
                        background: Theme.ok;
                    }
                }
            }
        }
    }
}

// The status band: a tag, what it's doing in plain words, and its buttons. Off: the page's
// one yellow action, Turn on instant replay.
component StatusBand inherits VerticalLayout {
    spacing: 12px;
    vertical-stretch: 0;
    property <bool> running: Capture.state == 1 || Capture.state == 2 || Capture.state == 3;
    Divider { }
    HorizontalLayout {
        spacing: 12px;
        if Capture.state != 0: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Tag {
                text: Capture.state == 2 ? "ON" : Capture.state == 1 ? "STARTING" : Capture.state == 3 ? "WAITING" : "STOPPED";
                kind: Capture.state == 2 ? 5 : Capture.state == 4 ? 2 : 0;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text {
                text: Capture.status;
                color: Theme.ink;
                font-family: Theme.body;
                font-size: Screen.compact ? 15px : 17px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if Capture.detail != "": Text {
                text: Capture.detail;
                color: Capture.state == 4 ? Theme.warn : Theme.muted;
                font-family: Theme.body;
                font-size: 12.5px;
                wrap: word-wrap;
            }
            if Capture.tech != "" && !Screen.compact: Text {
                text: Capture.tech;
                color: Theme.muted;
                font-family: Theme.mono;
                font-size: 11.5px;
                overflow: elide;
            }
        }
        if !Screen.compact: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            buttons := HorizontalLayout {
                spacing: 8px;
                if Capture.state == 0: PrimaryButton {
                    text: "Turn on instant replay";
                    icon: "\u{E7C8}";
                    clicked => { Capture.turn-on(); }
                }
                if Capture.state == 2: GhostButton {
                    text: "Save now";
                    icon: "\u{E74E}";
                    label: "Save what's kept now";
                    clicked => { Capture.save-now(); }
                }
                if Capture.state == 4: GhostButton {
                    text: "Try again";
                    icon: "\u{E72C}";
                    clicked => { Capture.try-again(); }
                }
                if Capture.state != 0: GhostButton {
                    text: "Turn off";
                    icon: "\u{E711}";
                    label: "Turn off instant replay";
                    clicked => { Capture.turn-off(); }
                }
            }
        }
    }
    // Compact: the buttons get a row of their own.
    if Screen.compact: HorizontalLayout {
        spacing: 8px;
        if Capture.state == 0: PrimaryButton {
            horizontal-stretch: 1;
            text: "Turn on instant replay";
            icon: "\u{E7C8}";
            clicked => { Capture.turn-on(); }
        }
        if Capture.state == 2: GhostButton {
            horizontal-stretch: 1;
            text: "Save now";
            icon: "\u{E74E}";
            label: "Save what's kept now";
            clicked => { Capture.save-now(); }
        }
        if Capture.state == 4: GhostButton {
            horizontal-stretch: 1;
            text: "Try again";
            icon: "\u{E72C}";
            clicked => { Capture.try-again(); }
        }
        if Capture.state != 0: GhostButton {
            horizontal-stretch: 1;
            text: "Turn off";
            icon: "\u{E711}";
            label: "Turn off instant replay";
            clicked => { Capture.turn-off(); }
        }
    }
    Divider { }
}

// What to record: games, then (if asked) other windows, then the monitors.
component SourceList inherits VerticalLayout {
    spacing: 0px;
    alignment: start;
    Head { text: "What to record"; }
    Rectangle { height: 6px; }
    for s in Capture.sources: SourceRow {
        item: s;
        selected: s.id == Capture.picked;
        clicked => { Capture.pick(s.id); }
    }
    Rectangle { height: 8px; }
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Tick {
            text: "Show every open window";
            checked <=> Capture.show-all;
            toggled => { Capture.show-all-changed(); }
        }
    }
    Rectangle { height: 4px; }
    Hint {
        text: "A game is recorded on its own, even when other windows cover it; in exclusive fullscreen, pick Borderless in the game or record the monitor.";
    }
}

// How much, the sound tracks, the key, turning on at start.
component Choices inherits VerticalLayout {
    spacing: 8px;
    alignment: start;
    Head { text: "How much to keep"; }
    ChoiceChips {
        options: ["30 s", "1 min", "2 min", "5 min"];
        current <=> Capture.keep;
        changed => { Capture.changed(); }
    }
    Rectangle { height: 8px; }
    Head { text: "Quality"; }
    QualityChoice {
        rows: Capture.quality-rows;
        current: Capture.quality;
        note: Capture.quality-note;
        note-warn: Capture.quality-warn;
        open <=> Capture.quality-open;
        summary: "size, frame rate, bit rate, encoder";
        custom: Capture.quality-custom;
        sizes: Capture.q-sizes;
        size: Capture.q-size;
        rates: Capture.q-rates;
        rate: Capture.q-rate;
        mbps: Capture.q-mbps;
        pick(i) => { Capture.quality-pick(i); }
        size-picked(i) => { Capture.quality-size(i); }
        rate-picked(i) => { Capture.quality-rate(i); }
        mbps-step(d) => { Capture.quality-mbps(d); }
        back => { Capture.quality-back(); }
        // The encoder: Automatic picks the fastest that works, so it lives in here.
        encoders: Capture.encoders;
        encoder <=> Capture.encoder;
        encoder-hint: Capture.encoder-hint;
        encoder-picked => { Capture.changed(); }
    }
    Rectangle { height: 8px; }
    Head { text: "Sound"; }
    Tick {
        text: "A track for each app playing sound";
        checked <=> Capture.per-app;
        toggled => { Capture.changed(); }
    }
    HorizontalLayout {
        spacing: 8px;
        Tick {
            horizontal-stretch: 0;
            text: "Mic";
            checked <=> Capture.mic;
            toggled => { Capture.changed(); }
        }
        if Capture.mic: ComboBox {
            horizontal-stretch: 1;
            model: Capture.mics;
            current-index <=> Capture.mic-index;
            selected => { Capture.changed(); }
        }
    }
    if Capture.tracks.length > 0: Hint {
        text: Capture.state == 2 ? "The next save holds:" : "A save would hold:";
    }
    if Capture.tracks.length > 0: VerticalLayout {
        for t in Capture.tracks: TrackRow {
            track: t;
        }
    }
    if Capture.tracks-note != "": Hint {
        text: Capture.tracks-note;
    }
    Rectangle { height: 4px; }
    Head { text: "Never record"; }
    NeverList { }
    Hint {
        text: Capture.never.length >= 2
            ? "Left out of every track, Everything too. With two or more here, an app that starts playing later joins at Neria's next quiet restart (a few seconds)."
            : "Left out of every track, Everything too, every time.";
    }
    Rectangle { height: 8px; }
    Head { text: "Save key"; }
    KeyBox { }
    if Capture.key-problem != "": Notice {
        text: Capture.key-problem;
        wrap: true;
    }
    Hint {
        text: "Works inside games." + (Capture.voice-hint != "" ? " " + Capture.voice-hint : " Saying \"clip that\" can save too: Settings → Voice.");
    }
    Rectangle { height: 8px; }
    Tick {
        text: "Turn on when Neria starts";
        checked <=> Capture.at-start;
        toggled => { Capture.changed(); }
    }
}

// A saved clip: frame, name, length · size · when; Open in clipper, Show, ×.
export component CapturePage inherits Rectangle {
    init => { Capture.page-shown(true); if Phone.tab == 1 { Phone.shown(true); } }
    VerticalLayout {
        padding: Screen.compact ? Screen.pad : 28px;
        padding-bottom: Screen.compact ? 12px : 28px;
        padding-left: max(Screen.pad, (parent.width - 1240px) / 2);
        padding-right: max(Screen.pad, (parent.width - 1240px) / 2);
        spacing: Screen.compact ? 12px : 16px;

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 0;
            PageTitle {
                horizontal-stretch: 1;
                spacing: 4px;
                title: "Keep the moment.";
                subtitle: Screen.compact || Capture.state != 0 || Phone.tab == 1 ? "" : "Neria keeps the last minute of your game or screen on the graphics card, so the game hardly notices. Press the key when something happens and it's saved.";
            }
            if Voice.listening: ListenBadge { }
            if Screen.compact: SettingsGear { }
        }

        // This PC / Phone: calm tabs (they change the view, not a setting).
        HorizontalLayout {
            spacing: 24px;
            vertical-stretch: 0;
            alignment: start;
            FilterTab {
                text: "This PC";
                show-count: false;
                active: Phone.tab == 0;
                place: 0;
                places: 2;
                clicked => { Phone.tab = 0; Phone.shown(false); }
            }
            FilterTab {
                text: Phone.name != "" ? Phone.name : "Phone";
                show-count: false;
                active: Phone.tab == 1;
                place: 1;
                places: 2;
                clicked => { Phone.tab = 1; Phone.shown(true); }
            }
        }

        if Phone.tab == 1: PhonePane {
            vertical-stretch: 1;
        }

        if Phone.tab == 0: StatusBand { }

        if Phone.tab == 0: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 20px;
                padding-right: Theme.lane;
                padding-top: 4px;
                if Screen.wide: HorizontalLayout {
                    spacing: 24px;
                    SourceList {
                        horizontal-stretch: 1;
                    }
                    Choices {
                        horizontal-stretch: 1;
                    }
                }
                if !Screen.wide: SourceList { }
                if !Screen.wide: Choices { }
                if Capture.saved.length > 0: SavedList { }
            }
        }
    }
}

// After a save, over any page: "Saved" / 'Heard "clip that"', what, Undo, Open in clipper.
export component CaptureToast inherits Toast {
    tag: Capture.toast-tag == "" ? "" : Screen.compact ? "Saved" : Capture.toast-tag;
    text: Capture.toast-text;
    closed => { Capture.toast-closed(); }
    if Capture.toast-undo: VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        TextLink {
            text: "Undo";
            clicked => { Capture.undo(); }
        }
    }
    if Capture.toast-file != "": VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        GhostButton {
            compact: true;
            text: Screen.compact ? "Open" : "Open in clipper";
            icon: "\u{E8C6}";
            label: "Open the saved clip in the clipper";
            clicked => { Capture.open-clip(Capture.toast-file); }
        }
    }
}
