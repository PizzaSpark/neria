// State and callbacks of the Download feature track, one global per feature. Pages import
// them directly instead of threading every property through app.slint; app.slint
// re-exports them, so Rust still sees one API (`ui.global::<Accounts>()`).

// One signed-in site in Settings → Network.
export struct SiteItem {
    site: string, // "youtube.com"
    name: string, // "YouTube"
    detail: string, // "signed in 3 days ago"
}

// Signed-in downloads (cookies kept per site in Neria's folder).
export global Accounts {
    in property <[SiteItem]> sites;
    // The link preview's problem can be solved by signing in to this site ("" otherwise).
    in property <string> problem-site;
    in property <string> problem-name;
    // Already signed in there (the account may not have access): "Sign in again".
    in property <bool> problem-again;
    // Settings: sign in to a site typed by hand.
    in-out property <string> other-site;
    // A sign-in window is open (buttons wait).
    in property <bool> busy;
    callback sign-in(string); // site
    callback sign-out(string);
    callback import-file();
}

// One row of the captions / audio / chapters picker. Header rows are group titles
// ("Made by the creator", "Auto-generated").
export struct TrackRow {
    key: string,
    label: string,
    detail: string, // "video's language", "Original", "2:41"
    checked: bool,
    header: bool,
}

// Captions, audio tracks and chapters of the previewed video: the buttons under the quality
// chips say what's picked, each opens the picker dialog.
export global Extras {
    // What each button says; "" = nothing to pick, no button.
    in property <string> captions-text;
    in property <string> audio-text;
    in property <string> chapters-text;
    // The video has no captions at all (said quietly when other buttons show).
    in property <bool> no-captions;
    // Transcript (speech to text) after the download: "Transcript", "Transcript: text"…
    in property <string> transcript-text: "Transcript";
    in property <bool> transcript-on;
    // The picker: 0 closed, 1 captions, 2 audio tracks, 3 chapters.
    in-out property <int> open;
    in property <[TrackRow]> rows;
    in property <int> total;
    in property <int> picked;
    in-out property <string> query;
    // Captions: format 0 SRT, 1 VTT, 2 ASS, 3 text; mode 0 separate, 1 in the video, 2 both.
    in-out property <int> sub-format;
    in-out property <int> sub-mode;
    in-out property <bool> subs-only;
    // Chapters: 0 one file, 1 separate files.
    in-out property <int> chapter-mode;
    // Under the options ("Joins chapters 2–3 and 5, skips chapter 4").
    in property <string> note;
    callback show(int);
    callback toggle(string, bool);
    callback all(bool);
    callback search(string);
    callback options-changed();
}

// Running in the background: the close question, "Download later", notifications.
export global Background {
    // Closing while downloads are going: "Keep going in the tray" / "Stop and quit".
    in-out property <bool> ask-open;
    in property <int> going; // downloads running or waiting (scheduled ones included)
    in property <int> recording; // of those, live streams being recorded
    in-out property <bool> remember;
    callback keep-going();
    callback quit();
    // "Download later": 0 in an hour, 1 tonight at 02:00, 2 tomorrow at 08:00, 3 at a time.
    in-out property <bool> later-open;
    in-out property <int> later-choice: 1;
    in-out property <string> later-time: "22:00";
    in property <string> later-note; // "Starts tomorrow at 02:00"
    callback later-changed();
    callback later-confirm();
    // Settings (General): 0 ask, 1 keep going in the tray, 2 quit.
    in-out property <int> close-action;
    in-out property <bool> notify: true;
    in-out property <bool> notify-unfocused: true;
    // 0 Neria chime, 1 Windows' sound, 2 none, 3 your own sound (a WAV copied into Neria's
    // folder; own-done / own-failed are its original file names).
    in-out property <int> sound-done;
    in-out property <int> sound-failed;
    in-out property <string> own-done;
    in-out property <string> own-failed;
    in property <bool> own-done-missing; // the copied file is gone: the chime plays instead
    in property <bool> own-failed-missing;
    callback settings-changed();
    callback test-sound(bool); // failed?
    // "Your own sound…" chosen (change: false; reuses the one already copied) or "Change…"
    // (change: true): a file picker for a WAV. Arguments: failed?, change?
    callback pick-sound(bool, bool);
    callback check-sounds(); // Settings → General shown: is the file still there?
}

// Several links at once, "Paste & download" and the clipboard watcher.
export global Bulk {
    // The picker lists pasted links (not a playlist's items): no numbering, "5 links".
    in property <bool> links;
    // Paste & download (Download ▾, Ctrl+Shift+V): every link on the clipboard, your defaults.
    callback paste-download();
    // The watcher (Settings → Download, off by default) and its strip on the Download page.
    in-out property <bool> watch;
    in property <string> copied; // the link just copied ("" = no strip)
    callback watch-changed();
    callback copied-download();
    callback copied-preview();
    callback copied-dismiss();
}

// Watch a link before downloading: the Clip page's player without In/Out (Download track
// 11). Volume and mute are the player's own and never touch what gets saved.
export global Watch {
    in-out property <bool> on;
    in-out property <float> volume: 100;
    in-out property <bool> muted;
    callback start(); // the play mark on the Download page's preview
    // Watching a recording from its queue row (its job id; 0: a preview): the bar offers
    // Stop instead of Download (it's being recorded already).
    in-out property <int> recording-id;
    // That recording: a clip can start (not while catching up), one is open, and what it says
    // ("Clipping from 1:02:20 · 0:40 so far").
    in property <bool> rec-can-clip;
    in property <bool> rec-clipping;
    in property <string> rec-text;
    // That recording has ended: saved (with Show file / Trim it), or why it couldn't be;
    // and whether the stream is still on to record again.
    in property <bool> rec-done;
    in property <bool> rec-saved;
    in property <bool> rec-again;
    // "Also get the 2 h 19 min before" (a link while `rec-earlier-link`), then how that's
    // going ("Getting the part before · 12:00 of 2:19:00"); empty: nothing to say.
    in property <string> rec-earlier;
    in property <bool> rec-earlier-link;
    callback earlier();
    // Watching a live stream, not recording it: Record starts a recording right here.
    callback record();
    callback show-file();
    callback trim();
    callback back(); // to the Download page (a file open before comes back)
    callback download(); // the whole link, with the chips as they are
    callback clip-this(); // stay, with In/Out
    callback volume-changed();
}

// Clip page → Sound (Clip track 1): what the saved clip sounds like. Never the listening
// volume (that's `Watch.volume`), though the player plays the level so you hear it.
export global ClipSound {
    in-out property <bool> open;
    // 0 as is, 1 louder or quieter, 2 even out, 3 mute
    in-out property <int> level;
    // Louder or quieter, in dB (-12..12, whole steps).
    in-out property <float> gain;
    // Even out to: 0 online video (-14 LUFS), 1 podcast (-16 LUFS)
    in-out property <int> target;
    // Fades: 0 off, 1 0.5 s, 2 1 s, 3 2 s, 4 3 s
    in-out property <int> fade-in;
    in-out property <int> fade-out;
    // 0 the video with its sound, 1 the sound only (files only)
    in-out property <int> save;
    // Sound only as: mp3, m4a, opus, flac, wav
    in-out property <int> save-format;
    // A sound file (no picture) saved as: 0 the same as the file, then mp3, m4a, opus, flac, wav
    in-out property <int> file-format;
    // The button on the Clip page ("Sound: as is", "Sound only · mp3").
    in property <string> button-text: "Sound: as is";
    // The same in a word or two, below wide windows ("Sound", "+3 dB", "Muted").
    in property <string> short-text: "Sound";
    // One line on what it'll do (re-encoding, when you hear it).
    in property <string> note;
    callback changed();
    callback reset();
}

// Clip page → Export ▾ → Make a GIF (Clip track 2): the selection as a GIF, an animated
// WebP or a short silent MP4.
export global ClipGif {
    in-out property <bool> open;
    // 0 GIF, 1 WebP, 2 MP4
    in-out property <int> kind;
    // 0 small (320 px wide), 1 medium (480), 2 large (720), 3 as it is
    in-out property <int> size: 1;
    // 0 10 fps, 1 15, 2 24, 3 as it is
    in-out property <int> fps: 1;
    // 0 forever, 1 once (GIF and WebP)
    in-out property <int> loop;
    // "From the selection, 0:06" (Rust).
    in property <string> length-text;
    // "About 1.2 MB", "Working out the size…", or "" (links: known after the download).
    in property <string> estimate;
    // The estimate is big for what it's for: say what would be smaller.
    in property <bool> big;
    callback changed();
    callback make();
}

// Clip page → Picture (Clip track 4–6): turn, mirror and crop. The crop is fractions of
// the turned picture; while editing, the player shows the turned picture with the frame
// on it, otherwise the finished result.
export global ClipPicture {
    in-out property <bool> editing;
    // Clockwise quarter turns, 0–3.
    in-out property <int> turns;
    in-out property <bool> flip-h;
    in-out property <bool> flip-v;
    // 0 whole picture, 1 free, 2 9:16, 3 1:1, 4 4:5, 5 16:9
    in-out property <int> aspect;
    in-out property <float> cx;
    in-out property <float> cy;
    in-out property <float> cw: 1;
    in-out property <float> ch: 1;
    // "Picture: as is", "Picture: cropped · turned" (wide) and a word for narrow windows.
    in property <string> button-text: "Picture: as is";
    in property <string> short-text: "Picture";
    // Something's changed: the player shows the result (and the page says so).
    in property <bool> changed-any;
    callback changed(); // turn / mirror / crop moved: Rust updates the player
    callback aspect-picked(); // a shape chip: Rust centres the biggest crop of it
    callback reset();
}

// Clip page with a live stream open (Clip track 8). Sites that keep the last part of the
// stream (YouTube: an hour) can be rewound: marks are pinned to the clock and found again
// when the download starts. Others get the replay buffer: "Keep the last 10 min".
export global ClipLive {
    in property <bool> on;
    // The site keeps a part to rewind in (more than a minute and a half).
    in property <bool> can-rewind;
    // Replay buffer: how much to keep, 0 5 min, 1 10 min, 2 30 min, 3 60 min.
    in-out property <int> keep: 1;
    in property <bool> buffering;
    // "3:12 kept · 48 MB", or why it stopped.
    in property <string> buffer-text;
    callback last(float); // save the last N seconds (rewind, or from the buffer)
    callback go-live();
    callback buffer-start();
    callback buffer-stop();
}

// Clip page → the timeline when zoomed (Clip track 9). Rust owns the view (core
// `timeline.rs`: clamping, zoom maths, the live edge); the timeline maps it to pixels and
// sends the gestures here.
export global ClipView {
    // On screen: start to start + span, in seconds. Span 0 until the length is known.
    in property <float> start;
    in property <float> span;
    // Less than the whole video is on screen.
    in property <bool> zoomed;
    // Seconds between the ruler's labelled marks, and the zoom said plainly.
    in property <float> ruler-step: 60;
    in property <string> span-text;
    // Shortest / whole: the zoom buttons that can't go further are greyed.
    in property <bool> can-zoom-in: true;
    // The waveform of what's on screen, drawn by Rust at the timeline's width.
    in property <image> wave;
    // Close-up filmstrip frames: frame i is at tiles-start + i * tiles-step.
    in property <[image]> tiles;
    in property <float> tiles-start;
    in property <float> tiles-step: 1;
    // The timeline tells Rust its size (for the waveform and the ruler).
    in-out property <float> width-px: 800;
    // A handle, the band or the strip is being dragged: the view doesn't chase the playhead.
    in-out property <bool> dragging;
    // factor under 1 zooms in; anchor is a time kept in place (-1: the playhead, or the middle).
    callback zoom(float, float);
    callback pan-to(float);
    callback fit-clip();
    callback whole();
    callback resized();
}

// One clip of the clip list.
export struct ClipItem {
    name: string,
    start: float,
    end: float,
    // "0:12 – 0:20 · 8 s"
    range: string,
}

// Clip page → Clips (Clip track 3): several selections of one video, saved in one go.
export global ClipList {
    in-out property <bool> open;
    in property <[ClipItem]> items;
    // Saved as one file, one after the other.
    in-out property <bool> join;
    // "Fast · lossless: each clip starts on the keyframe before its In" and the like.
    in property <string> note;
    callback add(); // the current selection (A on the page)
    callback add-chapters();
    callback remove(int);
    callback rename(int, string);
    callback move(int, int); // from, to
    callback pick(int); // In / Out to that clip
    callback clear();
    callback join-changed();
}

// One followed channel or playlist in Settings → Following.
export struct FollowItem {
    url: string,
    name: string,
    detail: string, // "daily · checked 2 h ago · 1 new"
    every: int, // 0 hourly, 1 daily, 2 weekly
    paused: bool,
    checking: bool,
}

// Follow a channel or playlist: its new uploads download by themselves (Download track 12).
export global Following {
    // The preview is a channel or playlist: "Follow" under it.
    in property <bool> can-follow;
    in property <bool> followed;
    in property <string> note;
    callback follow();
    callback open-list(); // Settings → Following
    in property <[FollowItem]> items;
    callback check-now(string);
    callback pause(string, bool);
    callback unfollow(string);
    callback every(string, int);
}

// Queue actions that rows call directly.
// A live stream on the Download page's preview: it's recorded, from the start or from now
// (`live_ui.rs`, words from `record::start_choice`).
export global Live {
    // The previewed link is a live stream (on now, or not yet).
    in property <bool> on;
    in property <bool> upcoming;
    // "Records from the start" / "Starts in 42 min", what that means, and the link that
    // flips it ("Record from now instead"; empty: no choice). Short forms for 400 px.
    in property <string> line;
    in property <string> hint;
    in property <string> hint-short;
    in property <string> switch;
    in property <string> switch-short;
    callback flip();
}

export global QueueActions {
    callback start-now(int); // a "Download later" row (or a card: the group, negated)
    // A recording: stop and save it / save its last seconds as a file of their own /
    // watch it (the stream, live, in the player).
    callback stop(int);
    callback clip-last(int, float);
    callback watch(int);
    // A clip marked while it records: starts 10 s back, ends at "End clip" (the recording
    // goes on); "Cancel clip" forgets the start.
    callback clip-start(int);
    callback clip-end(int);
    callback clip-drop(int);
    // Move a waiting row (a card: the group, negated) by places; ±1000 = to the top / bottom.
    callback move(int, int);
    // The row just moved with the keyboard: its grip takes the focus back (0 = none).
    in property <int> focus-id;
}

// The kind of file to download (the chips on the preview): 0 Best quality, 1 Compatible,
// 2 Smallest file, 3 Audio only. `advanced` folds out resolution and container.
export global Presets {
    in-out property <int> preset;
    in-out property <bool> advanced;
    // The previewed video's best resolution ("2160p"; empty: not known), so the first
    // "Up to" chip can say what "Highest" gets.
    in-out property <string> top;
}

// One piece of a file name in the builder: a field chip, or text you typed.
export struct NamePiece {
    text: string,
    field: bool,
}

// The filename builder (Settings → Download → File names → Change).
export global Names {
    in-out property <bool> open;
    // Settings' row: the current name in words ("Title [Video ID]").
    in property <string> summary;
    in property <[NamePiece]> pieces;
    in property <[string]> fields;
    in property <[string]> presets; // ready-made and saved
    in property <int> preset; // -1 = none of them
    in property <string> example;
    in property <string> warning;
    // The raw yt-dlp template (Advanced), and whether it's too custom for pieces.
    in property <string> raw;
    in property <bool> custom;
    in-out property <bool> advanced;
    in-out property <string> typing;
    // A field chip held over the line (it lands at the end when dropped there).
    in-out property <bool> dragging;
    callback show();
    callback add-field(int);
    callback add-text(string);
    callback remove(int);
    callback move(int, int);
    callback use-preset(int);
    callback save-preset();
    callback set-raw(string);
}

// Music track: lyrics sources, "Lyrics only", numbering (Settings → Spotify, Download page).
export global Music {
    // Lyrics sources, asked in this order; synced lyrics end the search.
    in-out property <bool> lrclib: true;
    // Spotify's own synced lyrics (Musixmatch): opt-in, needs a Spotify sign-in.
    in-out property <bool> spotify;
    in-out property <bool> synced-only;
    // Spotify playlists: "01 Artist - Title".
    in-out property <bool> number-songs;
    in property <bool> spotify-signed-in;
    // A Spotify link's preview: save only the lyrics of its songs.
    callback lyrics-only();
    // Settings: pick a folder of songs and add lyrics to them.
    callback add-lyrics();
}

// Compress page (Compress track): goals in plain words, what it'll look like, before /
// after, several files, trimming. Rust owns the files and works out every text.
export struct CmpGoal {
    name: string, // "For Discord"
    hint: string, // "720p 30 fps, a bit softer" (the open file; "" with several)
    size: string, // "20 MB", "about 48 MB", "Working it out…"
    // The goal doesn't work for this file (too long, already fits): the hint says why.
    warn: bool,
}

export struct CmpFile {
    name: string,
    meta: string, // "2:14 · 312 MB"
    thumb: image,
    // 0 waiting, 1 compressing, 2 saved, 3 skipped (already fits), 4 can't, 5 failed, 6 cancelled
    state: int,
    tag: string, // "Saved · 19.4 MB", "Skipped", "Can't fit"
    detail: string, // the plan's hint, or why not
    progress: float,
}

// A part kept (Trim → Add this part).
export struct CmpPart {
    start: float,
    end: float,
    text: string, // "0:12 → 0:40  ·  0:28"
}

export global Compress {
    // ── The files ──
    // Nothing open / one file / several.
    in property <int> count;
    in property <[CmpFile]> files;
    // One file: its card.
    in property <string> name;
    in property <string> info; // "1920×1080 · 60 fps · 2:14 · 312 MB · h264"
    in property <image> thumb;
    in property <bool> reading; // still reading the file (or files)
    // The one file is sound only: no pictures to compare, no picture options.
    in property <bool> sound-file;

    // ── Goal ──
    // 0 Discord, 1 email, 2 WhatsApp, 3 smaller still sharp, 4 as small as possible, 5 custom
    in-out property <int> goal;
    in-out property <string> custom-mb: "50";
    in property <[CmpGoal]> goals;

    // ── What you get (one file) ──
    in property <string> verdict; // "720p 30 fps, a bit softer"
    in property <string> sizes; // "312 MB → 20 MB · 94% smaller"
    // A problem with the goal for this file, said plainly, and what would help.
    in property <string> problem;
    in property <string> fix-text; // "Keep the first 1:40" ("" = no quick fix)
    // Before / after at the same moment.
    in property <image> before;
    in property <image> after;
    in property <string> after-label; // "After · 720p"
    in property <bool> preview-busy;

    // ── Advanced ──
    in-out property <bool> advanced-open;
    in property <string> advanced-line; // "Plays everywhere · graphics card · 720p · sound 96 kbps"
    // 0 plays everywhere (H.264), 1 smaller (H.265), 2 smallest (AV1)
    in-out property <int> format;
    // A sound file on its own: 0 M4A (AAC), 1 MP3, 2 Opus
    in-out property <int> sound-format;
    in property <string> format-warning; // "May not play in Discord on some phones."
    in-out property <bool> use-gpu: true;
    in property <bool> gpu-available;
    in property <string> gpu-text: "Use my graphics card (faster)";
    // 0 auto, 1 keep it, 2 1080p, 3 720p, 4 480p
    in-out property <int> picture;
    // 0 128 kbps, 1 96, 2 64, 3 no sound
    in-out property <int> sound: 1;
    in-out property <bool> keep-tracks: true;
    in property <string> tracks-text; // "2 sound tracks, captions and chapters" ("" = nothing extra)
    in-out property <bool> cut-bars: true;
    in property <string> bars-text; // "Black bars found (1920×800)" ("" = none)
    // Volume: 0 as is, 1 even out; even out to 0 online video (-14 LUFS), 1 podcast (-16)
    in-out property <int> volume;
    in-out property <int> loudness;
    in property <string> summary; // the technical line

    // ── Trim (one file) ──
    in-out property <bool> trim-open;
    in property <float> duration;
    in-out property <float> trim-in;
    in-out property <float> trim-out;
    in property <[image]> strip;
    in property <image> strip-wave; // a sound file's waveform, in place of the frames
    // Chapter names (a chip each picks its part); `chapter` is the picked one (-1 none).
    in property <[string]> chapters;
    in-out property <int> chapter: -1;
    in property <string> trim-text; // "1:12 of 2:14"
    // Parts kept (Add this part): with any, they're what's saved, the strip picks the next.
    in property <[CmpPart]> parts;
    // Two or more parts: 0 joined into one file (the goal is for it), 1 one file each
    // (each fits the goal on its own).
    in-out property <int> split;
    in property <string> parts-text; // "3 parts · 2:10 in all"

    // ── Listening (the 10 s sample, in the page) ──
    in property <bool> player-on; // a sample is loaded
    in property <bool> playing;
    in property <bool> player-busy; // making the sample
    // 0 the file as it is (now), 1 the result (after): the same moment either way.
    in-out property <int> side: 1;
    in property <image> player-frame;
    in property <float> player-pos; // 0..1 of the sample
    in property <string> player-time; // "0:03 / 0:10"

    // ── Running ──
    in property <bool> running;
    in property <float> progress;
    in property <string> status;
    in property <bool> has-output;
    in property <bool> can-start;
    in property <string> start-text: "Compress";

    callback open-file(); // Open file(s)…
    callback open-folder();
    callback open-path(string);
    callback remove(int);
    callback clear();
    callback changed(); // any option
    callback fix(); // the problem's quick fix
    callback trim-changed(); // In / Out moved (Rust snaps and says the length)
    callback trim-whole();
    callback trim-chapter(int);
    callback add-part(); // the strip's In → Out
    callback remove-part(int);
    callback play-pause(); // the player: makes the sample first
    callback hear(); // `side` changed: the other one, at the same moment
    callback start();
    callback cancel();
    callback show(int); // a finished file in Explorer (-1: the one file)
}

// Speech to text (optional; `transcribe_ui.rs`): one dialog for the Clip page's
// Export ▾ → Transcribe, a dropped file and the Download page's Extras → Transcript.
// Until it's set up the dialog offers to get it (a one-time download).
export global Transcribe {
    in-out property <bool> open;
    // 0 get it first, 1 options, 2 working, 3 done, 4 failed
    in property <int> view;
    // What it's for: "lecture.m4a · 12:43", "3 files", "From the selection, 0:06".
    in property <string> subtitle;
    // Opened from Extras → Transcript: the options go with the download.
    in property <bool> for-download;
    // …and the transcript is already on for it.
    in property <bool> download-on;
    // Clip page on a link: downloads the part first.
    in property <bool> is-link;
    // Clip page with a selection that isn't the whole thing: choose (0 it, 1 the whole file).
    in property <bool> has-selection;
    in property <string> selection-text;
    in-out property <int> part;
    // Several files dropped: 0 one transcript, joined in this order; 1 one for each.
    in property <int> files;
    in property <string> files-text;
    in-out property <int> together;
    // "Detect", then languages by name.
    in property <[string]> languages;
    in-out property <int> language;
    // 0 text, 1 captions (.srt), 2 both
    in-out property <int> output;
    in-out property <bool> times: true;
    // Getting it: an NVIDIA card makes it much faster with its own pack.
    in property <bool> nvidia;
    in-out property <bool> use-gpu: true;
    // "575 MB" / "1.3 GB": what Get downloads.
    in property <string> get-size;
    in property <bool> getting;
    in property <float> progress;
    in property <string> status;
    // The last line it heard, while working.
    in property <string> heard;
    // Done: "Saved next to the video · English · 271 lines" and the file names.
    in property <string> result;
    in property <string> result-files;
    in property <string> error;
    callback get();
    callback start();
    callback stop();
    callback open-result();
    callback show-result();
    // An option changed: remembered for next time.
    callback changed();
    // Settings → Download → Speech to text: "Ready · uses your NVIDIA card · 1.6 GB on
    // this PC" / "Not set up". Remove takes it off the drive; Get it… opens the dialog.
    in property <bool> ready;
    in property <bool> on-gpu;
    in property <string> settings-text: "Not set up";
    callback remove();
    callback open-get();
    // Clip page → Export ▾ → Transcribe…: the open file or link (its selection or all).
    callback open-for-clip();
    // Extras → Transcript: open the dialog for the previewed download / on or off for it.
    callback open-for-download();
    callback set-download(bool);
}
