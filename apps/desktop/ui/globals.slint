// State and callbacks of the Download feature track, one global per feature. Pages import
// them directly instead of threading every property through app.slint; app.slint
// re-exports them, so Rust still sees one API (`ui.global::<Accounts>()`).

// One signed-in site in Settings → Network.
export struct SiteItem {
    site: string, // "youtube.com"
    name: string, // "YouTube"
    detail: string, // "signed in 3 days ago"
}

// Signed-in downloads (cookies kept per site in Neria's folder).
export global Accounts {
    in property <[SiteItem]> sites;
    // The link preview's problem can be solved by signing in to this site ("" otherwise).
    in property <string> problem-site;
    in property <string> problem-name;
    // Already signed in there (the account may not have access): "Sign in again".
    in property <bool> problem-again;
    // Settings: sign in to a site typed by hand.
    in-out property <string> other-site;
    // A sign-in window is open (buttons wait).
    in property <bool> busy;
    callback sign-in(string); // site
    callback sign-out(string);
    callback import-file();
}

// One row of the captions / audio / chapters picker. Header rows are group titles
// ("Made by the creator", "Auto-generated").
export struct TrackRow {
    key: string,
    label: string,
    detail: string, // "video's language", "Original", "2:41"
    checked: bool,
    header: bool,
}

// Captions, audio tracks and chapters of the previewed video: the buttons under the quality
// chips say what's picked, each opens the picker dialog.
export global Extras {
    // What each button says; "" = nothing to pick, no button.
    in property <string> captions-text;
    in property <string> audio-text;
    in property <string> chapters-text;
    // The video has no captions at all (said quietly when other buttons show).
    in property <bool> no-captions;
    // The picker: 0 closed, 1 captions, 2 audio tracks, 3 chapters.
    in-out property <int> open;
    in property <[TrackRow]> rows;
    in property <int> total;
    in property <int> picked;
    in-out property <string> query;
    // Captions: format 0 SRT, 1 VTT, 2 ASS, 3 text; mode 0 separate, 1 in the video, 2 both.
    in-out property <int> sub-format;
    in-out property <int> sub-mode;
    in-out property <bool> subs-only;
    // Chapters: 0 one file, 1 separate files.
    in-out property <int> chapter-mode;
    // Under the options ("Joins chapters 2–3 and 5, skips chapter 4").
    in property <string> note;
    callback show(int);
    callback toggle(string, bool);
    callback all(bool);
    callback search(string);
    callback options-changed();
}

// Running in the background: the close question, "Download later", notifications.
export global Background {
    // Closing while downloads are going: "Keep going in the tray" / "Stop and quit".
    in-out property <bool> ask-open;
    in property <int> going; // downloads running or waiting (scheduled ones included)
    in-out property <bool> remember;
    callback keep-going();
    callback quit();
    // "Download later": 0 in an hour, 1 tonight at 02:00, 2 tomorrow at 08:00, 3 at a time.
    in-out property <bool> later-open;
    in-out property <int> later-choice: 1;
    in-out property <string> later-time: "22:00";
    in property <string> later-note; // "Starts tomorrow at 02:00"
    callback later-changed();
    callback later-confirm();
    // Settings (General): 0 ask, 1 keep going in the tray, 2 quit.
    in-out property <int> close-action;
    in-out property <bool> notify: true;
    in-out property <bool> notify-unfocused: true;
    // 0 Neria chime, 1 Windows' sound, 2 none.
    in-out property <int> sound-done;
    in-out property <int> sound-failed;
    callback settings-changed();
    callback test-sound(bool); // failed?
}

// Several links at once, "Paste & download" and the clipboard watcher.
export global Bulk {
    // The picker lists pasted links (not a playlist's items): no numbering, "5 links".
    in property <bool> links;
    // Paste & download (Download ▾, Ctrl+Shift+V): every link on the clipboard, your defaults.
    callback paste-download();
    // The watcher (Settings → Download, off by default) and its strip on the Download page.
    in-out property <bool> watch;
    in property <string> copied; // the link just copied ("" = no strip)
    callback watch-changed();
    callback copied-download();
    callback copied-preview();
    callback copied-dismiss();
}

// Watch a link before downloading: the Clip page's player without In/Out (Download track
// 11). Volume and mute are the player's own and never touch what gets saved.
export global Watch {
    in-out property <bool> on;
    in-out property <float> volume: 100;
    in-out property <bool> muted;
    callback start(); // the play mark on the Download page's preview
    callback back(); // to the Download page (a file open before comes back)
    callback download(); // the whole link, with the chips as they are
    callback clip-this(); // stay, with In/Out
    callback volume-changed();
}

// One followed channel or playlist in Settings → Following.
export struct FollowItem {
    url: string,
    name: string,
    detail: string, // "daily · checked 2 h ago · 1 new"
    every: int, // 0 hourly, 1 daily, 2 weekly
    paused: bool,
    checking: bool,
}

// Follow a channel or playlist: its new uploads download by themselves (Download track 12).
export global Following {
    // The preview is a channel or playlist: "Follow" under it.
    in property <bool> can-follow;
    in property <bool> followed;
    in property <string> note;
    callback follow();
    callback open-list(); // Settings → Following
    in property <[FollowItem]> items;
    callback check-now(string);
    callback pause(string, bool);
    callback unfollow(string);
    callback every(string, int);
}

// Queue actions that rows call directly.
export global QueueActions {
    callback start-now(int); // a "Download later" row (or a card: the group, negated)
    // Move a waiting row (a card: the group, negated) by places; ±1000 = to the top / bottom.
    callback move(int, int);
    // The row just moved with the keyboard: its grip takes the focus back (0 = none).
    in property <int> focus-id;
}

// The kind of file to download (the chips on the preview): 0 Best quality, 1 Compatible,
// 2 Smallest file, 3 Audio only. `advanced` folds out resolution and container.
export global Presets {
    in-out property <int> preset;
    in-out property <bool> advanced;
}

// One piece of a file name in the builder: a field chip, or text you typed.
export struct NamePiece {
    text: string,
    field: bool,
}

// The filename builder (Settings → Download → File names → Change).
export global Names {
    in-out property <bool> open;
    // Settings' row: the current name in words ("Title [Video ID]").
    in property <string> summary;
    in property <[NamePiece]> pieces;
    in property <[string]> fields;
    in property <[string]> presets; // ready-made and saved
    in property <int> preset; // -1 = none of them
    in property <string> example;
    in property <string> warning;
    // The raw yt-dlp template (Advanced), and whether it's too custom for pieces.
    in property <string> raw;
    in property <bool> custom;
    in-out property <bool> advanced;
    in-out property <string> typing;
    // A field chip held over the line (it lands at the end when dropped there).
    in-out property <bool> dragging;
    callback show();
    callback add-field(int);
    callback add-text(string);
    callback remove(int);
    callback move(int, int);
    callback use-preset(int);
    callback save-preset();
    callback set-raw(string);
}
