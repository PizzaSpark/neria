// State and callbacks of the Download feature track, one global per feature. Pages import
// them directly instead of threading every property through app.slint; app.slint
// re-exports them, so Rust still sees one API (`ui.global::<Accounts>()`).

// One signed-in site in Settings → Network.
export struct SiteItem {
    site: string, // "youtube.com"
    name: string, // "YouTube"
    detail: string, // "signed in 3 days ago"
}

// Signed-in downloads (cookies kept per site in Neria's folder).
export global Accounts {
    in property <[SiteItem]> sites;
    // The link preview's problem can be solved by signing in to this site ("" otherwise).
    in property <string> problem-site;
    in property <string> problem-name;
    // Already signed in there (the account may not have access): "Sign in again".
    in property <bool> problem-again;
    // Settings: sign in to a site typed by hand.
    in-out property <string> other-site;
    // A sign-in window is open (buttons wait).
    in property <bool> busy;
    callback sign-in(string); // site
    callback sign-out(string);
    callback import-file();
}

// One row of the captions / audio / chapters picker. Header rows are group titles
// ("Made by the creator", "Auto-generated").
export struct TrackRow {
    key: string,
    label: string,
    detail: string, // "video's language", "Original", "2:41"
    checked: bool,
    header: bool,
}

// Captions, audio tracks and chapters of the previewed video: the buttons under the quality
// chips say what's picked, each opens the picker dialog.
export global Extras {
    // What each button says; "" = nothing to pick, no button.
    in property <string> captions-text;
    in property <string> audio-text;
    in property <string> chapters-text;
    // The video has no captions at all (said quietly when other buttons show).
    in property <bool> no-captions;
    // The picker: 0 closed, 1 captions, 2 audio tracks, 3 chapters.
    in-out property <int> open;
    in property <[TrackRow]> rows;
    in property <int> total;
    in property <int> picked;
    in-out property <string> query;
    // Captions: format 0 SRT, 1 VTT, 2 ASS, 3 text; mode 0 separate, 1 in the video, 2 both.
    in-out property <int> sub-format;
    in-out property <int> sub-mode;
    in-out property <bool> subs-only;
    // Chapters: 0 one file, 1 separate files.
    in-out property <int> chapter-mode;
    // Under the options ("Joins chapters 2–3 and 5, skips chapter 4").
    in property <string> note;
    callback show(int);
    callback toggle(string, bool);
    callback all(bool);
    callback search(string);
    callback options-changed();
}

// Running in the background: the close question, "Download later", notifications.
export global Background {
    // Closing while downloads are going: "Keep going in the tray" / "Stop and quit".
    in-out property <bool> ask-open;
    in property <int> going; // downloads running or waiting (scheduled ones included)
    in-out property <bool> remember;
    callback keep-going();
    callback quit();
    // "Download later": 0 in an hour, 1 tonight at 02:00, 2 tomorrow at 08:00, 3 at a time.
    in-out property <bool> later-open;
    in-out property <int> later-choice: 1;
    in-out property <string> later-time: "22:00";
    in property <string> later-note; // "Starts tomorrow at 02:00"
    callback later-changed();
    callback later-confirm();
    // Settings (General): 0 ask, 1 keep going in the tray, 2 quit.
    in-out property <int> close-action;
    in-out property <bool> notify: true;
    in-out property <bool> notify-unfocused: true;
    // 0 Neria chime, 1 Windows' sound, 2 none.
    in-out property <int> sound-done;
    in-out property <int> sound-failed;
    callback settings-changed();
    callback test-sound(bool); // failed?
}

// Queue actions that rows call directly.
export global QueueActions {
    callback start-now(int); // a "Download later" row (or a card: the group, negated)
}
