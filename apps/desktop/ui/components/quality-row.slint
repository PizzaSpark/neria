import { Theme, Screen } from "../theme.slint";
import { Formats } from "../types.slint";
import { Presets } from "../globals.slint";
import { ChoiceChips, Chip, GhostButton, TextLink } from "../widgets.slint";

// What kind of file, in plain words: Best quality · Compatible · Smallest file · Audio
// only. "Advanced" folds out the resolution cap and the container (or audio format) right
// here; the format button ("mp4 · H.264") opens Settings. Sits under the preview title on
// wide windows, in its own row on narrower ones; chips wrap when even that is too narrow.
export component QualityRow inherits VerticalLayout {
    // Highest resolution (Advanced): 0 any, 1 1080p, 2 720p, 3 480p.
    in-out property <int> quality;
    in-out property <int> container-index;
    in-out property <int> audio-format-index;
    // No quality to pick (Spotify songs, X GIFs): show `spotify-text` instead of the chips.
    in property <bool> spotify;
    in property <string> spotify-text;
    in property <string> format-text;
    in property <bool> show-clip;
    callback changed();
    callback open-settings();
    callback clip-first();
    property <bool> audio: Presets.preset == 3;
    spacing: 8px;
    alignment: start;
    HorizontalLayout {
        spacing: 7px;
        if !root.spotify: ChoiceChips {
            options: Screen.compact ? ["Best", "Compatible", "Smallest", "Audio"]
                : ["Best quality", "Compatible", "Smallest file", "Audio only"];
            current <=> Presets.preset;
            changed => { root.changed(); }
        }
        if root.spotify: Text {
            text: root.spotify-text;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.show-clip && !root.spotify: VerticalLayout {
            alignment: start;
            padding-top: 2px;
            horizontal-stretch: 0;
            padding-left: 4px;
            GhostButton {
                compact: true;
                text: "Clip first";
                icon: "\u{E8C6}";
                clicked => { root.clip-first(); }
            }
        }
        if root.spotify: Rectangle { horizontal-stretch: 1; }
        if !root.spotify: VerticalLayout {
            alignment: start;
            padding-top: 7px;
            horizontal-stretch: 0;
            TextLink {
                text: "Advanced";
                icon: Presets.advanced ? "\u{E70E}" : "\u{E70D}";
                clicked => { Presets.advanced = !Presets.advanced; }
            }
        }
        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            horizontal-stretch: 0;
            GhostButton {
                compact: true;
                icon: "\u{E713}";
                text: root.format-text;
                label: "Format settings: " + root.format-text;
                clicked => { root.open-settings(); }
            }
        }
    }
    // The old chips, for people who want the numbers: one labelled row each.
    if Presets.advanced && !root.spotify && !root.audio && Presets.preset != 2: HorizontalLayout {
        spacing: 7px;
        alignment: start;
        vertical-stretch: 0;
        Text {
            width: 44px;
            height: 30px;
            text: "Up to";
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        for option[i] in ["Any", "1080p", "720p", "480p"]: Chip {
            horizontal-stretch: 0;
            text: option;
            selected: root.quality == i;
            clicked => {
                root.quality = i;
                root.changed();
            }
        }
    }
    if Presets.advanced && !root.spotify && !root.audio && Presets.preset == 0: HorizontalLayout {
        spacing: 7px;
        alignment: start;
        vertical-stretch: 0;
        Text {
            width: 44px;
            height: 30px;
            text: "As";
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        for option[i] in Formats.containers: Chip {
            horizontal-stretch: 0;
            text: option;
            selected: root.container-index == i;
            clicked => {
                root.container-index = i;
                root.changed();
            }
        }
    }
    if Presets.advanced && !root.spotify && root.audio: HorizontalLayout {
        spacing: 7px;
        alignment: start;
        vertical-stretch: 0;
        Text {
            width: 44px;
            height: 30px;
            text: "As";
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        for option[i] in Formats.audio: Chip {
            horizontal-stretch: 0;
            text: option;
            selected: root.audio-format-index == i;
            clicked => {
                root.audio-format-index = i;
                root.changed();
            }
        }
    }
    if Presets.advanced && !root.spotify && !root.audio && Presets.preset != 0: Text {
        text: Presets.preset == 1 ? "Compatible is always MP4 with H.264 video and AAC sound (YouTube: up to 1080p)."
            : "Smallest file is MP4, up to 480p, the smallest streams the site has.";
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
    }
}
