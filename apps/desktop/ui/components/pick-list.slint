import { ComboBox, ListView } from "std-widgets.slint";
import { Theme, Screen } from "../theme.slint";
import { PickItem } from "../types.slint";
import { SectionTitle, TextLink, Tick, Notice, Divider, ListRow, Thumb, DragHandle } from "../widgets.slint";

// Posts and playlists: pick what to download, under the link preview. Calm rows; the
// ticks and handles are the playful part. Drag a row by its handle (or ↑ / ↓ on it) to put
// the items in your own order; the numbers follow.
export component PickList inherits VerticalLayout {
    in property <[PickItem]> items;
    in property <int> checked;
    // Said about the items, e.g. a video Neria can't reach in this post.
    in property <string> note;
    in-out property <bool> number-items;
    // Rows shown before the list scrolls.
    in property <int> visible-rows: 4;
    callback toggle(int, bool);
    callback all(bool);
    callback quality(int, int);
    callback number-items-toggled();
    callback move(int, int);
    callback reverse();
    // Each row's own quality and format (Rust maps the index, see `pick_choice`).
    property <[string]> qualities: ["As above", "Best", "1080p", "720p", "480p", "Best · mkv", "Best · webm",
        "Audio · mp3", "Audio · m4a", "Audio · opus", "Audio · flac", "Audio · wav"];
    // Dragging: the row held and where it would land (-1 = not dragging).
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    property <length> row-h: 48px;
    vertical-stretch: 0;
    spacing: 6px;
    HorizontalLayout {
        spacing: 12px;
        SectionTitle {
            text: root.checked == root.items.length
                ? "All " + root.items.length + " items"
                : root.checked + " of " + root.items.length + " picked";
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle { horizontal-stretch: 1; }
        // Only matters when several go into one folder. Compact: on its own line below.
        if root.checked > 1 && !Screen.compact: Tick {
            text: "Number the files in order";
            checked <=> root.number-items;
            toggled => { root.number-items-toggled(); }
        }
        // Newest-first playlists: oldest first (or back).
        if root.items.length > 1: TextLink {
            text: "Reverse";
            icon: "\u{E8CB}";
            clicked => { root.reverse(); }
        }
        if root.checked < root.items.length: TextLink {
            text: Screen.compact ? "All" : "Select all";
            clicked => { root.all(true); }
        }
        if root.checked > 0: TextLink {
            text: "None";
            clicked => { root.all(false); }
        }
    }
    if root.checked > 1 && Screen.compact: HorizontalLayout {
        alignment: start;
        Tick {
            text: "Number the files in order";
            checked <=> root.number-items;
            toggled => { root.number-items-toggled(); }
        }
    }
    if root.note != "": Notice {
        text: root.note;
        wrap: true;
    }
    Divider { inset-right: Theme.lane; }
    ListView {
        height: min(root.items.length, root.visible-rows) * root.row-h;
        for item[i] in root.items: ListRow {
            height: root.row-h;
            background: i == root.drag-from ? Theme.raised : transparent;
            // keyboard: the row's tick does the same.
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle(i, !item.checked); }
            }
            // Where a dragged row would land.
            if root.drag-from >= 0 && i == root.drag-to && root.drag-to != root.drag-from: Rectangle {
                x: 0;
                y: root.drag-to < root.drag-from ? 0px : parent.height - 2px;
                width: parent.width - Theme.lane;
                height: 2px;
                background: Theme.ink;
            }
            HorizontalLayout {
                padding-left: 0px;
                padding-right: Theme.lane;
                spacing: Screen.compact ? 8px : 10px;
                if root.items.length > 1: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    DragHandle {
                        label: "Move " + (item.title != "" ? item.title : item.kind + " " + (i + 1));
                        step(d) => {
                            if i + d >= 0 && i + d < root.items.length {
                                root.move(i, i + d);
                            }
                        }
                        dragging(dy) => {
                            root.drag-from = i;
                            root.drag-to = max(0, min(root.items.length - 1, i + round(dy / root.row-h)));
                        }
                        dropped => {
                            if root.drag-from >= 0 && root.drag-to != root.drag-from {
                                root.move(root.drag-from, root.drag-to);
                            }
                            root.drag-from = -1;
                            root.drag-to = -1;
                        }
                    }
                }
                Tick {
                    horizontal-stretch: 0;
                    checked: item.checked;
                    toggled(on) => { root.toggle(i, on); }
                }
                // The number the file gets (your order).
                if root.number-items && !Screen.compact: Text {
                    horizontal-stretch: 0;
                    text: item.number;
                    color: item.checked ? Theme.muted : Theme.dim;
                    font-family: Theme.mono;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Thumb {
                        width: Screen.compact ? 48px : 64px;
                        height: Screen.compact ? 27px : 36px;
                        source: item.thumb;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: item.title != "" ? item.title : item.kind + " " + (i + 1);
                    color: item.checked ? Theme.ink : Theme.muted;
                    font-size: 14px;
                    font-weight: 500;
                    overflow: elide;
                    vertical-alignment: center;
                }
                // Compact: the length makes way for the quality menu.
                if !Screen.compact || !item.can-quality: Text {
                    horizontal-stretch: 0;
                    text: item.detail;
                    color: Theme.muted;
                    font-family: Theme.mono;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }
                // This video only: another quality or format, or just its audio.
                if item.can-quality: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ComboBox {
                        width: Screen.compact ? 112px : 136px;
                        enabled: item.checked;
                        model: root.qualities;
                        current-index: item.quality;
                        selected => { root.quality(i, self.current-index); }
                    }
                }
            }
        }
    }
}
