import { Theme } from "../theme.slint";
import { JobItem } from "../types.slint";
import { Icon, GhostButton, IconButton, Bar, Tag, Menu, MenuItem } from "../widgets.slint";
import { QueueActions } from "../globals.slint";

// One queue row: calm (hairline, no card), with labelled actions on the right.
export component JobRow inherits Rectangle {
    in property <JobItem> job;
    // Medium window: Clip / Compress shrink to icons so the title keeps its room.
    in property <bool> narrow;
    // Compact window: one main action, the rest in a ⋯ menu.
    in property <bool> compact;
    callback cancel();
    callback remove();
    callback retry();
    callback open();
    callback open-clipper();
    callback open-compressor();
    callback pick-match();
    callback report();
    // Flagged songs: listen to it, or keep it ("It's right").
    callback play();
    callback accept();
    callback pause();
    callback resume();
    // Open/close a group card.
    callback toggle();

    property <bool> active: root.job.state <= 2;
    property <bool> done: root.job.state == 3;
    property <bool> failed: root.job.state == 4;
    property <bool> paused: root.job.state == 6;
    property <string> glyph: root.job.header ? "\u{E8F1}" : root.job.state == 0 ? "\u{E823}" : root.job.state == 1 ? "\u{E896}" : root.job.state == 2 ? "\u{E9F5}" : root.job.state == 3 ? (root.job.music ? "\u{E8D6}" : "\u{E8B2}") : root.job.state == 4 ? "\u{E783}" : root.paused ? "\u{E769}" : "\u{E711}";
    // A saved song that may be the wrong version: "Unsure", or "Sounds different" when the
    // audio check says it's another recording.
    property <bool> flagged: root.done && root.job.warn && root.job.music && !root.job.header;
    property <string> tag: root.job.state == 0 && root.job.scheduled ? "Later"
        : root.job.state == 0 ? "Waiting"
        : root.flagged ? (root.job.flag == 2 ? "Sounds different" : "Unsure")
        : root.done ? (root.job.warn ? "Check" : "Saved") : root.failed ? "Failed" : root.job.state == 5 ? "Cancelled" : root.paused ? "Paused" : "";
    property <int> tag-kind: root.flagged && root.job.flag == 2 ? 3 : root.done ? (root.job.warn ? 2 : 1) : root.failed ? 3 : 0;

    // What the row offers (the same on every width; compact folds most into the menu).
    property <bool> can-show: root.done || (root.job.header && root.job.state != 0);
    property <bool> can-clip: root.done && !root.job.header && !root.job.still;
    // Songs are already small; compressing is for videos.
    property <bool> can-compress: root.can-clip && !root.job.music;
    property <bool> can-match: root.job.music && !root.job.header && (root.done || root.failed);
    property <bool> can-report: root.failed && !root.job.header;
    // Compact: the one button that stays on the row. 1 pause, 2 resume, 3 retry,
    // 4 pick match, 5 show, 6 cancel (waiting), 0 none.
    property <int> main: root.job.can-pause ? 1 : root.job.can-resume ? 2 : root.job.can-retry ? 3
        : root.can-match && root.job.warn ? 4 : root.can-show ? 5 : root.job.can-cancel ? 6 : 0;
    property <bool> has-menu: root.job.scheduled || (root.job.can-cancel && root.main != 6) || (root.can-show && root.main != 5)
        || root.can-clip || (root.can-match && root.main != 4) || (root.job.can-retry && root.main != 3)
        || root.can-report || root.job.can-remove;

    // A paused download keeps its bar, greyed, so you see how far it got.
    property <bool> moving: root.job.state == 1 || root.job.state == 2 || (root.paused && root.job.progress > 0);
    height: root.moving ? 72px : 62px;

    // A group card opens and closes anywhere outside its buttons.
    // keyboard: the chevron button does the same.
    if root.job.header: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }

    // Divider stops where the scrollbar lane starts; rows inside a card start theirs
    // under the indent, so the card reads as one block.
    Rectangle {
        x: root.job.child ? 28px : 0;
        y: parent.height - 1px;
        width: parent.width - Theme.lane - self.x;
        height: 1px;
        background: Theme.line;
    }
    // The card's rows hang off a thin guide line.
    if root.job.child: Rectangle {
        x: 11px;
        y: 0;
        width: 2px;
        height: parent.height;
        background: Theme.line;
    }

    HorizontalLayout {
        spacing: 14px;
        padding-left: root.job.child ? 28px : 0;
        // Room for the list's scrollbar, which is drawn over the right edge.
        padding-right: Theme.lane;

        // Thumbnail (16:9 for videos, square for song covers), or a status icon
        // until it arrives. Always a 64px slot so every title lines up.
        Rectangle {
            width: 64px;
            // A card shows a little stack: there's more than one thing inside.
            if root.job.header: Rectangle {
                width: root.job.music ? 40px : 64px;
                height: root.job.music ? 40px : 36px;
                x: (parent.width - self.width) / 2 + 4px;
                y: (parent.height - self.height) / 2 - 4px;
                border-radius: 6px;
                background: Theme.line;
            }
            Rectangle {
                width: root.job.music ? 40px : 64px;
                height: root.job.music ? 40px : 36px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: root.job.thumb.width > 0 ? Theme.raised : root.active ? Theme.pop.with-alpha(0.16) : Theme.raised;
                clip: true;
                if root.job.thumb.width > 0: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.job.thumb;
                    image-fit: cover;
                    opacity: root.failed || root.job.state == 5 ? 0.45 : 1.0;
                }
                if root.job.thumb.width == 0: Icon {
                    text: root.glyph;
                    font-size: 14px;
                    color: root.active && !root.job.header ? Theme.pop-text : root.failed ? Theme.bad : root.done && root.job.warn ? Theme.warn : Theme.muted;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.job.title;
                color: Theme.ink;
                font-size: 14px;
                font-weight: root.job.header ? 650 : 500;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 8px;
                if root.tag != "": VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Tag {
                        text: root.tag;
                        kind: root.tag-kind;
                    }
                }
                // Compact: a moving row shows only its numbers (size, speed, time left).
                if !root.compact || !root.moving || root.job.stats == "": Text {
                    text: root.job.status;
                    color: root.failed || (root.done && root.job.warn) ? Theme.ink : Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.job.stats;
                    color: Theme.muted;
                    // Spotify rows say "✓ sounds like Spotify · 11.6 MB": words, so not monospace.
                    font-family: root.job.music && root.done ? Theme.body : Theme.mono;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: root.compact && root.moving ? 1 : 0;
                    overflow: elide;
                }
            }
            if root.moving: Bar {
                value: root.job.progress;
                fill: root.paused ? Theme.muted : Theme.pop;
            }
        }

        if root.compact: VerticalLayout {
          alignment: center;
          horizontal-stretch: 0;
          HorizontalLayout {
            spacing: 6px;
            if root.main != 0: GhostButton {
                compact: true;
                text: root.main == 1 ? "Pause" : root.main == 2 ? "Resume" : root.main == 3 ? "Retry"
                    : root.main == 4 ? "Pick match" : root.main == 5 ? "Show" : "Cancel";
                clicked => {
                    if root.main == 1 { root.pause(); }
                    else if root.main == 2 { root.resume(); }
                    else if root.main == 3 { root.retry(); }
                    else if root.main == 4 { root.pick-match(); }
                    else if root.main == 5 { root.open(); }
                    else { root.cancel(); }
                }
            }
            if root.has-menu: GhostButton {
                compact: true;
                width: 30px;
                icon: "\u{E712}";
                label: "More actions";
                clicked => { menu.show(); }
            }
            if root.job.header: IconButton {
                icon: root.job.expanded ? "\u{E70E}" : "\u{E70D}";
                label: root.job.expanded ? "Close group" : "Open group";
                clicked => { root.toggle(); }
            }
          }
        }

        if !root.compact: VerticalLayout {
          alignment: center;
          horizontal-stretch: 0;
          HorizontalLayout {
            spacing: 6px;
            if root.job.can-pause && !root.narrow: GhostButton {
                compact: true;
                text: root.job.header ? "Pause all" : "Pause";
                clicked => { root.pause(); }
            }
            if root.job.can-pause && root.narrow: GhostButton {
                compact: true;
                icon: "\u{E769}";
                label: "Pause";
                clicked => { root.pause(); }
            }
            if root.job.can-resume: GhostButton {
                compact: true;
                text: root.job.header && !root.narrow ? "Resume all" : "Resume";
                clicked => { root.resume(); }
            }
            if root.job.scheduled: GhostButton {
                compact: true;
                text: "Start now";
                clicked => { QueueActions.start-now(root.job.id); }
            }
            if root.job.can-cancel: GhostButton {
                compact: true;
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            if root.flagged: GhostButton {
                compact: true;
                text: root.narrow ? "" : "Play";
                icon: "\u{E768}";
                label: "Play";
                clicked => { root.play(); }
            }
            if root.flagged: GhostButton {
                compact: true;
                text: "It's right";
                clicked => { root.accept(); }
            }
            // A card's "Show" opens its folder.
            if !root.flagged && (root.done || (root.job.header && root.job.state != 0)): GhostButton {
                compact: true;
                text: "Show";
                clicked => { root.open(); }
            }
            if root.done && !root.flagged && !root.job.header && !root.job.still && !root.narrow: GhostButton {
                compact: true;
                text: "Clip";
                clicked => { root.open-clipper(); }
            }
            if root.done && !root.flagged && !root.job.header && !root.job.still && root.narrow: GhostButton {
                compact: true;
                icon: "\u{E8C6}";
                label: "Clip";
                clicked => { root.open-clipper(); }
            }
            // Songs are already small; compressing is for videos.
            if root.done && !root.job.header && !root.job.music && !root.job.still && !root.narrow: GhostButton {
                compact: true;
                text: "Compress";
                clicked => { root.open-compressor(); }
            }
            if root.done && !root.job.header && !root.job.music && !root.job.still && root.narrow: GhostButton {
                compact: true;
                icon: "\u{E73F}";
                label: "Compress";
                clicked => { root.open-compressor(); }
            }
            if root.job.music && !root.job.header && (root.done || root.failed): GhostButton {
                compact: true;
                text: root.failed || root.job.warn ? "Pick match" : "Other match";
                clicked => { root.pick-match(); }
            }
            if root.job.can-retry: GhostButton {
                compact: true;
                text: root.job.header && !root.narrow ? "Retry failed" : "Retry";
                clicked => { root.retry(); }
            }
            if root.failed && !root.job.header: GhostButton {
                compact: true;
                text: "Report";
                clicked => { root.report(); }
            }
            if root.job.can-remove: IconButton {
                icon: "\u{E711}";
                label: "Remove from list";
                clicked => { root.remove(); }
            }
            if root.job.header: IconButton {
                icon: root.job.expanded ? "\u{E70E}" : "\u{E70D}";
                label: root.job.expanded ? "Close group" : "Open group";
                clicked => { root.toggle(); }
            }
          }
        }
    }

    // Compact: everything but the main action. Opens under the ⋯ button, right-aligned
    // with it (the row's actions end at the scrollbar lane).
    menu := PopupWindow {
        x: root.width - Theme.lane - (root.job.header ? 38px : 0px) - 200px;
        y: root.height / 2 + 19px;
        Menu {
            if root.flagged: MenuItem {
                icon: "\u{E768}";
                text: "Play";
                clicked => { root.play(); }
            }
            if root.flagged: MenuItem {
                icon: "\u{E73E}";
                text: "It's right, keep it";
                clicked => { root.accept(); }
            }
            if root.job.scheduled: MenuItem {
                icon: "\u{E768}";
                text: "Start now";
                clicked => { QueueActions.start-now(root.job.id); }
            }
            if root.job.can-cancel && root.main != 6: MenuItem {
                icon: "\u{E711}";
                text: root.job.header ? "Cancel all" : "Cancel";
                clicked => { root.cancel(); }
            }
            if root.can-show && root.main != 5: MenuItem {
                icon: "\u{E838}";
                text: root.job.header ? "Show folder" : "Show in folder";
                clicked => { root.open(); }
            }
            if root.can-clip: MenuItem {
                icon: "\u{E8C6}";
                text: "Clip";
                clicked => { root.open-clipper(); }
            }
            if root.can-compress: MenuItem {
                icon: "\u{E73F}";
                text: "Compress";
                clicked => { root.open-compressor(); }
            }
            if root.can-match && root.main != 4: MenuItem {
                icon: "\u{E8D6}";
                text: root.failed || root.job.warn ? "Pick match" : "Other match";
                clicked => { root.pick-match(); }
            }
            if root.job.can-retry && root.main != 3: MenuItem {
                icon: "\u{E72C}";
                text: root.job.header ? "Retry failed" : "Retry";
                clicked => { root.retry(); }
            }
            if root.can-report: MenuItem {
                icon: "\u{EBE8}";
                text: "Copy report";
                clicked => { root.report(); }
            }
            if root.job.can-remove: MenuItem {
                icon: "\u{E74D}";
                text: "Remove from list";
                clicked => { root.remove(); }
            }
        }
    }
}
